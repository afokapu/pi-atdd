{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "extensions/**/*.ts",
    "tests/**/*.ts",
    "tools/atd-40-verify-ledger.ts",
    "tools/atd-40-source-evidence.ts"
  ]
}
