{
  "schema": "pi-atdd/structure-profile/v1",
  "stack": "default",
  "vocabularyVersion": 3,
  "values": {
    "roles.layers": ["presentation", "application", "domain", "integration", "assembly"],
    "roles.assignment": "the path's layer segment; a file with no layer segment is out of scope, not a violation",
    "roles.domain.path": ["**/domain/**"],
    "roles.application.path": ["**/application/**"],
    "roles.integration.path": ["**/integration/**"],
    "roles.presentation.path": ["**/presentation/**"],
    "roles.composition_root.name": "assembly",
    "roles.composition_root.path": ["**/assembly/**"],
    "roles.boundary.path": ["**/routes/**", "**/api/**"],
    "roles.unit_test.path": ["tests/**"],
    "roles.e2e_test.path": ["e2e/**"],
    "roles.plan_artifact.path": ["plan/**"],
    "roots.config": "atdd-pi.yaml",
    "roots.source": "src/capabilities",
    "roots.test": "tests/capabilities",
    "roots.e2e": "e2e",
    "roots.plan": "plan",
    "roots.excluded": ["node_modules", ".git", "dist", "build", "_generated"],
    "suffix.source": [".ts", ".tsx"],
    "suffix.test": ["*.test.*", "*.spec.*"],
    "tooling.languages": ["typescript", "javascript"],
    "tooling.package_manager": "Bun",
    "tooling.manifest": "package.json",
    "tooling.lockfile.native": ["bun.lock", "bun.lockb"],
    "tooling.lockfile.foreign": ["package-lock.json", "yarn.lock", "pnpm-lock.yaml", "pnpm-lock.yml"],
    "tooling.test_runner": "bun:test",
    "enforcement.runner": "atdd-pi",
    "enforcement.suppression_marker": "# atdd:suppress(<rule_id>) UNTIL=YYYY-MM-DD",
    "enforcement.report_location": "<path>:<line>"
  }
}
