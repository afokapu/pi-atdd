{
  "schema": "pi-atdd/convention-sidecar/v1",
  "source": {
    "path": "vendor/atdd-bun/planner-nodes/nodes/planner.feature.verb-selection-by-artifact-type.convention.yaml",
    "sha256": "f4b18e2f1c8e289432429d4a38dc109775c20b3a0377bbc2fdd6d050c9733f1e"
  },
  "rule_id": "planner.feature.verb-selection-by-artifact-type",
  "kind": "rule",
  "title": "Pick a feature name's verb to fit its artifact type",
  "activation": {
    "facts": [
      {
        "fact": "task_term",
        "values": [
          "feature name",
          "feature slug",
          "verb-object",
          "seed feature from artifact"
        ],
        "observability": "observable_now",
        "note": "Planner task text mentions naming a feature seeded from an artifact. Wagons are out of scope for this rule."
      },
      {
        "fact": "file_kind",
        "values": [
          "planner feature artifact"
        ],
        "observability": "observable_now",
        "note": "Artifact kind is known from the planner feature file being authored."
      },
      {
        "fact": "change",
        "values": [
          "feature name slug added or renamed"
        ],
        "observability": "needs_new_observer",
        "note": "Needs a diff observer that reports a new or changed feature slug and its leading token."
      },
      {
        "fact": "finding",
        "values": [
          "seeding artifact type (event|state|data|config)"
        ],
        "observability": "llm_judged",
        "note": "The type of the seeding artifact (e.g. an event such as x:started vs a config such as x:config) is judged from the artifact URN/semantics."
      }
    ],
    "fires": [
      "Planner names a new feature seeded from an event artifact such as x:started and picks the leading verb.",
      "Planner seeds a feature name from a config, state or data artifact.",
      "Planner renames a feature slug seeded from a typed artifact so that its leading verb changes."
    ],
    "doesNotFire": [
      "Naming or renaming a wagon (only the separate leading-verb lexicon gate applies).",
      "Naming a feature that is not seeded from a typed artifact (only the separate leading-verb lexicon gate applies).",
      "Editing a feature's acceptances or description without touching its name slug.",
      "Coder implementing code inside an already-named feature."
    ]
  },
  "given": "A feature name is being authored or renamed and is seeded from an artifact whose type is event, state, data or config.",
  "when": "The planner picks the leading verb of the feature's verb-object slug.",
  "then": "Choose a leading verb appropriate to the seeding artifact's type; the by-type verbs below are suggestions, not the only legal choices.",
  "prefer": [
    "Event: publish, emit, start, close, trigger, notify.",
    "State: track, monitor, maintain, update, manage.",
    "Data: create, manage, process, handle, make, generate.",
    "Config: configure, setup, initialize, define, establish.",
    "match:started -> start-match; session:active -> maintain-session; player:profile -> manage-profile; match:config -> configure-match."
  ],
  "avoid": [
    "Treating the by-type table as the full set of legal verbs: alone it rejects even this convention's own examples (#1276).",
    "A leading verb outside verbs_by_type ∪ additional_verbs (verifier_detail[1]); the verb-object gates reject it."
  ],
  "unless": [],
  "why": "The artifact type (event, state, data, config) determines the appropriate verbs for the feature name, so names read consistently with what the artifact is.",
  "evidence": [
    "A reviewer confirms the feature's leading verb is appropriate to the seeding artifact's type (the by-type table is the reference set of suggestions).",
    "Separately (lexicon gate): the feature/wagon slug's leading token is a member of verbs_by_type ∪ additional_verbs."
  ],
  "verifier_detail": [
    "verbs_by_type (label 'Verbs by artifact type'; 'artifact type -> verbs.'): events=[publish, emit, start, close, trigger, notify]; states=[track, monitor, maintain, update, manage]; data=[create, manage, process, handle, make, generate]; configs=[configure, setup, initialize, define, establish]. 'manage' appears under both states and data. Positive examples: match:started -> start-match; session:active -> maintain-session; player:profile -> manage-profile; match:config -> configure-match.",
    "additional_verbs (label 'Verb-object enforcement allowlist'): the explicit allowlist of leading verbs a planner artifact slug may use, beyond the by_artifact_type suggestion verbs: admit, aggregate, allocate, annotate, apply, archive, assign, attach, authenticate, author, bind, bootstrap, bridge, broadcast, build, calculate, cancel, capture, check, classify, collect, commit, compare, compose, compute, connect, consolidate, convert, copy, correct, count, credit, decode, decommission, delegate, deliver, deploy, derive, describe, detach, detect, disable, discover, dispatch, download, drive, elicit, enable, encode, enforce, enrich, ensure, escalate, estimate, evaluate, expire, export, expose, extract, fetch, filter, finalize, fix, flush, forward, freeze, gather, govern, guard, hydrate, implement, import, index, inject, inspect, integrate, invoke, isolate, judge, launch, link, lint, list, load, lock, log, map, mark, match, measure, mediate, merge, migrate, mint, normalize, observe, open, orchestrate, parse, partition, pause, persist, ping, place, plan, poll, populate, post, prepare, preview, prioritize, produce, project, promote, prompt, propagate, provision, prune, pull, purge, push, queue, rank, read, rebuild, reconcile, record, redirect, refine, refresh, register, reject, release, reload, remove, rename, render, replay, replicate, report, request, resolve, respond, restore, resume, retrieve, retry, review, revoke, rollback, route, run, sample, save, scaffold, scan, schedule, score, search, seed, select, send, serve, show, sign, simulate, snapshot, spawn, split, stop, store, stream, submit, subscribe, summarize, surface, suspend, swap, sync, tag, teardown, throttle, toggle, trace, transform, translate, trim, tune, unlock, unsubscribe, upgrade, upload, validate, verify, visualize, warn, watch, wire, wrap.",
    "Enforcement (unconditional, applies to every feature and wagon slug, with or without a typed seed): planner.feature.name-is-verb-object and planner.wagon.name-is-verb-object accept a slug iff its leading token is in the union of additional_verbs and verbs_by_type. There is no prerequisite that a type verb be tried first. The verbs_by_type suggestion table alone is insufficient as an enforcement basis — it rejects even the convention's own examples (#1276)."
  ],
