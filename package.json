{
  "name": "@afokapu/pi-atdd",
  "version": "0.5.1",
  "type": "module",
  "description": "TypeScript Pi extension applying graph-scoped conventions",
  "pi": {
    "extensions": [
      "./extensions/atdd.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --import ./tests/setup/scrub-pi-atdd-env.ts --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "atdd": "node --experimental-strip-types src/cli.ts",
    "selectors:generate": "node --experimental-strip-types src/selector-generation.ts",
    "model-tier": "node --experimental-strip-types src/model-tier-cli.ts",
    "smoke:pi": "node --experimental-strip-types tests/pi-rpc-smoke.ts",
    "smoke:attention": "node --experimental-strip-types tests/attention-rpc-smoke.ts",
    "smoke:renewal": "node --experimental-strip-types tests/context-renewal-smoke.ts",
    "smoke:jj-handoff": "node --experimental-strip-types --test --test-name-pattern='jj handoff keeps' tests/context-renewal.test.ts",
    "smoke:install": "node --experimental-strip-types tests/pi-install-smoke.ts",
    "smoke:bundle": "node --experimental-strip-types --test tests/bundle.test.ts",
    "smoke:release": "node --experimental-strip-types tests/release-install-smoke.ts"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^22.16.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "files": [
    "extensions",
    "src",
    "vendor",
    "selectors",
    "catalog",
    "conventions",
    "conventions-sidecar",
    "README.md",
    "CHANGELOG.md"
  ]
}
