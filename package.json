{
  "name": "@afokapu/pi-atdd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript Pi extension applying graph-scoped conventions from ATDD-Bun and Flow",
  "pi": {
    "extensions": [
      "./extensions/atdd.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "atdd": "node --experimental-strip-types src/cli.ts",
    "smoke:pi": "node --experimental-strip-types tests/pi-rpc-smoke.ts",
    "smoke:catalog": "node --experimental-strip-types tests/full-catalog-smoke.ts .cache-sources/atdd-bun .cache-sources/atdd-flow",
    "smoke:install": "node --experimental-strip-types tests/pi-install-smoke.ts",
    "smoke:bundle": "node --experimental-strip-types --test tests/bundle.test.ts"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^22.16.0",
    "typescript": "^5.9.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "files": [
    "extensions",
    "src",
    "vendor",
    "selectors",
    "README.md"
  ]
}
