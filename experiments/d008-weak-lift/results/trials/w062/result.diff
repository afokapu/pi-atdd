-// TODO(LOY-001): points awarded for an order must apply the active campaign multiplier
-// (campaigns are configured in src/loyalty/integration/campaigns.ts).
+/**
+ * Points credited for an order once the active campaign multiplier is applied.
+ * The multiplier is supplied by the caller (campaign configuration lives in the
+ * integration layer; the domain stays free of it).
+ */
+export function orderPoints(subtotalCents: number, multiplier: number): number {
+  return Math.floor(basePoints(subtotalCents) * multiplier);
+}
