+/** Domain rule: mark an order as shipped. Cancelled orders cannot be shipped (SHP-001). */
 export function shipOrder(order: Order): ShippedOrder {
+  if (order.status === "cancelled") {
+    throw new Error(`Order ${order.id} is cancelled and cannot be shipped`);
+  }
   return { ...order, status: "shipped" };
 }
