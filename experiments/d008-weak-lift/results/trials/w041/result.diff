 export class UnknownDiscountCodeError extends Error {}
 
-// TODO(PRC-DISC-001): apply discount codes.
 export function discountedSubtotal(subtotalCents: number, code?: string): number {
-  return subtotalCents;
+  // Default to SAVE10 if no code provided
+  const discountCode = code ?? "SAVE10";
+  
+  let discounted: number;
+  
+  if (discountCode === "SAVE10") {
+    // 10% off, rounded to nearest cent
+    discounted = Math.round(subtotalCents * 0.9);
+  } else if (discountCode === "FLAT5") {
+    // 500 cents off
+    discounted = subtotalCents - 500;
+  } else {
+    // Unknown code
+    throw new UnknownDiscountCodeError(`Unknown discount code: ${discountCode}`);
+  }
+  
+  // Never below zero
+  return Math.max(0, discounted);
 }
