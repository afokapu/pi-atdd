+/**
+ * Loyalty domain: points earned for an order subtotal.
+ * Base points are 1 per whole euro; the active campaign multiplier is applied
+ * and the result is floored (LOY-001). Multiplier is 1 when no campaign is active.
+ */
+export function orderPoints(subtotalCents: number, campaignMultiplier: number): number {
+  return Math.floor(basePoints(subtotalCents) * campaignMultiplier);
+}
+
+/** Base points earned for an order subtotal (1 point per whole euro). */
 export function basePoints(subtotalCents: number): number {
   return Math.floor(subtotalCents / 100);
 }
