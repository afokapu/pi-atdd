 export class UnknownDiscountCodeError extends Error {}
 
-// TODO(PRC-DISC-001): apply discount codes.
+function roundToCent(cents: number): number {
+  return Math.round(cents * 100) / 100;
+}
+
+/**
+ * Apply a discount code to a cart subtotal (in cents).
+ * - SAVE10: 10% off, rounded to the nearest cent
+ * - FLAT5: 500 cents off
+ * The result is never below zero; unknown codes throw UnknownDiscountCodeError.
+ */
 export function discountedSubtotal(subtotalCents: number, code?: string): number {
-  return subtotalCents;
+  let discounted: number;
+  switch (code) {
+    case undefined:
+    case "SAVE10":
+      discounted = roundToCent(subtotalCents * 0.9);
+      break;
+    case "FLAT5":
+      discounted = subtotalCents - 500;
+      break;
+    default:
+      throw new UnknownDiscountCodeError(`Unknown discount code: ${code}`);
+  }
+  return Math.max(0, discounted);
 }
