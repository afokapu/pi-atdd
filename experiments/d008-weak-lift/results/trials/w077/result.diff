@@ -0,0 +1,19 @@
+import { basePoints, awardedPoints } from "../domain/points.ts";
+import { PointsLedger } from "../integration/points-ledger.ts";
+import { activeMultiplier } from "../integration/campaigns.ts";
+
+/**
+ * Award order points use case.
+ * Awards the order's points, credits them to the given points ledger,
+ * and returns the number of points awarded.
+ *
+ * The points rule (base points times the active campaign multiplier)
+ * uses the campaign configuration.
+ */
+export function awardOrderPoints(ledger: PointsLedger, customerId: string, subtotalCents: number): number {
+  const base = basePoints(subtotalCents);
+  const multiplier = activeMultiplier();
+  const awarded = awardedPoints(base, multiplier);
+  ledger.credit(customerId, awarded);
+  return awarded;
+}
