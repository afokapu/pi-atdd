@@ -2,7 +2,12 @@ import type { Order } from "../../orders/domain/order.ts";
 
 export type ShippedOrder = Order & { status: "shipped" };
 
-/** Domain rule: mark an order as shipped. */
+export class ShippingStateError extends Error {}
+
+/** Domain rule: mark an order as shipped. Only pending orders can be shipped. */
 export function shipOrder(order: Order): ShippedOrder {
+  if (order.status === "cancelled") {
+    throw new ShippingStateError("order " + order.id + " is cancelled");
+  }
   return { ...order, status: "shipped" };
 }
