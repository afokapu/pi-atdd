+/**
+ * LOY-001: points awarded for an order apply the active campaign multiplier:
+ * floor(base points x multiplier), with base points being 1 per whole euro.
+ */
+export function orderPoints(subtotalCents: number, multiplier: number): number {
+  return Math.floor(basePoints(subtotalCents) * multiplier);
+}
