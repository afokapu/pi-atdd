+/**
+ * Points awarded for an order (LOY-001): floor(base points x campaign
+ * multiplier). The multiplier is supplied by the caller (application layer),
+ * keeping the domain free of integration dependencies.
+ */
+export function pointsForOrder(subtotalCents: number, multiplier: number): number {
+  return Math.floor(basePoints(subtotalCents) * multiplier);
+}
