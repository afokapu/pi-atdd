+/** Application use case: award loyalty points for a customer's order (LOY-001). */
+import { pointsForOrder } from "../domain/points.ts";
+import { activeMultiplier } from "../integration/campaigns.ts";
+import type { PointsLedger } from "../integration/points-ledger.ts";
+
+/**
+ * Awards points for an order: floor(base points x active campaign multiplier),
+ * credits them to the ledger, and returns the number of points awarded.
+ */
+export function awardOrderPoints(
+  ledger: PointsLedger,
+  customerId: string,
+  subtotalCents: number,
+): number {
+  const points = pointsForOrder(subtotalCents, activeMultiplier());
+  ledger.credit(customerId, points);
+  return points;
+}
