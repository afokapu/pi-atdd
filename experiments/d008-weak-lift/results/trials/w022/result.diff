-export function discountedSubtotal(subtotalCents: number, code?: string): number {
-  return subtotalCents;
+export function discountedSubtotal(subtotalCents: number, code: string = "SAVE10"): number {
+  let result: number;
+
+  if (code === "SAVE10") {
+    // 10% off, rounded to nearest cent
+    result = Math.round(subtotalCents * 0.9);
+  } else if (code === "FLAT5") {
+    // 500 cents off
+    result = subtotalCents - 500;
+  } else {
+    throw new UnknownDiscountCodeError(`Unknown discount code: ${code}`);
+  }
+
+  // Result is never below zero
+  return Math.max(result, 0);
 }
