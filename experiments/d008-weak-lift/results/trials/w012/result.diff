 export class OrderStateError extends Error {}
 
+/** Domain rule: merge a source order into a target order.
+ * Items of the source are appended to the target; the source is cancelled.
+ * Both orders must belong to the same customer and be pending. */
+export function merge(source: Order, target: Order): { merged: Order; cancelled: Order } {
+  if (source.id === target.id) throw new OrderStateError("cannot merge an order into itself");
+  if (source.customerId !== target.customerId)
+    throw new OrderStateError("orders belong to different customers");
+  if (source.status !== "pending") throw new OrderStateError("order " + source.id + " is " + source.status);
+  if (target.status !== "pending") throw new OrderStateError("order " + target.id + " is " + target.status);
+  return {
+    merged: { ...target, items: [...target.items, ...source.items] },
+    cancelled: cancel(source),
+  };
+}
+
