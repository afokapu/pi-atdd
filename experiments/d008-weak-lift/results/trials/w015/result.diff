 export type Order = { id: string; customerId: string; status: OrderStatus; items: string[] };
 
 export class OrderStateError extends Error {}
+export class OrderOwnershipError extends Error {}
+
+/** Domain rule: merge the source order into the target — appends source items
+ * to the target and cancels the source. Both must be pending orders of the same customer. */
+export function mergeOrders(source: Order, target: Order, customerId: string): { target: Order; source: Order } {
+  if (source.customerId !== customerId || target.customerId !== customerId)
+    throw new OrderOwnershipError("orders must belong to the requesting customer");
+  if (target.status !== "pending") throw new OrderStateError("order " + target.id + " is " + target.status);
+  return {
+    target: { ...target, items: [...target.items, ...source.items] },
+    source: cancel(source),
+  };
+}
 
 /** Domain rule: only pending orders can be cancelled. Returns the new order value. */
 export function cancel(order: Order): Order {
