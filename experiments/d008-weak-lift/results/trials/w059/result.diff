+/** Use case: award points for an order and credit them to the customer's ledger. */
+import { basePoints } from "../domain/points.ts";
+import { activeMultiplier } from "../integration/campaigns.ts";
+import { PointsLedger } from "../integration/points-ledger.ts";
+
+export function awardOrderPoints(ledger: PointsLedger, customerId: string, subtotalCents: number): number {
+  const pointsBase = basePoints(subtotalCents);
+  const multiplier = activeMultiplier();
+  const awarded = Math.floor(pointsBase * multiplier);
+  ledger.credit(customerId, awarded);
+  return awarded;
+}
