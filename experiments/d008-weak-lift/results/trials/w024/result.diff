@@ -1,6 +1,7 @@
 import { Router } from "../../http/router.ts";
-import { withCustomer, type SessionStore } from "../../http/auth.ts";
+import { withCustomer, type SessionStore, currentCustomer } from "../../http/auth.ts";
 import type { InMemoryOrderStore } from "../integration/order-store.ts";
+import { cancel, mergeItems } from "../domain/order.ts";
 
 export type OrderRouteDeps = { orders: InMemoryOrderStore; sessions: SessionStore };
 
@@ -22,5 +23,25 @@ export function orderRoutes(router: Router, deps: OrderRouteDeps): Router {
     return { status: 201, body: order };
   }));
 
+  router.add("POST", "/orders/merge", (req) => {
+    const customer = currentCustomer(req, deps.sessions);
+    if (!customer) return { status: 401, body: { error: "authentication required" } };
+    const sourceId = (req.body as { sourceId?: unknown })?.sourceId;
+    const targetId = (req.body as { targetId?: unknown })?.targetId;
+    if (typeof sourceId !== "string" || typeof targetId !== "string")
+      return { status: 400, body: { error: "sourceId and targetId required" } };
+    const source = deps.orders.get(sourceId);
+    const target = deps.orders.get(targetId);
+    if (!source || !target)
+      return { status: 404, body: { error: "order not found" } };
+    if (source.customerId !== customer.id || target.customerId !== customer.id)
+      return { status: 403, body: { error: "order not owned by customer" } };
+    const mergedTarget = mergeItems(target, source);
+    const cancelledSource = cancel(source);
+    deps.orders.save(mergedTarget);
+    deps.orders.save(cancelledSource);
+    return { status: 200, body: { merged: true } };
+  });
+
   return router;
 }
