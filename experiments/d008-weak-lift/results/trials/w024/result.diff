diff --git a/src/orders/domain/order.ts b/src/orders/domain/order.ts
index cb107bb..ee47329 100644
--- a/src/orders/domain/order.ts
+++ b/src/orders/domain/order.ts
@@ -8,3 +8,11 @@ export function cancel(order: Order): Order {
   if (order.status !== "pending") throw new OrderStateError("order " + order.id + " is " + order.status);
   return { ...order, status: "cancelled" };
 }
+
+/** Domain rule: merge source order items into target order. Source order must be cancelled separately. */
+export function mergeItems(target: Order, source: Order): Order {
+  if (source.status !== "pending" || target.status !== "pending") {
+    throw new OrderStateError("both orders must be pending");
+  }
+  return { ...target, items: [...target.items, ...source.items] };
+}
diff --git a/src/orders/routes/order-routes.ts b/src/orders/routes/order-routes.ts
index 7ffd663..580e92b 100644
--- a/src/orders/routes/order-routes.ts
