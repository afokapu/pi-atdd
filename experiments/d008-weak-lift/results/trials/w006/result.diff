-// TODO(LOY-001): points awarded for an order must apply the active campaign multiplier
-// (campaigns are configured in src/loyalty/integration/campaigns.ts).
+/** Points awarded for an order: base points times the active campaign multiplier, floored. */
+export function awardedPoints(subtotalCents: number, multiplier: number): number {
+  const base = basePoints(subtotalCents);
+  return Math.floor(base * multiplier);
+}
