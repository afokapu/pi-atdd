  * Pricing domain: discount codes applied to a cart subtotal.
  * Known codes: SAVE10 (10% off) and FLAT5 (500 cents off).
  */
-export class UnknownDiscountCodeError extends Error {}
+export class UnknownDiscountCodeError extends Error {
+  constructor(code: string) {
+    super(`Unknown discount code: ${code}`);
+    this.name = "UnknownDiscountCodeError";
+  }
+}
 
-// TODO(PRC-DISC-001): apply discount codes.
 export function discountedSubtotal(subtotalCents: number, code?: string): number {
-  return subtotalCents;
+  if (code === undefined) return subtotalCents;
+  let result: number;
+  switch (code) {
+    case "SAVE10":
+      result = subtotalCents - Math.round(subtotalCents * 0.1);
+      break;
+    case "FLAT5":
+      result = subtotalCents - 500;
+      break;
+    default:
+      throw new UnknownDiscountCodeError(code);
+  }
+  return Math.max(0, result);
 }
