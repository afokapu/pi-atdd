 export class UnknownDiscountCodeError extends Error {}
 
-// TODO(PRC-DISC-001): apply discount codes.
+const KNOWN_CODES = new Set(["SAVE10", "FLAT5"]);
+
+/**
+ * Compute the discounted subtotal for a cart.
+ * - SAVE10: 10% off, rounded to the nearest cent.
+ * - FLAT5: 500 cents off.
+ * - The result is never below zero.
+ * - No code means no discount.
+ * - An unknown code is rejected with UnknownDiscountCodeError.
+ */
 export function discountedSubtotal(subtotalCents: number, code?: string): number {
-  return subtotalCents;
+  if (code !== undefined && !KNOWN_CODES.has(code)) {
+    throw new UnknownDiscountCodeError(`Unknown discount code: ${code}`);
+  }
+
+  let discountCents = 0;
+  if (code === "SAVE10") {
+    discountCents = Math.round(subtotalCents * 0.1);
+  } else if (code === "FLAT5") {
+    discountCents = 500;
+  }
+
+  return Math.max(0, subtotalCents - discountCents);
 }
