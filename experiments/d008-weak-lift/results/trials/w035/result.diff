diff --git a/src/orders/domain/order.ts b/src/orders/domain/order.ts
index cb107bb..553509c 100644
--- a/src/orders/domain/order.ts
+++ b/src/orders/domain/order.ts
@@ -8,3 +8,12 @@ export function cancel(order: Order): Order {
   if (order.status !== "pending") throw new OrderStateError("order " + order.id + " is " + order.status);
   return { ...order, status: "cancelled" };
 }
+
+/** Domain rule: merge the source order into the target order. Returns [target, cancelledSource]. */
+export function merge(source: Order, target: Order): [Order, Order] {
+  if (source.customerId !== target.customerId) throw new OrderStateError("orders belong to different customers");
+  if (source.id === target.id) throw new OrderStateError("cannot merge an order into itself");
+  if (target.status !== "pending") throw new OrderStateError("order " + target.id + " is " + target.status);
+  const cancelledSource = cancel(source);
+  return [{ ...target, items: [...target.items, ...source.items] }, cancelledSource];
+}
diff --git a/src/orders/routes/order-routes.ts b/src/orders/routes/order-routes.ts
index 7ffd663..36a4455 100644
--- a/src/orders/routes/order-routes.ts
