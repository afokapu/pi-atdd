@@ -3,6 +3,22 @@ export type Order = { id: string; customerId: string; status: OrderStatus; items
 
 export class OrderStateError extends Error {}
 
+/**
+ * Domain rule: merge a source order into a target order. Both must be pending
+ * and owned by the same customer. Returns [newTarget, cancelledSource].
+ */
+export function mergeInto(source: Order, target: Order, customerId: string): [Order, Order] {
+  if (source.customerId !== customerId || target.customerId !== customerId)
+    throw new OrderStateError("orders belong to a different customer");
+  if (source.id === target.id) throw new OrderStateError("cannot merge an order into itself");
+  if (source.status !== "pending") throw new OrderStateError("order " + source.id + " is " + source.status);
+  if (target.status !== "pending") throw new OrderStateError("order " + target.id + " is " + target.status);
+  return [
+    { ...target, items: [...target.items, ...source.items] },
+    cancel(source),
+  ];
+}
+
 /** Domain rule: only pending orders can be cancelled. Returns the new order value. */
 export function cancel(order: Order): Order {
   if (order.status !== "pending") throw new OrderStateError("order " + order.id + " is " + order.status);
