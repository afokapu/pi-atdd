 export class UnknownDiscountCodeError extends Error {}
 
-// TODO(PRC-DISC-001): apply discount codes.
 export function discountedSubtotal(subtotalCents: number, code?: string): number {
-  return subtotalCents;
+  // If no code is provided, return subtotal unchanged
+  if (!code) {
+    return subtotalCents;
+  }
+
+  let discountedAmount: number;
+
+  if (code === "SAVE10") {
+    // 10% off, rounded to nearest cent
+    discountedAmount = Math.round(subtotalCents * 0.1);
+  } else if (code === "FLAT5") {
+    // 500 cents off
+    discountedAmount = 500;
+  } else {
+    // Unknown code - reject with error
+    throw new UnknownDiscountCodeError(`Unknown discount code: ${code}`);
+  }
+
+  // Result is never below zero
+  return Math.max(0, subtotalCents - discountedAmount);
 }
