diff --git a/src/pricing/domain/discount.ts b/src/pricing/domain/discount.ts
index 516a9af..53aefed 100644
--- a/src/pricing/domain/discount.ts
+++ b/src/pricing/domain/discount.ts
@@ -6,5 +6,24 @@ export class UnknownDiscountCodeError extends Error {}
 
 // TODO(PRC-DISC-001): apply discount codes.
 export function discountedSubtotal(subtotalCents: number, code?: string): number {
-  return subtotalCents;
+  // Default to SAVE10 if no code provided
+  const discountCode = code ?? "SAVE10";
+
+  let discountedAmount: number;
+
+  switch (discountCode) {
+    case "SAVE10":
+      // 10% off, rounded to the nearest cent
+      discountedAmount = Math.round(subtotalCents * 0.9);
+      break;
+    case "FLAT5":
+      // 500 cents off
+      discountedAmount = subtotalCents - 500;
+      break;
+    default:
+      throw new UnknownDiscountCodeError(`Unknown discount code: ${discountCode}`);
+  }
+
+  // Result is never below zero
+  return Math.max(0, discountedAmount);
 }
