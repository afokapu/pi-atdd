--- a/src/orders/domain/order.ts
+++ b/src/orders/domain/order.ts
@@ -3,6 +3,15 @@ export type Order = { id: string; customerId: string; status: OrderStatus; items
 
 export class OrderStateError extends Error {}
 
+/** Domain rule: only pending orders can be merged. Returns the new target value. */
+export function merge(source: Order, target: Order): Order {
+  if (source.status !== "pending" || target.status !== "pending")
+    throw new OrderStateError("only pending orders can be merged");
+  if (source.customerId !== target.customerId)
+    throw new OrderStateError("orders belong to different customers");
+  return { ...target, items: [...target.items, ...source.items] };
+}
+
 /** Domain rule: only pending orders can be cancelled. Returns the new order value. */
 export function cancel(order: Order): Order {
   if (order.status !== "pending") throw new OrderStateError("order " + order.id + " is " + order.status);
