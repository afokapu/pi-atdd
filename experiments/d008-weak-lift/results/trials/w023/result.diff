+  router.add("POST", "/orders/merge", withCustomer(deps.sessions, (req, _params, customer) => {
+    const { sourceId, targetId } = (req.body ?? {}) as { sourceId?: string; targetId?: string };
+    if (!sourceId || !targetId) return { status: 400, body: { error: "sourceId and targetId required" } };
+    const source = deps.orders.get(sourceId);
+    const target = deps.orders.get(targetId);
+    if (!source || !target || source.customerId !== customer.id || target.customerId !== customer.id)
+      return { status: 404, body: { error: "order not found" } };
+    try {
+      deps.orders.save(merge(source, target));
+      deps.orders.save(cancel(source));
+      return { status: 200, body: deps.orders.get(targetId)! };
+    } catch (err) {
+      if (err instanceof OrderStateError) return { status: 409, body: { error: err.message } };
+      throw err;
