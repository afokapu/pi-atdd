diff --git a/src/shipping/domain/shipment.ts b/src/shipping/domain/shipment.ts
index 74dc359..2db0674 100644
--- a/src/shipping/domain/shipment.ts
+++ b/src/shipping/domain/shipment.ts
@@ -2,7 +2,15 @@ import type { Order } from "../../orders/domain/order.ts";
 
 export type ShippedOrder = Order & { status: "shipped" };
 
-/** Domain rule: mark an order as shipped. */
+export class ShipmentStateError extends Error {}
+
+/**
+ * Domain rule: mark an order as shipped.
+ * Shipping a cancelled order is rejected and the order stays cancelled.
+ */
 export function shipOrder(order: Order): ShippedOrder {
+  if (order.status === "cancelled") {
+    throw new ShipmentStateError("order " + order.id + " is cancelled");
+  }
   return { ...order, status: "shipped" };
 }
