+/** Use case LOY-001: award loyalty points for an order and credit them to the ledger. */
+import { orderPoints } from "../domain/points.ts";
+import { activeMultiplier } from "../integration/campaigns.ts";
+import type { PointsLedger } from "../integration/points-ledger.ts";
+
+/** Awards order points (base points x active campaign multiplier, floored) and credits the ledger. */
+export function awardOrderPoints(ledger: PointsLedger, customerId: string, subtotalCents: number): number {
+  const points = orderPoints(subtotalCents, activeMultiplier());
+  ledger.credit(customerId, points);
+  return points;
+}
