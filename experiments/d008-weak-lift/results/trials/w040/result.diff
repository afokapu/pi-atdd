@@ -1,6 +1,7 @@
 import { Router } from "../../http/router.ts";
 import { withCustomer, type SessionStore } from "../../http/auth.ts";
 import type { InMemoryOrderStore } from "../integration/order-store.ts";
+import { merge, cancel } from "../domain/order.ts";
 
 export type OrderRouteDeps = { orders: InMemoryOrderStore; sessions: SessionStore };
 
@@ -22,5 +23,22 @@ export function orderRoutes(router: Router, deps: OrderRouteDeps): Router {
     return { status: 201, body: order };
   }));
 
+  router.add("POST", "/orders/merge", withCustomer(deps.sessions, (req, _params, customer) => {
+    const { sourceId, targetId } = req.body as { sourceId?: unknown; targetId?: unknown };
+    if (typeof sourceId !== "string" || typeof targetId !== "string")
+      return { status: 400, body: { error: "sourceId and targetId required" } };
+    const sourceOrder = deps.orders.get(sourceId);
+    const targetOrder = deps.orders.get(targetId);
+    if (!sourceOrder || sourceOrder.customerId !== customer.id)
+      return { status: 404, body: { error: "source order not found" } };
+    if (!targetOrder || targetOrder.customerId !== customer.id)
+      return { status: 404, body: { error: "target order not found" } };
+    const mergedTarget = merge(sourceOrder, targetOrder);
+    const cancelledSource = cancel(sourceOrder);
+    deps.orders.save(mergedTarget);
+    deps.orders.save(cancelledSource);
+    return { status: 200, body: mergedTarget };
+  }));
+
   return router;
 }
