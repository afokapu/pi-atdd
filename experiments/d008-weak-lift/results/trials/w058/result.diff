-import type { Order } from "../../orders/domain/order.ts";
+import { OrderStateError, type Order } from "../../orders/domain/order.ts";
 
 export type ShippedOrder = Order & { status: "shipped" };
 
-/** Domain rule: mark an order as shipped. */
+/**
+ * Domain rule: mark an order as shipped.
+ * A cancelled order cannot be shipped (SHP-001); the caller must cancel the
+ * shipment request and the order value remains cancelled.
+ */
 export function shipOrder(order: Order): ShippedOrder {
+  if (order.status === "cancelled") {
+    throw new OrderStateError("order " + order.id + " is " + order.status);
+  }
   return { ...order, status: "shipped" };
 }
