+++ b/src/loyalty/application/award-points.ts
@@ -0,0 +1,20 @@
+import { basePoints, awardedPoints } from "../domain/points.ts";
+import { activeMultiplier } from "../integration/campaigns.ts";
+import { PointsLedger } from "../integration/points-ledger.ts";
+
+/**
+ * Award points for a customer's order and credit them to the ledger.
+ * Points = floor(base points × active campaign multiplier),
+ * where base points = 1 per whole euro of the subtotal.
+ */
+export function awardOrderPoints(
+  ledger: PointsLedger,
+  customerId: string,
+  subtotalCents: number
+): number {
+  const base = basePoints(subtotalCents);
+  const multiplier = activeMultiplier();
+  const awarded = awardedPoints(base, multiplier);
+  ledger.credit(customerId, awarded);
+  return awarded;
+}
