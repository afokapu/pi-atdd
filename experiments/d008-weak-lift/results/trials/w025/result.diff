+import { basePoints } from "../domain/points.ts";
+import { activeMultiplier } from "../integration/campaigns.ts";
+import { PointsLedger } from "../integration/points-ledger.ts";
+
+/**
+ * Award points use case: awards order points to a customer's loyalty ledger.
+ * Points are calculated as floor(base points × active campaign multiplier),
+ * where base points are 1 per whole euro of the order subtotal.
+ *
+ * @param ledger The points ledger to credit
+ * @param customerId The customer's ID
+ * @param subtotalCents The order subtotal in cents
+ * @returns The number of points awarded
+ */
+export function awardOrderPoints(ledger: PointsLedger, customerId: string, subtotalCents: number): number {
+  const base = basePoints(subtotalCents);
+  const multiplier = activeMultiplier();
+  const awarded = Math.floor(base * multiplier);
+  ledger.credit(customerId, awarded);
+  return awarded;
+}
