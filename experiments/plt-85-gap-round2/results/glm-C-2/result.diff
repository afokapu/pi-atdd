@@ -1,6 +1,8 @@
 /**
  * Loyalty domain. Points are held in lots; each lot expires at `expiresAt`
  * (a lot is usable strictly before its expiry instant). 100 points = 1 EUR.
+ * Consumption always draws from non-expired lots, earliest expiry first, so
+ * points about to die are spent before points with time left.
  */
 export type PointsLot = {
   id: string;
@@ -10,6 +12,12 @@ export type PointsLot = {
   expiresAt: Date;
 };
 
+/** One draw against a single lot, recorded so the exact amounts can be reversed. */
+export type Allocation = { lotId: string; points: number };
+
+/** Conversion rate: 100 points = 1 EUR = 100 cents, so 1 point = 1 cent. */
+export const CENTS_PER_POINT = 1;
+
 /** Base points earned for an order subtotal (1 point per whole euro). */
 export function basePoints(subtotalCents: number): number {
   return Math.floor(subtotalCents / 100);
@@ -18,3 +26,59 @@ export function basePoints(subtotalCents: number): number {
 export function isExpired(lot: PointsLot, at: Date): boolean {
   return lot.expiresAt.getTime() <= at.getTime();
 }
+
+/**
+ * Points actually applied to a payable amount of `amountCents`: capped to the
+ * amount (excess points stay in their lots) and never negative.
+ */
+export function applicablePoints(requestedPoints: number, amountCents: number): number {
+  return Math.max(0, Math.min(requestedPoints, Math.floor(amountCents / CENTS_PER_POINT)));
+}
+
+/** Lots the customer can still spend at `at`: non-empty and not expired. */
+export function spendableLots(lots: PointsLot[], at: Date): PointsLot[] {
+  return lots.filter(l => l.points > 0 && !isExpired(l, at));
+}
+
+/** Total points the customer can spend at `at` (expired lots are worthless). */
+export function spendablePoints(lots: PointsLot[], at: Date): number {
+  return spendableLots(lots, at).reduce((sum, l) => sum + l.points, 0);
+}
+
+/**
+ * Plan drawing exactly `points` points from usable lots, earliest expiry first
+ * (lot id breaks ties for determinism). The caller must have checked
+ * `spendablePoints >= points`; the returned allocations sum to exactly `points`.
+ */
+export function planConsumption(lots: PointsLot[], points: number, at: Date): Allocation[] {
+  const earliestExpiryFirst = [...spendableLots(lots, at)]
+    .sort((a, b) => a.expiresAt.getTime() - b.expiresAt.getTime() || (a.id < b.id ? -1 : 1));
+  const plan: Allocation[] = [];
+  let remaining = points;
+  for (const lot of earliestExpiryFirst) {
+    if (remaining <= 0) break;
+    const take = Math.min(lot.points, remaining);
+    plan.push({ lotId: lot.id, points: take });
+    remaining -= take;
+  }
+  return plan;
+}
+
+export type Restoration = { restored: Allocation[]; forfeited: Allocation[] };
+
+/**
+ * Plan the exact reversal of a consumption: every allocation goes back to its
+ * own original lot (keeping that lot's original expiry), unless the lot has
+ * expired by `at` — those points are forfeited, never re-issued as a fresh lot.
+ */
+export function planRestoration(allocations: Allocation[], lots: PointsLot[], at: Date): Restoration {
+  const byId = new Map(lots.map(l => [l.id, l]));
+  const restored: Allocation[] = [];
+  const forfeited: Allocation[] = [];
+  for (const a of allocations) {
+    const lot = byId.get(a.lotId);
+    if (lot && !isExpired(lot, at)) restored.push(a);
+    else forfeited.push(a);
+  }
+  return { restored, forfeited };
+}
diff --git a/src/loyalty/integration/redemption-store.ts b/src/loyalty/integration/redemption-store.ts
new file mode 100644
index 0000000..43a9f21
--- /dev/null
+++ b/src/loyalty/integration/redemption-store.ts
@@ -0,0 +1,89 @@
+import type { Allocation } from "../domain/points.ts";
+import type { QuoteWithPoints } from "../../pricing/domain/quote.ts";
+
+/** Simulated I/O latency: every call yields to the event loop before touching data. */
+const io = () => new Promise<void>(resolve => setTimeout(resolve, 1));
+
+/**
+ * One recorded redemption of loyalty points against an order. `scope` +
+ * `idempotencyKey` is the unique replay index: the same key under another
+ * customer/order scope is a different key, so keys never collide across callers.
+ * The original response is stored verbatim so a matching retry replays exactly
+ * the first result, and the allocations are stored so a cancel can restore the
+ * exact amounts to the exact lots they were drawn from.
+ */
+export type RedemptionRecord = {
+  /** Replay scope, `customerId:orderId`. */
+  scope: string;
+  idempotencyKey: string;
+  /** Fingerprint of the normalised request payload (everything except the key itself). */
+  fingerprint: string;
+  orderId: string;
+  customerId: string;
+  /** Points actually consumed — less than requested when the payable amount ran out first. */
+  pointsApplied: number;
+  /** Which lots were drawn; a reversal restores exactly these amounts to these lots. */
+  allocations: Allocation[];
+  /** The original result, replayed unchanged for a matching retry. */
+  response: { status: number; body: QuoteWithPoints };
+  /** Set once when cancelling the order has restored (or forfeited) the allocations. */
+  reversed: boolean;
+};
+
+/** Composite store key; \u0000 can never appear in a customer or order id. */
+const recordKey = (scope: string, idempotencyKey: string): string => scope + "\u0000" + idempotencyKey;
+
+const copy = (r: RedemptionRecord): RedemptionRecord => ({
+  ...r,
+  allocations: r.allocations.map(a => ({ ...a })),
+  response: { ...r.response, body: { ...r.response.body } },
+});
+
+/**
+ * Adapter over the redemption ledger (in memory for this service), asynchronous
+ * like the real database client. `recordIfAbsent` plays the role of the unique
+ * constraint that claims an idempotency key inside the use case's critical section.
+ */
+export class InMemoryRedemptionStore {
+  private byKey = new Map<string, RedemptionRecord>();
+  /** Secondary index: order id → record keys, so reversal never scans all records. */
+  private keysByOrder = new Map<string, Set<string>>();
+
+  /** The recorded redemption for a replay scope, if any. */
+  async find(scope: string, idempotencyKey: string): Promise<RedemptionRecord | undefined> {
+    await io();
+    const r = this.byKey.get(recordKey(scope, idempotencyKey));
+    return r && copy(r);
+  }
+
+  /** All redemption records of one order (usually zero or one). */
+  async forOrder(orderId: string): Promise<RedemptionRecord[]> {
+    await io();
+    const keys = this.keysByOrder.get(orderId) ?? new Set<string>();
+    return [...keys].map(k => copy(this.byKey.get(k)!));
+  }
+
+  /** Insert a new record; resolves `false` when the (scope, key) is already claimed. */
+  async recordIfAbsent(record: RedemptionRecord): Promise<boolean> {
+    await io();
+    const key = recordKey(record.scope, record.idempotencyKey);
+    if (this.byKey.has(key)) return false;
+    this.byKey.set(key, copy(record));
+    this.index(record.orderId, key);
+    return true;
+  }
+
+  /** Insert or replace a record (e.g. marking it reversed after a cancel). */
+  async save(record: RedemptionRecord): Promise<void> {
+    await io();
+    const key = recordKey(record.scope, record.idempotencyKey);
+    this.byKey.set(key, copy(record));
+    this.index(record.orderId, key);
+  }
+
+  private index(orderId: string, key: string): void {
+    const keys = this.keysByOrder.get(orderId) ?? new Set<string>();
+    keys.add(key);
+    this.keysByOrder.set(orderId, keys);
+  }
+}
diff --git a/src/orders/application/cancel-order.ts b/src/orders/application/cancel-order.ts
new file mode 100644
index 0000000..ca607df
--- /dev/null
+++ b/src/orders/application/cancel-order.ts
@@ -0,0 +1,64 @@
+import { cancel, OrderNotFoundError, OrderStateError, type Order } from "../domain/order.ts";
+import { planRestoration, type Allocation } from "../../loyalty/domain/points.ts";
+import type { InMemoryLoyaltyStore } from "../../loyalty/integration/loyalty-store.ts";
+import type { InMemoryRedemptionStore, RedemptionRecord } from "../../loyalty/integration/redemption-store.ts";
+import type { LedgerDeps } from "./redeem-points.ts";
+
+export type CancelOutcome = {
+  order: Order;
+  /** Points returned to their original lots (sum over restored allocations). */
+  restoredPoints: number;
+  /** Points whose lot had expired by reversal time (sum; discarded, never re-issued). */
+  forfeitedPoints: number;
+};
+
+/**
+ * Use case: cancel a pending order. Runs in the same per-customer lock as
+ * redeem, so a concurrent redemption cannot interleave with the reversal. If
+ * the order was paid partly with points, every redemption record of the order
+ * is reversed exactly once: the recorded allocations go back to their original
+ * lots, original expiry intact; points whose lot expired meanwhile are
+ * forfeited — never rebuilt from current balances, never re-issued as fresh lots.
+ */
+export async function cancelOrder(deps: LedgerDeps, orderId: string, customerId: string): Promise<CancelOutcome> {
+  return deps.locks.run(customerId, () => cancelExclusively(deps, orderId, customerId));
+}
+
+async function cancelExclusively(deps: LedgerDeps, orderId: string, customerId: string): Promise<CancelOutcome> {
+  const order = deps.orders.get(orderId);
+  if (!order || order.customerId !== customerId) throw new OrderNotFoundError(orderId);
+  const cancelled = cancel(order); // domain rule: pending only — throws OrderStateError otherwise
+  const reversals = await reverseRedemptions(deps, orderId);
+  deps.orders.save(cancelled);
+  return { order: cancelled, restoredPoints: reversals.restored, forfeitedPoints: reversals.forfeited };
+}
+
+/** Reverse every not-yet-reversed redemption of the order, exactly once each. */
+async function reverseRedemptions(deps: LedgerDeps, orderId: string): Promise<{ restored: number; forfeited: number }> {
+  const records = await deps.redemptions.forOrder(orderId);
+  let restored = 0;
+  let forfeited = 0;
+  for (const record of records) {
+    if (record.reversed) continue; // guard: a reversal applies once, even across repeated cancels
+    const outcome = await restoreAllocations(deps, record);
+    restored += outcome.restored;
+    forfeited += outcome.forfeited;
+  }
+  return { restored, forfeited };
+}
+
+/** Restore the recorded allocations from `record`; the reversal decision uses the injected clock. */
+async function restoreAllocations(deps: LedgerDeps, record: RedemptionRecord): Promise<{ restored: number; forfeited: number }> {
+  const lots = await deps.loyalty.lotsFor(record.customerId);
+  const { restored, forfeited } = planRestoration(record.allocations, lots, deps.now());
+  const byId = new Map(lots.map(l => [l.id, l]));
+  for (const a of restored) {
+    const lot = byId.get(a.lotId)!; // allocations always reference existing lots of this customer
+    await deps.loyalty.saveLot({ ...lot, points: lot.points + a.points });
+  }
+  record.reversed = true;
+  await deps.redemptions.save(record);
+  return { restored: sumPoints(restored), forfeited: sumPoints(forfeited) };
+}
+
+const sumPoints = (allocations: Allocation[]): number => allocations.reduce((sum, a) => sum + a.points, 0);
diff --git a/src/orders/application/per-key-lock.ts b/src/orders/application/per-key-lock.ts
new file mode 100644
index 0000000..bfa7dc5
--- /dev/null
+++ b/src/orders/application/per-key-lock.ts
@@ -0,0 +1,21 @@
+/**
+ * Serialises asynchronous operations per key (e.g. per customer), so a
+ * read-decide-write sequence against a shared async store cannot interleave:
+ * while one operation runs for a key, every other operation for the same key
+ * queues behind it. Operations for different keys run concurrently.
+ */
+export class PerKeyLock {
+  /** Last settled (failure-swallowed) operation per key; the queue tail. */
+  private tails = new Map<string, Promise<void>>();
+
+  /** Run `op` exclusively among operations for `key`; resolves/rejects with op's outcome. */
+  run<T>(key: string, op: () => Promise<T>): Promise<T> {
+    const result = (this.tails.get(key) ?? Promise.resolve()).then(op);
+    // The tail must never reject, or every queued operation for the key would stall.
+    const tail = result.then(() => undefined, () => undefined);
+    this.tails.set(key, tail);
+    // Forget the tail once it settles last, so the map does not grow with stale keys.
+    tail.then(() => { if (this.tails.get(key) === tail) this.tails.delete(key); });
+    return result;
+  }
+}
diff --git a/src/orders/application/redeem-points.ts b/src/orders/application/redeem-points.ts
new file mode 100644
index 0000000..7e8980b
--- /dev/null
+++ b/src/orders/application/redeem-points.ts
@@ -0,0 +1,132 @@
+import {
+  applicablePoints,
+  planConsumption,
+  spendablePoints,
+  type Allocation,
+  type PointsLot,
+} from "../../loyalty/domain/points.ts";
+import type { InMemoryLoyaltyStore } from "../../loyalty/integration/loyalty-store.ts";
+import type { InMemoryRedemptionStore } from "../../loyalty/integration/redemption-store.ts";
+import { quoteForOrder, quoteForOrderWithPoints } from "../../pricing/application/quote-service.ts";
+import type { QuoteWithPoints } from "../../pricing/domain/quote.ts";
+import { OrderNotFoundError, OrderStateError, type Order } from "../domain/order.ts";
+import { PerKeyLock } from "./per-key-lock.ts";
+
+/** The customer does not hold enough spendable (non-expired) points. */
+export class InsufficientPointsError extends Error {}
+
+/** The idempotency key was already used with a different payload. */
+export class IdempotencyConflictError extends Error {}
+
+/**
+ * Collaborators shared by the order use cases that move loyalty points.
+ * Constructed once in the composition root (`src/app.ts`) and shared by the
+ * redeem and cancel flows, so both serialise on the same per-customer locks.
+ */
+export type LedgerDeps = {
+  orders: InMemoryOrderStore;
+  loyalty: InMemoryLoyaltyStore;
+  redemptions: InMemoryRedemptionStore;
+  locks: PerKeyLock;
+  /** Current time — decides lot expiry at consumption and at reversal. */
+  now: () => Date;
+};
+
+export type RedeemCommand = {
+  orderId: string;
+  customerId: string;
+  points: number;
+  idempotencyKey: string;
+};
+
+/** Replay scope: keys are never compared across customers or orders. */
+const replayScope = (cmd: RedeemCommand): string => cmd.customerId + ":" + cmd.orderId;
+
+/** Fingerprint of the normalised payload — the body minus the key itself. */
+const fingerprint = (points: number): string => JSON.stringify({ points });
+
+/**
+ * Use case: pay part of a pending order with loyalty points.
+ *
+ * Money order (integer cents): subtotal → discount → points = taxable base;
+ * tax is computed once on that reduced base. Requested points are capped to the
+ * discounted amount first (`applicablePoints`), so excess points stay in the lots.
+ *
+ * The whole read-decide-write runs inside the customer's lock: two concurrent
+ * redemptions for one customer can never draw the same lot twice, because the
+ * second sees the first's writes. A matching retry replays the stored result
+ * without consuming anything; a different payload under a used key is rejected.
+ */
+export async function redeemForOrder(deps: LedgerDeps, cmd: RedeemCommand): Promise<QuoteWithPoints> {
+  return deps.locks.run(cmd.customerId, () => redeemExclusively(deps, cmd));
+}
+
+async function redeemExclusively(deps: LedgerDeps, cmd: RedeemCommand): Promise<QuoteWithPoints> {
+  // Preconditions re-checked inside the critical section, exactly as for a first request.
+  const order = deps.orders.get(cmd.orderId);
+  if (!order || order.customerId !== cmd.customerId) throw new OrderNotFoundError(cmd.orderId);
+  if (order.status !== "pending") throw new OrderStateError("order " + order.id + " is " + order.status);
+  const replay = await replayIfKnown(deps, cmd);
+  if (replay) return replay;
+  const { applied, allocations, lots } = await consumptionPlan(deps, order, cmd.points);
+  await drawLots(deps, lots, allocations);
+  const result = quoteForOrderWithPoints(order, applied);
+  await claimRecord(deps, cmd, applied, allocations, result);
+  return result;
+}
+
+/** Replay path: same key + same payload → the stored original result, verbatim. */
+async function replayIfKnown(deps: LedgerDeps, cmd: RedeemCommand): Promise<QuoteWithPoints | undefined> {
+  const existing = await deps.redemptions.find(replayScope(cmd), cmd.idempotencyKey);
+  if (!existing) return undefined;
+  if (existing.fingerprint !== fingerprint(cmd.points))
+    throw new IdempotencyConflictError("idempotency key was already used with a different payload");
+  return existing.response.body;
+}
+
+/**
+ * Decide how much to apply and which lots to draw. Points reduce after discount,
+ * before tax; more than the discounted amount is never applied; the customer
+ * must hold enough spendable (non-expired) points for what will be consumed.
+ */
+async function consumptionPlan(deps: LedgerDeps, order: Order, requestedPoints: number)
+  : Promise<{ applied: number; allocations: Allocation[]; lots: PointsLot[] }> {
+  const base = quoteForOrder(order);
+  const lots = await deps.loyalty.lotsFor(order.customerId);
+  const at = deps.now();
+  const applied = applicablePoints(requestedPoints, base.subtotalCents - base.discountCents);
+  const available = spendablePoints(lots, at);
+  if (applied > available) throw new InsufficientPointsError("needs " + applied + " points, customer has " + available + " spendable");
+  return { applied, allocations: planConsumption(lots, applied, at), lots };
+}
+
+/** Persist the planned draws lot by lot; runs inside the customer's lock. */
+async function drawLots(deps: LedgerDeps, lots: PointsLot[], allocations: Allocation[]): Promise<void> {
+  const byId = new Map(lots.map(l => [l.id, l]));
+  for (const a of allocations) {
+    const lot = byId.get(a.lotId)!; // allocation came from this snapshot, under the lock
+    await deps.loyalty.saveLot({ ...lot, points: lot.points - a.points });
+  }
+}
+
+/**
+ * Store the replay record with the full original result. The key is claimed
+ * here, inside the same critical section as the draw, so a concurrent duplicate
+ * can never also run. `recordIfAbsent` mirrors the ledger's unique constraint;
+ * while the customer's lock is held a conflict is impossible, so a `false` here
+ * signals a broken invariant rather than a recoverable race.
+ */
+async function claimRecord(deps: LedgerDeps, cmd: RedeemCommand, applied: number, allocations: Allocation[], result: QuoteWithPoints): Promise<void> {
+  const claimed = await deps.redemptions.recordIfAbsent({
+    scope: replayScope(cmd),
+    idempotencyKey: cmd.idempotencyKey,
+    fingerprint: fingerprint(cmd.points),
+    orderId: cmd.orderId,
+    customerId: cmd.customerId,
+    pointsApplied: applied,
+    allocations,
+    response: { status: 200, body: result },
+    reversed: false,
+  });
+  if (!claimed) throw new IdempotencyConflictError("idempotency key already used");
+}
