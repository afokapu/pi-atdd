diff --git a/src/pricing/domain/quote.ts b/src/pricing/domain/quote.ts
index 26cc297..97512a0 100644
--- a/src/pricing/domain/quote.ts
+++ b/src/pricing/domain/quote.ts
@@ -2,6 +2,10 @@ import { discountCents } from "./discount.ts";
 
 export type Line = { sku: string; unitPriceCents: number; quantity: number };
 export type Quote = { region: string; subtotalCents: number; discountCents: number; taxCents: number; totalCents: number };
+export type QuoteWithPoints = Quote & {
+  /** Value of loyalty points applied, in cents (a reduction after discount, before tax). */
+  pointsCents: number;
+};
 
 export function subtotal(lines: Line[]): number {
   return lines.reduce((sum, l) => sum + l.unitPriceCents * l.quantity, 0);
@@ -19,3 +23,20 @@ export function quote(lines: Line[], region: string, taxRate: number, discountCo
   const taxCents = taxOn(subtotalCents - discount, taxRate);
   return { region, subtotalCents, discountCents: discount, taxCents, totalCents: subtotalCents - discount + taxCents };
 }
+
+/**
+ * Price a cart partly with loyalty points, in integer cents. Adjustment order:
+ * subtotal → discount → points (capped so the base never drops below zero) →
+ * tax, computed exactly once on the fully reduced base → total.
+ * Callers pass the applied value in cents, already capped to what the customer
+ * can spend (see loyalty domain `applicablePoints`); it is clamped here again
+ * as the domain invariant "the payable amount is never below zero".
+ */
+export function quoteWithPoints(lines: Line[], region: string, taxRate: number, discountCode: string | undefined, pointsCents: number): QuoteWithPoints {
+  const subtotalCents = subtotal(lines);
+  const discount = discountCents(subtotalCents, discountCode);
+  const applied = Math.max(0, Math.min(pointsCents, subtotalCents - discount));
+  const taxableCents = subtotalCents - discount - applied;
+  const taxCents = taxOn(taxableCents, taxRate);
+  return { region, subtotalCents, discountCents: discount, pointsCents: applied, taxCents, totalCents: taxableCents + taxCents };
+}
diff --git a/tests/loyalty/points.test.ts b/tests/loyalty/points.test.ts
new file mode 100644
index 0000000..1a30290
--- /dev/null
+++ b/tests/loyalty/points.test.ts
@@ -0,0 +1,86 @@
+/**
+ * LOY-002 domain rules: points apply to a payable amount capped and never below
+ * zero; consumption draws non-expired lots earliest expiry first; reversal
+ * restores the recorded allocations unless the lot expired meanwhile.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  applicablePoints,
+  planConsumption,
+  planRestoration,
+  spendablePoints,
+  type PointsLot,
+} from "../../src/loyalty/domain/points.ts";
+import { quoteForOrderWithPoints } from "../../src/pricing/application/quote-service.ts";
+import type { Line } from "../../src/pricing/domain/quote.ts";
+
+const lot = (id: string, points: number, expiresAt: string): PointsLot =>
+  ({ id, customerId: "c", points, expiresAt: new Date(expiresAt) });
+
+const now = new Date("2026-11-19T12:00:00Z");
+
+test("applicablePoints: capped to the amount, never negative, excess not consumed", () => {
+  assert.equal(applicablePoints(500, 10000), 500); // below the amount: all applied
+  assert.equal(applicablePoints(10000, 500), 500); // reduction equal to the base
+  assert.equal(applicablePoints(9999, 500), 500); // larger than the base: capped, excess stays
+  assert.equal(applicablePoints(0, 500), 0);
+  assert.equal(applicablePoints(100, 0), 0);
+  assert.equal(applicablePoints(-5, 500), 0);
+});
+
+test("spendablePoints ignores empty and expired lots", () => {
+  const lots = [lot("a", 300, "2027-01-31T00:00:00Z"), lot("b", 500, "2025-01-01T00:00:00Z"), lot("c", 0, "2027-01-31T00:00:00Z")];
+  assert.equal(spendablePoints(lots, now), 300);
+});
+
+test("planConsumption: earliest expiry first, expired lots skipped, exact total", () => {
+  const lots = [
+    lot("late", 300, "2026-12-31T00:00:00Z"),
+    lot("expired", 1000, "2025-06-30T00:00:00Z"),
+    lot("early", 500, "2026-12-01T00:00:00Z"),
+  ];
+  assert.deepEqual(planConsumption(lots, 600, now), [
+    { lotId: "early", points: 500 }, // expires first
+    { lotId: "late", points: 100 },
+  ]);
+});
+
+test("planConsumption: same expiry broken by lot id, zero points draws nothing", () => {
+  const lots = [lot("b", 100, "2027-01-01T00:00:00Z"), lot("a", 100, "2027-01-01T00:00:00Z")];
+  assert.deepEqual(planConsumption(lots, 100, now), [{ lotId: "a", points: 100 }]);
+  assert.deepEqual(planConsumption(lots, 0, now), []);
+});
+
+test("planRestoration: restored to original lots, expired lots forfeited", () => {
+  const lots = [lot("early", 0, "2026-12-01T00:00:00Z"), lot("late", 100, "2027-06-30T00:00:00Z")];
+  const allocations = [{ lotId: "early", points: 500 }, { lotId: "late", points: 300 }];
+  const outcome = planRestoration(allocations, lots, new Date("2027-01-15T00:00:00Z"));
+  assert.deepEqual(outcome.restored, [{ lotId: "late", points: 300 }]);
+  assert.deepEqual(outcome.forfeited, [{ lotId: "early", points: 500 }]);
+});
+
+test("quoteWithPoints: points reduce after discount, before tax, in integer cents", () => {
+  const lines: Line[] = [{ sku: "sku-1", unitPriceCents: 2500, quantity: 4 }];
+  // 10000 subtotal, SAVE10 → 1000 discount, 8000 points applied → taxable 1000, 19% = 190
+  const q = quoteForOrderWithPoints({ lines, region: "DE", discountCode: "SAVE10" }, 8000);
+  assert.deepEqual(q, { region: "DE", subtotalCents: 10000, discountCents: 1000, pointsCents: 8000, taxCents: 190, totalCents: 1190 });
+});
+
+test("quoteWithPoints: reduction equal to the base → total zero; larger is capped", () => {
+  const lines: Line[] = [{ sku: "a", unitPriceCents: 900, quantity: 1 }];
+  const equal = quoteForOrderWithPoints({ lines, region: "DE" }, 900);
+  assert.deepEqual(equal, { region: "DE", subtotalCents: 900, discountCents: 0, pointsCents: 900, taxCents: 0, totalCents: 0 });
+  const over = quoteForOrderWithPoints({ lines, region: "DE" }, 5000);
+  assert.equal(over.pointsCents, 900); // excess points are not consumed
+  assert.equal(over.totalCents, 0);
+});
+
+test("quoteWithPoints: tax rounding half case and zero points input", () => {
+  const lines: Line[] = [{ sku: "a", unitPriceCents: 2050, quantity: 1 }];
+  // 2050 − 1000 points = 1050 taxable; 19% = 199.5 → rounds to 200
+  const half = quoteForOrderWithPoints({ lines, region: "DE" }, 1000);
+  assert.deepEqual(half, { region: "DE", subtotalCents: 2050, discountCents: 0, pointsCents: 1000, taxCents: 200, totalCents: 1250 });
+  const none = quoteForOrderWithPoints({ lines, region: "DE", discountCode: "SAVE10" }, 0);
+  assert.deepEqual(none, { region: "DE", subtotalCents: 2050, discountCents: 205, pointsCents: 0, taxCents: 351, totalCents: 2196 });
+});
diff --git a/tests/loyalty/redeem.acceptance.test.ts b/tests/loyalty/redeem.acceptance.test.ts
new file mode 100644
index 0000000..309f40e
--- /dev/null
+++ b/tests/loyalty/redeem.acceptance.test.ts
@@ -0,0 +1,121 @@
+/**
+ * Acceptance LOY-REDEEM-001
+ * Given a pending order owned by the signed-in customer
+ * When the customer sends POST /orders/:id/redeem with { points, idempotencyKey }
+ * Then the response is the new quote (points applied after discount, before tax),
+ * the earliest-expiring lots are consumed, and retries with the same key are idempotent.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { app, asAlice, asBob, pendingOrder } from "../orders/helpers.ts";
+import { seedLots } from "../../src/seed.ts";
+import type { PointsLot } from "../../src/loyalty/domain/points.ts";
+
+const redeem = (router: ReturnType<typeof app>["router"], key: string, points: number, headers = asAlice) =>
+  router.handle({ method: "POST", path: "/orders/o1/redeem", headers, body: { points, idempotencyKey: key } });
+
+const lotById = async (loyalty: ReturnType<typeof app>["loyalty"], customerId: string) =>
+  new Map((await loyalty.lotsFor(customerId)).map(l => [l.id, l]));
+
+test("LOY-REDEEM-001: redeem applies points after discount, before tax, earliest-expiring lots first", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots);
+  const res = await redeem(router, "key-1", 300);
+  assert.equal(res.status, 200);
+  // 10000 subtotal, no discount; 300 points = 300 cents → taxable 9700; 19% = 1843
+  assert.deepEqual(res.body, { region: "DE", subtotalCents: 10000, discountCents: 0, pointsCents: 300, taxCents: 1843, totalCents: 11543 });
+  const lots = await lotById(loyalty, "alice");
+  assert.equal(lots.get("lot-a2")!.points, 200); // expires 2026-12-01, drawn first
+  assert.equal(lots.get("lot-a1")!.points, 300); // expires 2026-12-31, untouched
+  assert.equal(lots.get("lot-a3")!.points, 1000); // expired lot, never consumed
+});
+
+test("LOY-REDEEM-001: points reduce after discount; excess points are not consumed", async () => {
+  const lots: PointsLot[] = [1, 2, 3, 4, 5].map(i =>
+    ({ id: "l" + i, customerId: "alice", points: 2000, expiresAt: new Date("2027-0" + i + "-01T00:00:00Z") }));
+  const { router, loyalty } = app([pendingOrder({ discountCode: "SAVE10" })], lots);
+  const res = await redeem(router, "key-big", 9500);
+  assert.equal(res.status, 200);
+  // 10000 − 1000 discount = 9000 taxable; 9500 requested but only 9000 applicable → total 0
+  assert.deepEqual(res.body, { region: "DE", subtotalCents: 10000, discountCents: 1000, pointsCents: 9000, taxCents: 0, totalCents: 0 });
+  const remaining = (await loyalty.lotsFor("alice")).reduce((sum, l) => sum + l.points, 0);
+  assert.equal(remaining, 1000); // exactly 9000 consumed, the 500 excess points stay
+});
+
+test("same key and payload replays the stored result and consumes nothing more", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots);
+  const first = await redeem(router, "key-1", 300);
+  const again = await redeem(router, "key-1", 300);
+  assert.equal(again.status, 200);
+  assert.deepEqual(again.body, first.body);
+  const lots = await lotById(loyalty, "alice");
+  assert.equal(lots.get("lot-a2")!.points, 200); // unchanged since the first call
+});
+
+test("same key with a different body is rejected and changes nothing", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots);
+  await redeem(router, "key-1", 300);
+  const res = await redeem(router, "key-1", 100);
+  assert.equal(res.status, 409);
+  assert.equal((res.body as { error_code: string }).error_code, "IDEMPOTENCY_CONFLICT");
+  const lots = await lotById(loyalty, "alice");
+  assert.equal(lots.get("lot-a2")!.points, 200); // nothing further consumed
+});
+
+test("redeeming more points than the customer can spend is rejected without changes", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots); // alice: 800 spendable points
+  const res = await redeem(router, "key-1", 801);
+  assert.equal(res.status, 409);
+  assert.equal((res.body as { error_code: string }).error_code, "INSUFFICIENT_POINTS");
+  const lots = await lotById(loyalty, "alice");
+  assert.equal(lots.get("lot-a1")!.points, 300);
+  assert.equal(lots.get("lot-a2")!.points, 500);
+});
+
+test("only pending orders can be redeemed; foreign orders are not found", async () => {
+  const { router } = app([pendingOrder({ status: "shipped" })], seedLots);
+  assert.equal((await redeem(router, "k", 100)).status, 409);
+  const other = app([pendingOrder()], seedLots); // o1 belongs to alice
+  assert.equal((await redeem(other.router, "k", 100, asBob)).status, 404);
+});
+
+test("redeem validates the body", async () => {
+  const { router } = app([pendingOrder()], seedLots);
+  const bad = (body: unknown) => router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asAlice, body });
+  for (const body of [undefined, {}, { points: 0, idempotencyKey: "k" }, { points: -5, idempotencyKey: "k" },
+    { points: 1.5, idempotencyKey: "k" }, { points: "100", idempotencyKey: "k" }, { points: 100 }]) {
+    const res = await bad(body);
+    assert.equal(res.status, 400, "expected 400 for " + JSON.stringify(body));
+    assert.match(String((res.body as { error_code: string }).error_code), /^[A-Z][A-Z0-9_]+$/);
+  }
+});
+
+test("redeem requires authentication", async () => {
+  const { router } = app([pendingOrder()], seedLots);
+  const res = await router.handle({ method: "POST", path: "/orders/o1/redeem", headers: {}, body: { points: 100, idempotencyKey: "k" } });
+  assert.equal(res.status, 401);
+});
+
+test("concurrent redemptions for one customer never spend the same points", async () => {
+  // Two lots of 300; two overlapping redemptions of 300 each: both must succeed
+  // on distinct draws — a lost update would leave points behind or overdraw.
+  const lots: PointsLot[] = [
+    { id: "l1", customerId: "alice", points: 300, expiresAt: new Date("2027-01-31T00:00:00Z") },
+    { id: "l2", customerId: "alice", points: 300, expiresAt: new Date("2027-02-28T00:00:00Z") },
+  ];
+  const { router, loyalty } = app([pendingOrder()], lots);
+  const [r1, r2] = await Promise.all([redeem(router, "k1", 300), redeem(router, "k2", 300)]);
+  assert.equal(r1.status, 200);
+  assert.equal(r2.status, 200);
+  const remaining = (await loyalty.lotsFor("alice")).reduce((sum, l) => sum + l.points, 0);
+  assert.equal(remaining, 0); // exactly 600 consumed, no point spent twice
+});
+
+test("overlapping redemptions cannot overspend: the second finds insufficient points", async () => {
+  const lots: PointsLot[] = [{ id: "l1", customerId: "alice", points: 500, expiresAt: new Date("2027-01-31T00:00:00Z") }];
+  const { router, loyalty } = app([pendingOrder()], lots);
+  const [r1, r2] = await Promise.all([redeem(router, "k1", 300), redeem(router, "k2", 300)]);
+  const statuses = [r1.status, r2.status].sort();
+  assert.deepEqual(statuses, [200, 409]); // exactly one redemption wins
+  const lot = (await lotById(loyalty, "alice")).get("l1")!;
+  assert.equal(lot.points, 200); // 300 consumed exactly once
+});
diff --git a/tests/orders/cancel-redeemed.acceptance.test.ts b/tests/orders/cancel-redeemed.acceptance.test.ts
new file mode 100644
index 0000000..6d64e10
--- /dev/null
+++ b/tests/orders/cancel-redeemed.acceptance.test.ts
@@ -0,0 +1,74 @@
+/**
+ * Acceptance LOY-REDEEM-002
+ * Cancelling an order that was paid partly with points returns the points to
+ * their original lots with their original expiry; points whose lot expired by
+ * reversal time are forfeited. The reversal applies exactly once.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { app, asAlice, pendingOrder } from "./helpers.ts";
+import { seedLots } from "../../src/seed.ts";
+import type { PointsLot } from "../../src/loyalty/domain/points.ts";
+
+const redeem = (router: ReturnType<typeof app>["router"], key: string, points: number) =>
+  router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asAlice, body: { points, idempotencyKey: key } });
+
+const cancel = (router: ReturnType<typeof app>["router"]) =>
+  router.handle({ method: "POST", path: "/orders/o1/cancel", headers: asAlice });
+
+const lotById = async (loyalty: ReturnType<typeof app>["loyalty"], customerId: string) =>
+  new Map((await loyalty.lotsFor(customerId)).map(l => [l.id, l]));
+
+test("cancelling a redeemed order restores points to their original lot with original expiry", async () => {
+  const { router, loyalty, orders } = app([pendingOrder()], seedLots);
+  assert.equal((await redeem(router, "key-1", 300)).status, 200); // drawn from lot-a2
+  const res = await cancel(router);
+  assert.equal(res.status, 200);
+  assert.equal(orders.get("o1")!.status, "cancelled");
+  const lots = await lotById(loyalty, "alice");
+  const a2 = lots.get("lot-a2")!;
+  assert.equal(a2.points, 500); // exactly the drawn amount, back where it came from
+  assert.equal(a2.expiresAt.getTime(), new Date("2026-12-01T00:00:00Z").getTime()); // original expiry kept
+  assert.equal(lots.get("lot-a1")!.points, 300); // untouched lots stay untouched
+});
+
+test("points whose lot expired before the cancel are forfeited; the rest are restored", async () => {
+  const lots: PointsLot[] = [
+    { id: "l1", customerId: "alice", points: 200, expiresAt: new Date("2026-12-31T00:00:00Z") },
+    { id: "l2", customerId: "alice", points: 400, expiresAt: new Date("2027-06-30T00:00:00Z") },
+  ];
+  let clock = new Date("2026-11-19T12:00:00Z");
+  const { router, loyalty } = app([pendingOrder()], lots, () => clock);
+  // Redeem 500 at 2026-11-19: draws l1 200 + l2 300, earliest expiry first.
+  assert.equal((await redeem(router, "key-1", 500)).status, 200);
+  // Cancel after l1's expiry has passed.
+  clock = new Date("2027-01-15T12:00:00Z");
+  assert.equal((await cancel(router)).status, 200);
+  const restored = await lotById(loyalty, "alice");
+  assert.equal(restored.get("l1")!.points, 0); // expired lot: 200 points forfeited
+  assert.equal(restored.get("l2")!.points, 400); // 400 − 300 drawn + 300 restored, same lot, same expiry
+});
+
+test("a redeemed order is reversed exactly once, even when two cancels race", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots);
+  assert.equal((await redeem(router, "key-1", 300)).status, 200);
+  const [c1, c2] = await Promise.all([cancel(router), cancel(router)]);
+  assert.deepEqual([c1.status, c2.status].sort(), [200, 409]); // one cancel wins
+  assert.equal((await lotById(loyalty, "alice")).get("lot-a2")!.points, 500); // restored once, not twice
+});
+
+test("several redemptions on one order are all reversed on cancel", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots);
+  assert.equal((await redeem(router, "k1", 100)).status, 200);
+  assert.equal((await redeem(router, "k2", 200)).status, 200);
+  assert.equal((await cancel(router)).status, 200);
+  assert.equal((await lotById(loyalty, "alice")).get("lot-a2")!.points, 500); // 100 + 200 fully restored
+});
+
+test("cancelling an order that was never redeemed leaves the lots untouched", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots);
+  assert.equal((await cancel(router)).status, 200);
+  const lots = await lotById(loyalty, "alice");
+  assert.equal(lots.get("lot-a1")!.points, 300);
+  assert.equal(lots.get("lot-a2")!.points, 500);
+});
