+++ b/tests/loyalty/redeem-plan.test.ts
@@ -0,0 +1,50 @@
+/**
+ * LOY-REDEEM-001 domain rules: spend planning consumes non-expired lots
+ * earliest-expiry-first (never below zero, excess not consumed), and refund
+ * planning restores points to their original lots while forfeiting points
+ * whose lot has expired.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { planRefund, planSpend } from "../../src/loyalty/domain/redeem.ts";
+import type { PointsLot } from "../../src/loyalty/domain/points.ts";
+
+const NOW = new Date("2026-11-19T12:00:00Z");
+const lot = (id: string, points: number, iso: string): PointsLot =>
+  ({ id, customerId: "c", points, expiresAt: new Date(iso) });
+
+test("planSpend consumes earliest-expiring lots first", () => {
+  const plan = planSpend([lot("late", 300, "2027-06-01T00:00:00Z"), lot("early", 300, "2026-12-01T00:00:00Z")], 400, NOW);
+  assert.deepEqual(plan.deductions, [{ lotId: "early", points: 300 }, { lotId: "late", points: 100 }]);
+  assert.equal(plan.applied, 400);
+  assert.equal(plan.available, 600);
+});
+
+test("planSpend ignores expired and empty lots and caps at the balance", () => {
+  const plan = planSpend(
+    [lot("gone", 500, "2025-06-30T00:00:00Z"), lot("empty", 0, "2027-01-01T00:00:00Z"), lot("live", 100, "2027-01-01T00:00:00Z")],
+    300,
+    NOW,
+  );
+  assert.deepEqual(plan.deductions, [{ lotId: "live", points: 100 }]);
+  assert.equal(plan.applied, 100);
+  assert.equal(plan.available, 100);
+});
+
+test("planSpend consumes nothing beyond the requested amount", () => {
+  const plan = planSpend([lot("only", 500, "2027-01-01T00:00:00Z")], 200, NOW);
+  assert.deepEqual(plan.deductions, [{ lotId: "only", points: 200 }]);
+  assert.equal(plan.applied, 200);
+});
+
+test("planRefund restores valid lots and forfeits expired ones", () => {
+  const lots = [lot("early", 0, "2026-03-01T00:00:00Z"), lot("late", 400, "2027-01-01T00:00:00Z")];
+  const at = new Date("2026-06-01T00:00:00Z"); // "early" has expired by now
+  const plan = planRefund(
+    [{ lotId: "early", points: 200 }, { lotId: "late", points: 100 }],
+    id => lots.find(l => l.id === id),
+    at,
+  );
+  assert.deepEqual(plan.restorations, [{ lotId: "late", points: 100 }]);
+  assert.equal(plan.forfeited, 200);
+});
diff --git a/tests/orders/cancel-redeemed.acceptance.test.ts b/tests/orders/cancel-redeemed.acceptance.test.ts
new file mode 100644
index 0000000..0baeceb
--- /dev/null
+++ b/tests/orders/cancel-redeemed.acceptance.test.ts
@@ -0,0 +1,99 @@
+/**
+ * Acceptance LOY-CANCEL-REDEEM-001
+ * Given a redeemed pending order
+ * When the customer cancels it
+ * Then the redeemed points return to their original lots with their original
+ * expiry, points from lots that expired in the meantime are forfeited, and a
+ * retried redeem still replays the original quote without touching the ledger.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { asAlice, pendingOrder } from "./helpers.ts";
+import { createApp } from "../../src/app.ts";
+import { InMemoryOrderStore } from "../../src/orders/integration/order-store.ts";
+import { InMemoryLoyaltyStore } from "../../src/loyalty/integration/loyalty-store.ts";
+import { InMemoryRedemptionStore } from "../../src/orders/integration/redemption-store.ts";
+import { seedTokens } from "../../src/seed.ts";
+import type { PointsLot } from "../../src/loyalty/domain/points.ts";
+
+const sessions = { lookup: (t: string) => (seedTokens[t] ? { id: seedTokens[t]! } : undefined) };
+const redeem = (router: ReturnType<typeof createApp>, key: string, points: number) =>
+  router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asAlice, body: { points, idempotencyKey: key } });
+const cancel = (router: ReturnType<typeof createApp>) =>
+  router.handle({ method: "POST", path: "/orders/o1/cancel", headers: asAlice });
+
+const restoredLots = (): PointsLot[] => [
+  { id: "lot-early", customerId: "alice", points: 300, expiresAt: new Date("2026-12-01T00:00:00Z") },
+  { id: "lot-late", customerId: "alice", points: 300, expiresAt: new Date("2027-06-01T00:00:00Z") },
+];
+
+test("LOY-CANCEL-REDEEM-001: cancelling a redeemed order restores points to their original lots", async () => {
+  const orders = new InMemoryOrderStore([pendingOrder()]);
+  const loyalty = new InMemoryLoyaltyStore(restoredLots());
+  const redemptions = new InMemoryRedemptionStore();
+  const router = createApp({ orders, loyalty, sessions, redemptions });
+
+  assert.equal((await redeem(router, "k1", 400)).status, 200); // early 300->0, late 300->200
+  assert.equal((await loyalty.getLot("lot-early"))!.points, 0);
+  const cancelled = await cancel(router);
+  assert.equal(cancelled.status, 200);
+  assert.equal(orders.get("o1")!.status, "cancelled");
+  // Both debits return to the exact lots they came from, expiry untouched.
+  assert.deepEqual(await loyalty.getLot("lot-early"), {
+    id: "lot-early", customerId: "alice", points: 300, expiresAt: new Date("2026-12-01T00:00:00Z"),
+  });
+  assert.deepEqual(await loyalty.getLot("lot-late"), {
+    id: "lot-late", customerId: "alice", points: 300, expiresAt: new Date("2027-06-01T00:00:00Z"),
+  });
+});
+
+test("LOY-CANCEL-REDEEM-001: points from lots that expired before the cancel are forfeited", async () => {
+  const lots: PointsLot[] = [
+    { id: "lot-a", customerId: "alice", points: 500, expiresAt: new Date("2026-03-01T00:00:00Z") },
+    { id: "lot-b", customerId: "alice", points: 500, expiresAt: new Date("2027-01-01T00:00:00Z") },
+  ];
+  const orders = new InMemoryOrderStore([pendingOrder()]);
+  const loyalty = new InMemoryLoyaltyStore(lots);
+  const redemptions = new InMemoryRedemptionStore();
+  // Two apps sharing the stores, with the clock advanced between redeem and cancel.
+  const inJanuary = createApp({ orders, loyalty, sessions, redemptions, now: () => new Date("2026-01-15T00:00:00Z") });
+  const inJune = createApp({ orders, loyalty, sessions, redemptions, now: () => new Date("2026-06-01T00:00:00Z") });
+
+  const res = await redeem(inJanuary, "k1", 600); // lot-a 500->0 (earliest), lot-b 500->400
+  assert.equal(res.status, 200);
+  assert.equal((await loyalty.getLot("lot-a"))!.points, 0);
+
+  assert.equal((await cancel(inJune)).status, 200);
+  // lot-b is still valid: its 100 points come back with the original expiry.
+  assert.deepEqual(await loyalty.getLot("lot-b"), {
+    id: "lot-b", customerId: "alice", points: 500, expiresAt: new Date("2027-01-01T00:00:00Z"),
+  });
+  // lot-a expired in the meantime: its 500 points are forfeited, not restored.
+  assert.equal((await loyalty.getLot("lot-a"))!.points, 0);
+});
+
+test("LOY-CANCEL-REDEEM-001: a retried redeem after the cancel replays the stored quote", async () => {
+  const orders = new InMemoryOrderStore([pendingOrder()]);
+  const loyalty = new InMemoryLoyaltyStore(restoredLots());
+  const redemptions = new InMemoryRedemptionStore();
+  const router = createApp({ orders, loyalty, sessions, redemptions });
+
+  const first = await redeem(router, "k1", 100);
+  await cancel(router);
+  const retry = await redeem(router, "k1", 100);
+  assert.equal(retry.status, 200);
+  assert.deepEqual(retry.body, first.body);
+  assert.equal((await loyalty.getLot("lot-early"))!.points, 300); // no extra consumption
+});
+
+test("LOY-CANCEL-REDEEM-001: cancelling an order without redemptions works as before", async () => {
+  const orders = new InMemoryOrderStore([pendingOrder()]);
+  const loyalty = new InMemoryLoyaltyStore(restoredLots());
+  const redemptions = new InMemoryRedemptionStore();
+  const router = createApp({ orders, loyalty, sessions, redemptions });
+
+  const cancelled = await cancel(router);
+  assert.equal(cancelled.status, 200);
+  assert.equal(orders.get("o1")!.status, "cancelled");
+  assert.equal((await loyalty.getLot("lot-early"))!.points, 300); // untouched
+});
diff --git a/tests/orders/redeem-order.acceptance.test.ts b/tests/orders/redeem-order.acceptance.test.ts
new file mode 100644
index 0000000..f551478
--- /dev/null
+++ b/tests/orders/redeem-order.acceptance.test.ts
@@ -0,0 +1,143 @@
+/**
+ * Acceptance LOY-REDEEM-001
+ * Given a pending order owned by the signed-in customer with spendable point lots
+ * When the customer sends POST /orders/:id/redeem with { points, idempotencyKey }
+ * Then points are consumed earliest-expiry-first from non-expired lots, the
+ * quote shows points applied after discount and before tax (never below zero,
+ * excess not consumed), the same key replays the same result, and concurrent
+ * redemptions of one customer never spend the same points.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { app, asAlice, asBob, pendingOrder } from "./helpers.ts";
+import type { PointsLot } from "../../src/loyalty/domain/points.ts";
+
+const redeem = (router: ReturnType<typeof app>["router"], key: string, points: number, headers = asAlice) =>
+  router.handle({ method: "POST", path: "/orders/o1/redeem", headers, body: { points, idempotencyKey: key } });
+
+/** Alice's two valid lots: "early" expires first and must be drained first. */
+const twoLots = (): PointsLot[] => [
+  { id: "lot-early", customerId: "alice", points: 300, expiresAt: new Date("2026-12-01T00:00:00Z") },
+  { id: "lot-late", customerId: "alice", points: 300, expiresAt: new Date("2027-06-01T00:00:00Z") },
+];
+
+test("LOY-REDEEM-001: redeem consumes the earliest-expiring lot first and returns the new quote", async () => {
+  const { router, loyalty } = app([pendingOrder()], twoLots()); // subtotal 10000, no discount
+  const res = await redeem(router, "k1", 250);
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, {
+    region: "DE", subtotalCents: 10000, discountCents: 0, pointsCents: 250, taxCents: 1853, totalCents: 11603,
+  });
+  assert.equal((await loyalty.getLot("lot-early"))!.points, 50); // 250 taken from the earlier expiry
+  assert.equal((await loyalty.getLot("lot-late"))!.points, 300);
+});
+
+test("LOY-REDEEM-001: a redemption spanning several lots drains them in expiry order", async () => {
+  const { router, loyalty } = app([pendingOrder()], twoLots());
+  const res = await redeem(router, "k1", 400);
+  assert.equal(res.status, 200);
+  assert.equal((res.body as { pointsCents: number }).pointsCents, 400);
+  assert.equal((await loyalty.getLot("lot-early"))!.points, 0);
+  assert.equal((await loyalty.getLot("lot-late"))!.points, 200);
+});
+
+test("LOY-REDEEM-001: expired lots are never consumed and the balance caps the redemption", async () => {
+  const lots: PointsLot[] = [
+    { id: "lot-expired", customerId: "alice", points: 1000, expiresAt: new Date("2025-06-30T00:00:00Z") },
+    { id: "lot-live", customerId: "alice", points: 100, expiresAt: new Date("2027-06-01T00:00:00Z") },
+  ];
+  const { router, loyalty } = app([pendingOrder()], lots);
+  const res = await redeem(router, "k1", 300);
+  assert.equal(res.status, 200);
+  // Only the 100 spendable points are consumed (1 point = 1 cent); the expired lot stays untouched.
+  assert.deepEqual(res.body, {
+    region: "DE", subtotalCents: 10000, discountCents: 0, pointsCents: 100, taxCents: 1881, totalCents: 11781,
+  });
+  assert.equal((await loyalty.getLot("lot-expired"))!.points, 1000);
+  assert.equal((await loyalty.getLot("lot-live"))!.points, 0);
+});
+
+test("LOY-REDEEM-001: points never push the amount below zero and excess points are not consumed", async () => {
+  // subtotal 2000, FLAT5 discount 500 -> 1500 due after discount, before tax
+  const order = pendingOrder({ discountCode: "FLAT5", lines: [{ sku: "mug", unitPriceCents: 2000, quantity: 1 }] });
+  const lots: PointsLot[] = [
+    { id: "lot-big", customerId: "alice", points: 2000, expiresAt: new Date("2027-06-01T00:00:00Z") },
+  ];
+  const { router, loyalty } = app([order], lots);
+  const res = await redeem(router, "k1", 2000);
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, {
+    region: "DE", subtotalCents: 2000, discountCents: 500, pointsCents: 1500, taxCents: 0, totalCents: 0,
+  });
+  assert.equal((await loyalty.getLot("lot-big"))!.points, 500); // only 1500 of the 2000 requested
+});
+
+test("LOY-REDEEM-001: the same key replays the same result and consumes nothing more", async () => {
+  const { router, loyalty } = app([pendingOrder()], twoLots());
+  const first = await redeem(router, "k1", 100);
+  const second = await redeem(router, "k1", 100);
+  assert.equal(second.status, 200);
+  assert.deepEqual(second.body, first.body);
+  assert.equal((await loyalty.getLot("lot-early"))!.points, 200); // consumed exactly once
+});
+
+test("LOY-REDEEM-001: the same key with a different body is rejected", async () => {
+  const { router, loyalty } = app([pendingOrder()], twoLots());
+  assert.equal((await redeem(router, "k1", 100)).status, 200);
+  const clash = await redeem(router, "k1", 500);
+  assert.equal(clash.status, 409);
+  assert.equal((await loyalty.getLot("lot-early"))!.points, 200); // nothing further consumed
+});
+
+test("LOY-REDEEM-001: another customer's order is not found", async () => {
+  const { router } = app([pendingOrder()], twoLots());
+  const res = await redeem(router, "k1", 100, asBob);
+  assert.equal(res.status, 404);
+});
+
+test("LOY-REDEEM-001: only pending orders can be redeemed", async () => {
+  const { router } = app([pendingOrder({ status: "shipped" })], twoLots());
+  const res = await redeem(router, "k1", 100);
+  assert.equal(res.status, 409);
+});
+
+test("LOY-REDEEM-001: invalid bodies are rejected with 400", async () => {
+  const { router } = app([pendingOrder()], twoLots());
+  for (const body of [
+    { points: 0, idempotencyKey: "k" },
+    { points: 2.5, idempotencyKey: "k" },
+    { points: "5", idempotencyKey: "k" },
+    { points: 5 },
+    { points: 5, idempotencyKey: "" },
+  ]) {
+    const res = await router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asAlice, body });
+    assert.equal(res.status, 400, `expected 400 for ${JSON.stringify(body)}`);
+  }
+});
+
+test("LOY-REDEEM-001: concurrent redemptions never spend the same points", async () => {
+  const lots: PointsLot[] = [
+    { id: "lot-x", customerId: "alice", points: 300, expiresAt: new Date("2027-06-01T00:00:00Z") },
+  ];
+  const { router, loyalty } = app([pendingOrder()], lots);
+  const [r1, r2] = await Promise.all([redeem(router, "k-a", 200), redeem(router, "k-b", 200)]);
+  assert.equal(r1.status, 200);
+  assert.equal(r2.status, 200);
+  // The balance is 300: whichever request lands first takes 200, the other only 100.
+  const applied = [(r1.body as { pointsCents: number }).pointsCents, (r2.body as { pointsCents: number }).pointsCents]
+    .sort((a, b) => b - a);
+  assert.deepEqual(applied, [200, 100]);
+  assert.equal((await loyalty.getLot("lot-x"))!.points, 0); // no double spend
+});
+
+test("LOY-REDEEM-001: a concurrent double-submit with the same key is applied once", async () => {
+  const lots: PointsLot[] = [
+    { id: "lot-x", customerId: "alice", points: 300, expiresAt: new Date("2027-06-01T00:00:00Z") },
+  ];
+  const { router, loyalty } = app([pendingOrder()], lots);
+  const [r1, r2] = await Promise.all([redeem(router, "dup", 100), redeem(router, "dup", 100)]);
+  assert.equal(r1.status, 200);
+  assert.equal(r2.status, 200);
+  assert.deepEqual(r2.body, r1.body);
+  assert.equal((await loyalty.getLot("lot-x"))!.points, 200); // exactly one consumption of 100
+});
