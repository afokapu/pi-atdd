index 0000000..70f9e1e
--- /dev/null
+++ b/src/loyalty/application/ledger.ts
@@ -0,0 +1,48 @@
+import { allocate, availablePoints, refund, type LotAllocation, type PointsLot } from "../domain/points.ts";
+import type { InMemoryLoyaltyStore } from "../integration/loyalty-store.ts";
+
+/** Write lots one by one; if a write fails, put back the lots already written (best effort). */
+async function saveAll(store: InMemoryLoyaltyStore, before: PointsLot[], after: PointsLot[]): Promise<void> {
+  const done: PointsLot[] = [];
+  try {
+    for (const lot of after) { await store.saveLot(lot); done.push(lot); }
+  } catch (e) {
+    for (const lot of done) {
+      const original = before.find(b => b.id === lot.id);
+      if (original) await store.saveLot(original).catch(() => undefined);
+    }
+    throw e;
+  }
+}
+
+/**
+ * Loyalty ledger use cases. Callers must serialise calls per customer
+ * (read-modify-write over an asynchronous store).
+ */
+export class Ledger {
+  private store: InMemoryLoyaltyStore;
+  constructor(store: InMemoryLoyaltyStore) { this.store = store; }
+
+  async balance(customerId: string, at: Date): Promise<number> {
+    return availablePoints(await this.store.lotsFor(customerId), at);
+  }
+
+  /** Consume `points` from the customer's lots, earliest expiry first. */
+  async spend(customerId: string, points: number, at: Date): Promise<LotAllocation[]> {
+    if (points === 0) return [];
+    const lots = await this.store.lotsFor(customerId);
+    const { allocations, updated } = allocate(lots, points, at);
+    await saveAll(this.store, lots, updated);
+    return allocations;
+  }
+
+  /** Return points to their original lots; points of lots expired at `at` are forfeited. */
+  async giveBack(customerId: string, allocations: LotAllocation[], at: Date): Promise<{ returned: number; forfeited: number }> {
+    if (allocations.length === 0) return { returned: 0, forfeited: 0 };
+    const lots = await this.store.lotsFor(customerId);
+    const { updated, forfeited } = refund(new Map(lots.map(l => [l.id, l])), allocations, at);
+    await saveAll(this.store, lots, updated);
+    const total = allocations.reduce((s, a) => s + a.points, 0);
+    return { returned: total - forfeited, forfeited };
+  }
+}
diff --git a/src/loyalty/domain/points.ts b/src/loyalty/domain/points.ts
index ed40d38..63162ad 100644
--- a/src/loyalty/domain/points.ts
+++ b/src/loyalty/domain/points.ts
@@ -18,3 +18,60 @@ export function basePoints(subtotalCents: number): number {
 export function isExpired(lot: PointsLot, at: Date): boolean {
   return lot.expiresAt.getTime() <= at.getTime();
 }
+
+/** Points taken from (or returned to) one lot. */
+export type LotAllocation = { lotId: string; points: number };
+
+/** 1 point = 1 cent (100 points = 1 EUR). */
+export function pointsToCents(points: number): number {
+  return points;
+}
+
+/** Spendable balance at `at`: sum of non-expired lots. */
+export function availablePoints(lots: PointsLot[], at: Date): number {
+  return lots.filter(l => !isExpired(l, at)).reduce((s, l) => s + l.points, 0);
+}
+
+export class InsufficientPointsError extends Error {}
+
+/**
+ * Plan consuming `points` from non-expired lots, earliest expiry first
+ * (ties keep the given order). Pure: returns the allocations and updated lots.
+ */
+export function allocate(lots: PointsLot[], points: number, at: Date): { allocations: LotAllocation[]; updated: PointsLot[] } {
+  if (!Number.isInteger(points) || points < 0) throw new RangeError("points must be a non-negative integer");
+  const usable = lots
+    .map((l, i) => ({ l, i }))
+    .filter(({ l }) => !isExpired(l, at) && l.points > 0)
+    .sort((a, b) => a.l.expiresAt.getTime() - b.l.expiresAt.getTime() || a.i - b.i)
+    .map(({ l }) => l);
+  if (usable.reduce((s, l) => s + l.points, 0) < points)
+    throw new InsufficientPointsError("insufficient points: " + points + " requested");
+  const allocations: LotAllocation[] = [];
+  const updated: PointsLot[] = [];
+  let left = points;
+  for (const lot of usable) {
+    if (left === 0) break;
+    const take = Math.min(left, lot.points);
+    allocations.push({ lotId: lot.id, points: take });
+    updated.push({ ...lot, points: lot.points - take });
+    left -= take;
+  }
+  return { allocations, updated };
+}
+
+/**
+ * Plan returning allocations to their original lots. Points whose lot has
+ * expired at `at` (or no longer exists) are forfeited.
+ */
+export function refund(lots: Map<string, PointsLot>, allocations: LotAllocation[], at: Date):
+  { updated: PointsLot[]; forfeited: number } {
+  const next = new Map<string, PointsLot>();
+  let forfeited = 0;
+  for (const a of allocations) {
+    const lot = next.get(a.lotId) ?? lots.get(a.lotId);
+    if (!lot || isExpired(lot, at)) { forfeited += a.points; continue; }
+    next.set(lot.id, { ...lot, points: lot.points + a.points });
+  }
+  return { updated: [...next.values()], forfeited };
+}
