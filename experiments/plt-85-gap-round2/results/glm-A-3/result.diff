+test("LOY-REDEEM-001: concurrent redemptions of one customer never spend the same points", async () => {
+  const { router, loyalty } = app([pendingOrder({ discountCode: "SAVE10" })], seedLots);
+  const [r1, r2] = await Promise.all([
