--- a/src/pricing/domain/quote.ts
+++ b/src/pricing/domain/quote.ts
@@ -19,3 +19,24 @@ export function quote(lines: Line[], region: string, taxRate: number, discountCo
   const taxCents = taxOn(subtotalCents - discount, taxRate);
   return { region, subtotalCents, discountCents: discount, taxCents, totalCents: subtotalCents - discount + taxCents };
 }
+
+export type QuoteWithPoints = Quote & { /** Points applied to this quote, in cents (100 points = 1 EUR). */ pointsCents: number };
+
+/**
+ * Price a cart with loyalty points: points reduce the amount after the
+ * discount and before tax, never below zero. Points beyond the discounted
+ * amount are not consumed (reported applied is capped, in cents).
+ */
+export function quoteWithPoints(
+  lines: Line[], region: string, taxRate: number, discountCode: string | undefined, pointsCents: number,
+): QuoteWithPoints {
+  const subtotalCents = subtotal(lines);
+  const discount = discountCents(subtotalCents, discountCode);
+  const taxableCents = subtotalCents - discount;
+  const appliedCents = Math.max(0, Math.min(pointsCents, taxableCents));
+  const taxCents = taxOn(taxableCents - appliedCents, taxRate);
+  return {
+    region, subtotalCents, discountCents: discount, pointsCents: appliedCents,
+    taxCents, totalCents: taxableCents - appliedCents + taxCents,
+  };
+}
