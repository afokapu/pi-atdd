+/**
+ * Domain rule: mark an order as shipped.
+ * SHP-001: cancelled orders cannot be shipped; the input order is left unchanged.
+ */
 export function shipOrder(order: Order): ShippedOrder {
+  if (order.status === "cancelled") {
+    throw new OrderStateError("order " + order.id + " is cancelled and cannot be shipped");
+  }
