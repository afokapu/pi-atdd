+      }
+      const applied = allocations.reduce((sum, item) => sum + item.points, 0);
+      this.redemptions.set(customerId + ":" + key, { customerId, orderId, pointsRequested: requested,
+        pointsApplied: applied, allocations, active: true });
+      return { kind: "created", pointsApplied: applied };
+    });
+  }
