+  /** Atomically consumes the customer's earliest-expiring usable lots. */
+  async redeem(customerId: string, orderId: string, key: string, requested: number, maximum: number, at: Date): Promise<RedemptionResult> {
+    return this.serialized(async () => {
+      await pause();
