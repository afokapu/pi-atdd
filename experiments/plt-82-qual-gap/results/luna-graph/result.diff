+
+/** Applies points after discount and before tax, with cents as the shared unit. */
+export function quoteWithPoints(lines: Line[], region: string, taxRate: number, points: number, discountCode?: string): RedeemedQuote {
+  const base = quote(lines, region, taxRate, discountCode);
+  const taxableCents = Math.max(0, base.subtotalCents - base.discountCents - points);
+  const taxCents = taxOn(taxableCents, taxRate);
+  return { ...base, pointsAppliedCents: points, taxCents, totalCents: taxableCents + taxCents };
+}
