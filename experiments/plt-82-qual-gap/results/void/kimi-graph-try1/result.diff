@@ -0,0 +1,35 @@
+/**
+ * Loyalty redemption domain: how points are taken from lots and later
+ * unwound. Invariant: 100 points = 1 EUR, so one point is always worth
+ * exactly one cent and all point arithmetic stays in integer cents.
+ */
+import { isExpired, type PointsLot } from "./points.ts";
+
+/** Points taken from a single lot as part of one redemption. */
+export type Allocation = { lotId: string; points: number };
+
+/**
+ * Spend plan for `wanted` points: walk the customer's non-expired lots
+ * earliest expiry first (FEFO) and take from each until the want is
+ * covered. A partial plan is returned when the ledger holds fewer usable
+ * points than wanted; the caller reports what was actually committed.
+ */
+export function allocatePoints(lots: PointsLot[], wanted: number, at: Date): Allocation[] {
+  const usable = lots
+    .filter(l => l.points > 0 && !isExpired(l, at))
+    .sort((a, b) => a.expiresAt.getTime() - b.expiresAt.getTime());
+  const plan: Allocation[] = [];
+  let remaining = Math.max(0, wanted);
+  for (const lot of usable) {
+    if (remaining === 0) break;
+    const take = Math.min(lot.points, remaining);
+    plan.push({ lotId: lot.id, points: take });
+    remaining -= take;
+  }
+  return plan;
+}
+
+/** Total points committed by a spend plan (== its value in cents). */
+export function planTotal(plan: Allocation[]): number {
+  return plan.reduce((sum, a) => sum + a.points, 0);
+}
diff --git a/src/loyalty/integration/redemption-store.ts b/src/loyalty/integration/redemption-store.ts
new file mode 100644
index 0000000..1815ed5
--- /dev/null
+++ b/src/loyalty/integration/redemption-store.ts
@@ -0,0 +1,61 @@
+import type { Allocation } from "../domain/redemption.ts";
+import type { RedeemedQuote } from "../../pricing/domain/quote.ts";
+
+/** Simulated I/O latency: every call yields to the event loop before touching data. */
+const io = () => new Promise<void>(resolve => setTimeout(resolve, 1));
+
+/**
+ * One points redemption, kept as the idempotency record: replaying the
+ * same key returns the stored quote and never spends again. `reversed`
+ * marks a redemption already returned to its lots by an order cancel.
+ */
+export type Redemption = {
+  customerId: string;
+  key: string;
+  orderId: string;
+  /** Points as requested in the body (drives the same-key/different-body check). */
+  requestedPoints: number;
+  /** Points actually consumed (capped at the amount still due). */
+  points: number;
+  /** Per-lot consumption, needed to unwind the redemption on cancel. */
+  allocations: Allocation[];
+  /** Quote as first returned; replays must yield exactly this result. */
+  quote: RedeemedQuote;
+  reversed: boolean;
+  createdAt: Date;
+};
+
+/**
+ * Adapter over the idempotency/redemption database (in memory here).
+ * Keys are scoped per customer; like the real client, all calls are async.
+ */
+export class InMemoryRedemptionStore {
+  private records = new Map<string, Redemption>();
+
+  constructor(seed: Redemption[] = []) { for (const r of seed) this.records.set(this.id(r.customerId, r.key), r); }
+
+  private id(customerId: string, key: string): string { return customerId + "|" + key; }
+
+  async find(customerId: string, key: string): Promise<Redemption | undefined> {
+    await io();
+    const r = this.records.get(this.id(customerId, key));
+    return r && { ...r, allocations: r.allocations.map(a => ({ ...a })) };
+  }
+
+  /** Unreversed redemptions of an order, in creation order. */
+  async forOrder(orderId: string): Promise<Redemption[]> {
+    await io();
+    return [...this.records.values()]
+      .filter(r => r.orderId === orderId && !r.reversed)
+      .map(r => ({ ...r, allocations: r.allocations.map(a => ({ ...a })) }));
+  }
+
+  /** Insert or replace a record (reversal flips `reversed`). */
+  async save(record: Redemption): Promise<void> {
+    await io();
+    this.records.set(this.id(record.customerId, record.key), {
+      ...record,
+      allocations: record.allocations.map(a => ({ ...a })),
+    });
+  }
+}
