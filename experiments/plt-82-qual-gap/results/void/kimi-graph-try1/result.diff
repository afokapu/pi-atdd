+/**
+ * Price a cart with loyalty points: subtotal, then discount, then points
+ * (after discount, before tax). `pointsCents` is capped at the discounted
+ * amount so the taxable base never goes below zero; the applied cap is
+ * reported back as pointsAppliedCents.
+ */
+export function quoteRedeemed(lines: Line[], region: string, taxRate: number, pointsCents: number, discountCode?: string): RedeemedQuote {
+  const subtotalCents = subtotal(lines);
+  const discount = discountCents(subtotalCents, discountCode);
+  const applied = Math.min(Math.max(0, pointsCents), subtotalCents - discount);
+  const taxable = subtotalCents - discount - applied;
+  const taxCents = taxOn(taxable, taxRate);
+  return { region, subtotalCents, discountCents: discount, pointsAppliedCents: applied, taxCents, totalCents: taxable + taxCents };
+}
