--- /dev/null
+++ b/src/loyalty/application/redeem-service.ts
@@ -0,0 +1,115 @@
+/**
+ * Use case LOY-002: pay (part of) a pending order with loyalty points.
+ *
+ * Points are consumed from non-expired lots earliest-expiry-first and
+ * reduce the amount due after discounts, before tax. Redemptions are
+ * idempotent per (customer, key) and unwind on order cancellation.
+ *
+ * Concurrency: the ledger store is asynchronous, so every execution for
+ * one customer is serialised through a per-customer promise chain — two
+ * overlapping redemptions (or a redeem racing a cancel) can never read
+ * the same lot balances twice.
+ */
+import { quoteRedeemed, type RedeemedQuote } from "../../pricing/domain/quote.ts";
+import { getTaxRate } from "../../pricing/integration/tax-rates.ts";
+import { allocatePoints, planTotal, type Allocation } from "../domain/redemption.ts";
+import { isExpired } from "../domain/points.ts";
+import type { InMemoryLoyaltyStore } from "../integration/loyalty-store.ts";
+import type { InMemoryRedemptionStore, Redemption } from "../integration/redemption-store.ts";
+import type { InMemoryOrderStore } from "../../orders/integration/order-store.ts";
+import type { Order } from "../../orders/domain/order.ts";
+
+export type RedeemResult =
+  | { kind: "ok"; quote: RedeemedQuote }
+  | { kind: "replay"; quote: RedeemedQuote }
+  | { kind: "key_conflict" }
+  | { kind: "not_found" }
+  | { kind: "not_pending"; status: string };
+
+export type RedeemCommand = { orderId: string; customerId: string; points: number; key: string };
+
+export type RedeemServiceDeps = {
+  orders: InMemoryOrderStore;
+  lots: InMemoryLoyaltyStore;
+  redemptions: InMemoryRedemptionStore;
+  now: () => Date;
+};
+
+export class RedeemService {
+  /** Tail of the serialised execution chain, one entry per customer. */
+  private tails = new Map<string, Promise<void>>();
+
+  constructor(private deps: RedeemServiceDeps) {}
+
+  redeem(cmd: RedeemCommand): Promise<RedeemResult> {
+    return this.serialised(cmd.customerId, () => this.doRedeem(cmd));
+  }
+
+  /** Unwind every unreversed redemption of the order back into its lots. */
+  reverseForOrder(customerId: string, orderId: string): Promise<void> {
+    return this.serialised(customerId, () => this.doReverse(orderId));
+  }
+
+  /** Run `fn` strictly after all earlier executions for this customer. */
+  private async serialised<T>(customerId: string, fn: () => Promise<T>): Promise<T> {
+    const prev = this.tails.get(customerId) ?? Promise.resolve();
+    const run = prev.catch(() => undefined).then(fn);
+    this.tails.set(customerId, run.then(() => undefined, () => undefined));
+    return run;
+  }
+
+  private async doRedeem(cmd: RedeemCommand): Promise<RedeemResult> {
+    // Idempotency first: a replay must answer even if the order moved on.
+    const seen = await this.deps.redemptions.find(cmd.customerId, cmd.key);
+    if (seen) return this.replay(seen, cmd);
+    const order = this.deps.orders.get(cmd.orderId);
+    if (!order || order.customerId !== cmd.customerId) return { kind: "not_found" };
+    if (order.status !== "pending") return { kind: "not_pending", status: order.status };
+    const plan = await this.spend(cmd, order);
+    const quote = quoteRedeemed(order.lines, order.region, getTaxRate(order.region), planTotal(plan), order.discountCode);
+    await this.deps.redemptions.save({
+      customerId: cmd.customerId, key: cmd.key, orderId: cmd.orderId,
+      requestedPoints: cmd.points, points: planTotal(plan), allocations: plan,
+      quote, reversed: false, createdAt: this.deps.now(),
+    });
+    return { kind: "ok", quote };
+  }
+
+  /**
+   * Consume points for the command: capped at the amount still due after
+   * discounts (1 point = 1 cent), taken from non-expired lots FEFO. Any
+   * excess requested points are simply never consumed.
+   */
+  private async spend(cmd: RedeemCommand, order: Order): Promise<Allocation[]> {
+    const base = quoteRedeemed(order.lines, order.region, getTaxRate(order.region), 0, order.discountCode);
+    const wanted = Math.min(cmd.points, base.subtotalCents - base.discountCents);
+    const plan = allocatePoints(await this.deps.lots.lotsFor(cmd.customerId), wanted, this.deps.now());
+    for (const a of plan) {
+      const lot = (await this.deps.lots.getLot(a.lotId))!;
+      await this.deps.lots.saveLot({ ...lot, points: lot.points - a.points });
+    }
+    return plan;
+  }
+
+  /** Same key + same body replays the stored result; a different body is rejected. */
+  private replay(seen: Redemption, cmd: RedeemCommand): RedeemResult {
+    if (seen.orderId !== cmd.orderId || seen.requestedPoints !== cmd.points) return { kind: "key_conflict" };
+    return { kind: "replay", quote: seen.quote };
+  }
+
+  /**
+   * Unwind a cancelled order's redemptions: each allocation returns to
+   * its original lot (original expiry preserved by construction); lots
+   * that expired between redemption and cancellation forfeit their points.
+   */
+  private async doReverse(orderId: string): Promise<void> {
+    const at = this.deps.now();
+    for (const r of await this.deps.redemptions.forOrder(orderId)) {
+      for (const a of r.allocations) {
+        const lot = await this.deps.lots.getLot(a.lotId);
+        if (lot && !isExpired(lot, at)) await this.deps.lots.saveLot({ ...lot, points: lot.points + a.points });
+      }
+      await this.deps.redemptions.save({ ...r, reversed: true });
+    }
+  }
+}
