@@ -0,0 +1,106 @@
+import { planConsumption, restorablePoints, type Consumption } from "../domain/redemption.ts";
+import type { InMemoryLoyaltyStore } from "../integration/loyalty-store.ts";
+import type { Order } from "../../orders/domain/order.ts";
+import { discountCents } from "../../pricing/domain/discount.ts";
+import { subtotal, taxOn } from "../../pricing/domain/quote.ts";
+import { getTaxRate } from "../../pricing/integration/tax-rates.ts";
+
+/** Customer-facing quote after points are applied (all amounts in cents). */
+export type PointsQuote = {
+  subtotalCents: number;
+  discountCents: number;
+  pointsAppliedCents: number;
+  taxCents: number;
+  totalCents: number;
+};
+
+export class IdempotencyConflictError extends Error {}
+
+export type RedeemResult = { quote: PointsQuote; redemptions: Consumption[] };
+
+/**
+ * Use case: pay (part of) an order with loyalty points.
+ *
+ * The ledger store is asynchronous, so concurrent operations for one customer
+ * are serialized on a per-customer queue: two concurrent redemptions can never
+ * spend the same points. Idempotency keys make retries safe — a replayed key
+ * returns the stored result without consuming anything more; reusing a key
+ * with a different payload is rejected.
+ */
+export class RedemptionService {
+  private queues = new Map<string, Promise<unknown>>();
+  private idempotent = new Map<string, { body: string; result: RedeemResult }>();
+
+  private readonly loyalty: InMemoryLoyaltyStore;
+  private readonly now: () => Date;
+
+  constructor(loyalty: InMemoryLoyaltyStore, now: () => Date = () => new Date()) {
+    this.loyalty = loyalty;
+    this.now = now;
+  }
+
+  redeem(order: Order, points: number, idempotencyKey: string): Promise<RedeemResult> {
+    return this.serialized(order.customerId, () => this.redeemOnce(order, points, idempotencyKey));
+  }
+
+  private async redeemOnce(order: Order, points: number, idempotencyKey: string): Promise<RedeemResult> {
+    const idemId = order.customerId + ":" + idempotencyKey;
+    const body = JSON.stringify({ orderId: order.id, points });
+    const seen = this.idempotent.get(idemId);
+    if (seen) {
+      if (seen.body !== body) throw new IdempotencyConflictError("idempotency key already used with a different payload");
+      return { quote: seen.result.quote, redemptions: [] }; // replay: same result, nothing more consumed
+    }
+
+    const lots = await this.loyalty.lotsFor(order.customerId);
+    const subtotalCents = subtotal(order.lines);
+    const discount = discountCents(subtotalCents, order.discountCode);
+    // Points apply after discounts and before tax, never below zero.
+    const plan = planConsumption(lots, points, this.now(), subtotalCents - discount);
+    for (const c of plan.consumptions) {
+      const lot = await this.loyalty.getLot(c.lotId);
+      if (!lot) throw new Error("lot " + c.lotId + " vanished during redemption");
+      await this.loyalty.saveLot({ ...lot, points: lot.points - c.points });
+    }
+    const taxable = subtotalCents - discount - plan.pointsApplied;
+    const taxCents = taxOn(taxable, getTaxRate(order.region));
+    const quote: PointsQuote = {
+      subtotalCents,
+      discountCents: discount,
+      pointsAppliedCents: plan.pointsApplied,
+      taxCents,
+      totalCents: taxable + taxCents,
+    };
+    const result: RedeemResult = { quote, redemptions: plan.consumptions };
+    this.idempotent.set(idemId, { body, result });
+    return result;
+  }
+
+  /** Return the points redeemed on an order to their original lots (LOY-002 cancellation rule). */
+  restoreFor(order: Order): Promise<void> {
+    const redemptions = order.redemptions ?? [];
+    if (redemptions.length === 0) return Promise.resolve();
+    return this.serialized(order.customerId, async () => {
+      for (const r of redemptions) {
+        const lot = await this.loyalty.getLot(r.lotId);
+        const restore = restorablePoints(lot, r.points, this.now());
+        if (restore > 0) await this.loyalty.saveLot({ ...lot!, points: lot!.points + restore });
+        // Lot expired (or is gone) by cancellation time: points are forfeited.
+      }
+    });
+  }
+
+  /** Serialize asynchronous ledger operations per customer (a simple mutex). */
+  private async serialized<T>(customerId: string, fn: () => Promise<T>): Promise<T> {
+    const prev = this.queues.get(customerId) ?? Promise.resolve();
+    let release!: () => void;
+    const gate = new Promise<void>(resolve => (release = resolve));
+    this.queues.set(customerId, prev.then(() => gate));
+    await prev;
+    try {
+      return await fn();
+    } finally {
+      release();
+    }
+  }
+}
