@@ -0,0 +1,39 @@
+import { isExpired, type PointsLot } from "./points.ts";
+
+/** Points taken from a single lot. */
+export type Consumption = { lotId: string; points: number };
+
+export type RedemptionPlan = { consumptions: Consumption[]; pointsApplied: number };
+
+/**
+ * Plan a redemption: which lots to consume and how many points are applied.
+ * Only non-expired lots are usable, consumed earliest expiry first (FEFO).
+ * 1 point = 1 cent (100 points = 1 EUR), so applied points never exceed
+ * `maxCents` (the amount still payable after discounts). Points beyond what
+ * the lots hold, or beyond `maxCents`, are not consumed.
+ */
+export function planConsumption(lots: PointsLot[], pointsRequested: number, at: Date, maxCents: number): RedemptionPlan {
+  const usable = lots
+    .filter(l => l.points > 0 && !isExpired(l, at))
+    .sort((a, b) => a.expiresAt.getTime() - b.expiresAt.getTime());
+  const target = Math.min(pointsRequested, Math.max(0, maxCents));
+  let remaining = target;
+  const consumptions: Consumption[] = [];
+  for (const lot of usable) {
+    if (remaining <= 0) break;
+    const take = Math.min(lot.points, remaining);
+    if (take > 0) consumptions.push({ lotId: lot.id, points: take });
+    remaining -= take;
+  }
+  return { consumptions, pointsApplied: target - remaining };
+}
+
+/**
+ * Domain rule for cancellations: points are restored to a lot only if the lot
+ * still exists and has not expired by `at` (its expiry is unchanged, so the
+ * original expiry is kept). Otherwise the points are forfeited. Returns the
+ * number of points restored.
+ */
+export function restorablePoints(lot: PointsLot | undefined, points: number, at: Date): number {
+  return lot !== undefined && !isExpired(lot, at) ? points : 0;
+}
