diff --git a/tests/loyalty/redeem.acceptance.test.ts b/tests/loyalty/redeem.acceptance.test.ts
new file mode 100644
index 0000000..2c48d2b
--- /dev/null
+++ b/tests/loyalty/redeem.acceptance.test.ts
@@ -0,0 +1,129 @@
+/**
+ * Acceptance LOY-002 — pay with loyalty points.
+ * POST /orders/:id/redeem, body { points, idempotencyKey }.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { app, asAlice, asBob, pendingOrder } from "../orders/helpers.ts";
+import { seedLots } from "../../src/seed.ts";
+import type { PointsLot } from "../../src/loyalty/domain/points.ts";
+
+const T0 = "2026-11-19T12:00:00Z"; // lot-a3 (2025-06-30) is expired, lot-a2 expires 2026-12-01, lot-a1 2026-12-31
+
+const redeem = (points: number, idempotencyKey: string, path = "/orders/o1/redeem") =>
+  ({ method: "POST" as const, path, headers: asAlice, body: { points, idempotencyKey } });
+
+// o1-like order: subtotal 10000, SAVE10 → discount 1000, discounted 9000, DE tax 19%
+const order = pendingOrder({ discountCode: "SAVE10" });
+
+test("LOY-002: points reduce the amount after discounts and before tax", async () => {
+  const { router, loyalty } = app([order], seedLots);
+  const res = await router.handle(redeem(300, "r1"));
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, { subtotalCents: 10000, discountCents: 1000, pointsAppliedCents: 300, taxCents: 1653, totalCents: 10353 });
+  // earliest-expiring non-expired lot (lot-a2) is consumed first; expired lot-a3 untouched
+  assert.equal((await loyalty.getLot("lot-a2"))!.points, 200);
+  assert.equal((await loyalty.getLot("lot-a1"))!.points, 300);
+  assert.equal((await loyalty.getLot("lot-a3"))!.points, 1000);
+});
+
+test("LOY-002: excess points are not consumed; amount never below zero", async () => {
+  const { router, loyalty } = app([order], seedLots);
+  const res = await router.handle(redeem(50_000, "r1"));
+  assert.equal(res.status, 200);
+  // capped at the discounted subtotal (9000) and at the 800 non-expired points alice holds
+  assert.deepEqual(res.body, {
+    subtotalCents: 10000, discountCents: 1000, pointsAppliedCents: 800,
+    taxCents: Math.round(8200 * 0.19), totalCents: 8200 + Math.round(8200 * 0.19),
+  });
+  assert.equal((await loyalty.getLot("lot-a1"))!.points, 0);
+  assert.equal((await loyalty.getLot("lot-a2"))!.points, 0);
+});
+
+test("LOY-002: same idempotency key replays the result without consuming more", async () => {
+  const { router, loyalty } = app([order], seedLots);
+  const first = await router.handle(redeem(400, "r1"));
+  const replay = await router.handle(redeem(400, "r1"));
+  assert.equal(replay.status, 200);
+  assert.deepEqual(replay.body, first.body);
+  assert.equal((await loyalty.getLot("lot-a2"))!.points, 100); // 400 consumed once
+});
+
+test("LOY-002: same key with a different body is rejected", async () => {
+  const { router, loyalty } = app([order], seedLots);
+  await router.handle(redeem(400, "r1"));
+  const res = await router.handle(redeem(500, "r1"));
+  assert.equal(res.status, 409);
+  assert.equal((await loyalty.getLot("lot-a2"))!.points, 100); // nothing more consumed
+});
+
+test("LOY-002: concurrent redemptions never spend the same points", async () => {
+  const { router, loyalty } = app([order], seedLots);
+  const results = await Promise.all([
+    router.handle(redeem(500, "a")),
+    router.handle(redeem(500, "b")),
+    router.handle(redeem(500, "c")),
+  ]);
+  assert.deepEqual(results.map(r => r.status), [200, 200, 200]);
+  const applied = results.map(r => (r.body as { pointsAppliedCents: number }).pointsAppliedCents);
+  assert.deepEqual(applied.reduce((a, b) => a + b, 0), 800); // alice only has 800 usable points
+  const lots = await loyalty.lotsFor("alice");
+  assert.ok(lots.every(l => l.points >= 0));
+  assert.equal(lots.filter(l => l.id !== "lot-a3").reduce((s, l) => s + l.points, 0), 0);
+});
+
+test("LOY-002: cancelling a redeemed order restores points to their original lots", async () => {
+  const { router, loyalty } = app([order], seedLots);
+  await router.handle(redeem(600, "r1"));
+  assert.equal((await loyalty.getLot("lot-a2"))!.points, 0);
+  assert.equal((await loyalty.getLot("lot-a1"))!.points, 200);
+  const res = await router.handle({ method: "POST", path: "/orders/o1/cancel", headers: asAlice });
+  assert.equal(res.status, 200);
+  const a2 = await loyalty.getLot("lot-a2");
+  const a1 = await loyalty.getLot("lot-a1");
+  assert.equal(a2!.points, 500);
+  assert.equal(a2!.expiresAt.getTime(), new Date("2026-12-01T00:00:00Z").getTime()); // original expiry kept
+  assert.equal(a1!.points, 300);
+});
+
+test("LOY-002: points on lots expired by cancellation time are forfeited", async () => {
+  let now = new Date(T0);
+  const { router, loyalty } = app([order], seedLots, () => now);
+  await router.handle(redeem(600, "r1")); // consumes lot-a2 (500) + lot-a1 (100)
+  now = new Date("2026-12-02T00:00:00Z"); // lot-a2 has expired by now, lot-a1 has not
+  const res = await router.handle({ method: "POST", path: "/orders/o1/cancel", headers: asAlice });
+  assert.equal(res.status, 200);
+  assert.equal((await loyalty.getLot("lot-a2"))!.points, 0); // forfeited
+  assert.equal((await loyalty.getLot("lot-a1"))!.points, 300); // restored
+});
+
+test("LOY-002: only the owner of a pending order can redeem", async () => {
+  const { router } = app([order], seedLots);
+  assert.equal((await router.handle({ ...redeem(100, "r1"), headers: asBob })).status, 404);
+  assert.equal((await router.handle({ ...redeem(100, "r1"), headers: {} })).status, 401);
+  assert.equal((await router.handle({ ...redeem(100, "r1"), path: "/orders/o9/redeem" })).status, 404);
+  const { router: r2 } = app([pendingOrder({ status: "shipped" })], seedLots);
+  assert.equal((await r2.handle(redeem(100, "r1"))).status, 409);
+  const { router: r3 } = app([pendingOrder({ status: "cancelled" })], seedLots);
+  assert.equal((await r3.handle(redeem(100, "r1"))).status, 409);
+});
+
+test("LOY-002: invalid body is rejected", async () => {
+  const { router, loyalty } = app([order], seedLots);
+  for (const body of [{ points: "300", idempotencyKey: "r1" }, { points: -5, idempotencyKey: "r1" },
+    { points: 300 }, { idempotencyKey: "r1" }, { points: 300, idempotencyKey: "" }]) {
+    const res = await router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asAlice, body });
+    assert.equal(res.status, 400, JSON.stringify(body));
+  }
+  assert.equal((await loyalty.getLot("lot-a2"))!.points, 500); // nothing consumed
+});
+
+test("LOY-002: 100 points = 1 EUR, values are integer cents", async () => {
+  const lots: PointsLot[] = [
+    { id: "l1", customerId: "alice", points: 250, expiresAt: new Date("2027-01-01T00:00:00Z") },
+  ];
+  const { router } = app([pendingOrder({ lines: [{ sku: "x", unitPriceCents: 1000, quantity: 1 }] })], lots);
+  const res = await router.handle(redeem(250, "r1"));
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, { subtotalCents: 1000, discountCents: 0, pointsAppliedCents: 250, taxCents: 190, totalCents: 1140 });
+});
