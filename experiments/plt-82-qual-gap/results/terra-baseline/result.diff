+
+/** Price an order after its discount and loyalty-points reduction, before tax. */
+export function quoteForRedeemedOrder(
+  order: { lines: Line[]; region: string; discountCode?: string },
+  pointsAppliedCents: number,
+): RedeemedQuote {
+  const base = quoteForOrder(order);
+  const applicablePoints = Math.min(Math.max(0, pointsAppliedCents), base.subtotalCents - base.discountCents);
+  const taxableCents = base.subtotalCents - base.discountCents - applicablePoints;
+  const taxCents = taxOn(taxableCents, getTaxRate(order.region));
+  return { ...base, pointsAppliedCents: applicablePoints, taxCents, totalCents: taxableCents + taxCents };
+}
