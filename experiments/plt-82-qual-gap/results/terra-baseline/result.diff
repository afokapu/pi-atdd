+
+  /**
+   * Serialize ledger work for a customer. This is deliberately part of the
+   * async adapter: a read followed by several writes must be atomic even
+   * though each individual ledger call yields to the event loop.
+   */
+  private customerTails = new Map<string, Promise<void>>();
+  async forCustomer<T>(customerId: string, work: () => Promise<T>): Promise<T> {
+    const previous = this.customerTails.get(customerId) ?? Promise.resolve();
+    let release!: () => void;
+    const gate = new Promise<void>(resolve => { release = resolve; });
+    const tail = previous.then(() => gate);
+    this.customerTails.set(customerId, tail);
+    await previous;
+    try {
+      return await work();
+    } finally {
+      release();
+      if (this.customerTails.get(customerId) === tail) this.customerTails.delete(customerId);
+    }
+  }
 }
