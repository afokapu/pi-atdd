 /** Use case: produce a customer-facing quote for a cart in a region. */
@@ -10,3 +10,28 @@ export function quoteForCart(lines: Line[], region: string, discountCode?: strin
 export function quoteForOrder(order: { lines: Line[]; region: string; discountCode?: string }): Quote {
   return quoteForCart(order.lines, order.region, order.discountCode);
 }
+
+/** The redemption response omits regional metadata and exposes the post-discount amount for the loyalty boundary. */
+export type PointsQuote = {
+  readonly subtotalCents: number;
+  readonly discountCents: number;
+  readonly pointsAppliedCents: number;
+  readonly taxCents: number;
+  readonly totalCents: number;
+};
+
+/** Return the value on which loyalty credit can be spent: subtotal after discounts but before tax. */
+export function pointsAvailableForOrder(order: { lines: Line[]; region: string; discountCode?: string }): number {
+  const base = quoteForOrder(order);
+  return base.subtotalCents - base.discountCents;
+}
+
+/** Points are cents of credit: deduct them after discounts, cap at zero, then calculate tax. */
+export function quoteForOrderWithPoints(order: { lines: Line[]; region: string; discountCode?: string }, points: number): PointsQuote {
+  const base = quoteForOrder(order);
+  const discountedCents = base.subtotalCents - base.discountCents;
+  const pointsAppliedCents = Math.min(points, discountedCents);
+  const taxCents = taxOn(discountedCents - pointsAppliedCents, getTaxRate(order.region));
+  return { subtotalCents: base.subtotalCents, discountCents: base.discountCents, pointsAppliedCents,
+    taxCents, totalCents: discountedCents - pointsAppliedCents + taxCents };
+}
