+/** Inward-facing loyalty capability required by the order redemption workflow. */
+export type LedgerLotUse = { readonly lotId: string; readonly points: number; readonly expiresAt: Date };
+export type LedgerRedemption = { readonly pointsAppliedCents: number; readonly uses: LedgerLotUse[] };
+
+/** This port deliberately combines debit and replay storage: they need one transaction. */
+export type LoyaltyLedger = {
+  redeem(customerId: string, orderId: string, requestedPoints: number, maximum: number, key: string, at: Date): Promise<LedgerRedemption>;
+  refund(uses: LedgerLotUse[], at: Date): Promise<void>;
+};
+
+/** The adapter raises this when a customer reuses a key for a different request. */
+export class IdempotencyKeyConflictError extends Error {}
