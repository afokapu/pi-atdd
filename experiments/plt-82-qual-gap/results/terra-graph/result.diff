+import { cancel, type Order } from "../domain/order.ts";
+import { IdempotencyKeyConflictError, type LoyaltyLedger } from "./loyalty-ledger.ts";
+import type { OrderPricing } from "./order-pricing.ts";
+import type { RedemptionQuote } from "../domain/order.ts";
+
+/** The storage operations the redemption workflow needs from the orders boundary. */
+type OrderStore = { get(id: string): Order | undefined; save(order: Order): void };
+
+/** The application service keeps an order transition and its ledger operation indivisible in this process. */
+export class RedemptionService {
+  private tail = Promise.resolve();
+  private readonly orders: OrderStore;
+  private readonly loyalty: LoyaltyLedger;
+  private readonly now: () => Date;
+  private readonly pricing: OrderPricing;
+
+  constructor(orders: OrderStore, loyalty: LoyaltyLedger, now: () => Date, pricing: OrderPricing) {
+    this.orders = orders;
+    this.loyalty = loyalty;
+    this.now = now;
+    this.pricing = pricing;
+  }
+
+  async redeem(orderId: string, customerId: string, points: number, idempotencyKey: string): Promise<RedemptionQuote> {
+    return this.exclusively(async () => {
+      const order = this.ownedOrder(orderId, customerId);
+      const repeated = order.redemption;
+      if (repeated) return this.repeatOrReject(repeated, points, idempotencyKey);
+      if (order.status !== "pending") throw new OrderStateError();
+      const maximum = this.pricing.pointsAvailableForOrder(order);
+      const ledger = await this.redeemLedger(customerId, orderId, points, maximum, idempotencyKey);
+      const quote = this.pricing.quoteForOrderWithPoints(order, ledger.pointsAppliedCents);
+      this.orders.save({ ...order, status: "redeemed", redemption: { points, idempotencyKey, uses: ledger.uses, quote } });
+      return quote;
+    });
+  }
+
+  async cancel(orderId: string, customerId: string): Promise<Order> {
+    return this.exclusively(async () => {
+      const order = this.ownedOrder(orderId, customerId);
+      const cancelled = cancel(order);
+      if (order.redemption) await this.loyalty.refund(order.redemption.uses, this.now());
+      this.orders.save(cancelled);
+      return cancelled;
+    });
+  }
+
+  private async redeemLedger(customerId: string, orderId: string, points: number, maximum: number, key: string) {
+    try {
+      return await this.loyalty.redeem(customerId, orderId, points, maximum, key, this.now());
+    } catch (error) {
+      if (error instanceof IdempotencyKeyConflictError) throw new IdempotencyConflictError();
+      throw error;
+    }
+  }
+
+  private ownedOrder(orderId: string, customerId: string): Order {
+    const order = this.orders.get(orderId);
+    if (!order || order.customerId !== customerId) throw new OrderNotFoundError();
+    return order;
+  }
+
+  private repeatOrReject(redemption: NonNullable<Order["redemption"]>, points: number, key: string): RedemptionQuote {
+    if (redemption.points === points && redemption.idempotencyKey === key) return redemption.quote;
+    throw new IdempotencyConflictError();
+  }
+
+  private async exclusively<T>(operation: () => Promise<T>): Promise<T> {
+    const previous = this.tail;
+    let release!: () => void;
+    this.tail = new Promise<void>(resolve => { release = resolve; });
+    await previous;
+    try { return await operation(); } finally { release(); }
+  }
+}
+
+/** Kept separate so routes can map ownership failure without exposing order existence. */
+export class OrderNotFoundError extends Error {}
+export class OrderStateError extends Error {}
+export class IdempotencyConflictError extends Error {}
