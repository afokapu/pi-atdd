@@ -0,0 +1,96 @@
+import { randomUUID } from "node:crypto";
+import type { InMemoryOrderStore } from "../integration/order-store.ts";
+import type { InMemoryLoyaltyStore } from "../../loyalty/integration/loyalty-store.ts";
+import { allocatePoints, isExpired, usablePoints, pointsToCents, type PointsLot } from "../../loyalty/domain/points.ts";
+import type { Redemption, RedemptionQuote } from "../../loyalty/domain/redemption.ts";
+import { cancel, OrderStateError } from "../domain/order.ts";
+import { subtotal } from "../../pricing/domain/quote.ts";
+import { discountedSubtotal } from "../../pricing/domain/discount.ts";
+import { quoteForOrderWithPoints } from "../../pricing/application/quote-service.ts";
+import { withCustomerLock } from "./customer-lock.ts";
+
+export type OrderUseCaseDeps = {
+  orders: InMemoryOrderStore;
+  loyalty: InMemoryLoyaltyStore;
+  now: () => Date;
+};
+
+export class OrderNotFoundError extends Error {}
+/** The idempotency key was already used for a different request. */
+export class IdempotencyConflictError extends Error {}
+/** The order already has a live points redemption under another key. */
+export class AlreadyRedeemedError extends Error {}
+
+/**
+ * Pay part of a pending order with points. Points reduce the amount after discount and
+ * before tax, never below zero; excess points are not consumed. Points come from
+ * non-expired lots, earliest expiry first.
+ */
+export function redeemPoints(
+  deps: OrderUseCaseDeps, customerId: string, orderId: string, points: number, idempotencyKey: string,
+): Promise<RedemptionQuote> {
+  return withCustomerLock(customerId, async () => {
+    const { orders, loyalty } = deps;
+    const at = deps.now();
+
+    const prior = await loyalty.redemptionByKey(customerId, idempotencyKey);
+    if (prior) {
+      if (prior.orderId !== orderId || prior.requestedPoints !== points)
+        throw new IdempotencyConflictError("idempotency key " + idempotencyKey + " was used for a different request");
+      return prior.quote;
+    }
+
+    const order = orders.get(orderId);
+    if (!order || order.customerId !== customerId) throw new OrderNotFoundError("order not found");
+    if (order.status !== "pending") throw new OrderStateError("order " + order.id + " is " + order.status);
+    if (await loyalty.redemptionForOrder(orderId)) throw new AlreadyRedeemedError("order " + orderId + " already has points applied");
+
+    const lots = await loyalty.lotsFor(customerId);
+    const payable = discountedSubtotal(subtotal(order.lines), order.discountCode);
+    const applied = Math.min(points, usablePoints(lots, at), payable);
+    const allocations = allocatePoints(lots, applied, at);
+
+    const byId = new Map(lots.map(l => [l.id, l] as const));
+    for (const a of allocations) {
+      const lot = byId.get(a.lotId)!;
+      await loyalty.saveLot({ ...lot, points: lot.points - a.points });
+    }
+
+    const result: RedemptionQuote = quoteForOrderWithPoints(order, pointsToCents(applied));
+    await loyalty.saveRedemption({
+      id: "rdm-" + randomUUID(), customerId, orderId, idempotencyKey, requestedPoints: points,
+      allocations, quote: result, reversed: false,
+    });
+    return result;
+  });
+}
+
+/**
+ * Cancel a pending order. If it had points applied, they go back to their original lots
+ * with the original expiry; points whose lot has expired by now are forfeited.
+ */
+export function cancelOrder(deps: OrderUseCaseDeps, customerId: string, orderId: string) {
+  return withCustomerLock(customerId, async () => {
+    const { orders, loyalty } = deps;
+    const order = orders.get(orderId);
+    if (!order || order.customerId !== customerId) throw new OrderNotFoundError("order not found");
+    const cancelled = cancel(order);
+    orders.save(cancelled);
+
+    const redemption = await loyalty.redemptionForOrder(orderId);
+    if (redemption) {
+      await returnPoints(deps, redemption);
+      await loyalty.saveRedemption({ ...redemption, reversed: true });
+    }
+    return cancelled;
+  });
+}
+
+async function returnPoints(deps: OrderUseCaseDeps, redemption: Redemption): Promise<void> {
+  const at = deps.now();
+  for (const a of redemption.allocations) {
+    const lot: PointsLot | undefined = await deps.loyalty.getLot(a.lotId);
+    if (!lot || isExpired(lot, at)) continue; // expired while held: forfeited
+    await deps.loyalty.saveLot({ ...lot, points: lot.points + a.points });
+  }
+}
