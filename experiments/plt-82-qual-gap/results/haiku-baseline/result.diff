+/**
+ * Ledger record of a points redemption against an order. Kept so that the same
+ * idempotency key replays the same result and so that cancelling the order can
+ * return the points to their original lots.
+ */
+export type Redemption = {
+  id: string;
+  customerId: string;
+  orderId: string;
+  idempotencyKey: string;
+  requestedPoints: number;
+  allocations: Allocation[];
+  quote: RedemptionQuote;
+  /** True once the points have been returned (order cancelled). */
+  reversed: boolean;
+};
