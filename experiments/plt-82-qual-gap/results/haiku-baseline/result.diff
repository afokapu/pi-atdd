index ed40d38..2a21490 100644
--- a/src/loyalty/domain/points.ts
+++ b/src/loyalty/domain/points.ts
@@ -18,3 +18,35 @@ export function basePoints(subtotalCents: number): number {
 export function isExpired(lot: PointsLot, at: Date): boolean {
   return lot.expiresAt.getTime() <= at.getTime();
 }
+
+/** Points taken from one lot by a redemption. `expiresAt` is the lot's original expiry. */
+export type Allocation = { lotId: string; points: number; expiresAt: Date };
+
+/** Points value in cents: 100 points = 1 EUR = 100 cents, so 1 point = 1 cent. */
+export const pointsToCents = (points: number): number => points;
+
+/** Points that can still be spent at `at` (sum over lots not yet expired). */
+export function usablePoints(lots: PointsLot[], at: Date): number {
+  return lots.filter(l => !isExpired(l, at)).reduce((sum, l) => sum + l.points, 0);
+}
+
+/**
+ * Split `points` across non-expired lots, earliest expiry first.
+ * Throws if the lots cannot cover `points`. Does not mutate the lots.
+ */
+export function allocatePoints(lots: PointsLot[], points: number, at: Date): Allocation[] {
+  if (!Number.isInteger(points) || points < 0) throw new RangeError("points must be a non-negative integer");
+  const usable = lots
+    .filter(l => !isExpired(l, at) && l.points > 0)
+    .sort((a, b) => a.expiresAt.getTime() - b.expiresAt.getTime());
+  const out: Allocation[] = [];
+  let remaining = points;
+  for (const lot of usable) {
+    if (remaining === 0) break;
+    const take = Math.min(lot.points, remaining);
+    out.push({ lotId: lot.id, points: take, expiresAt: new Date(lot.expiresAt.getTime()) });
+    remaining -= take;
+  }
+  if (remaining > 0) throw new RangeError("not enough usable points");
+  return out;
+}
