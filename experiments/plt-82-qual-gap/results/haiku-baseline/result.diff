--- /dev/null
+++ b/src/orders/application/customer-lock.ts
@@ -0,0 +1,16 @@
+/**
+ * Serialises work per customer within this process: each call starts only after the
+ * previous one for the same customer has settled. Needed because the loyalty store is
+ * asynchronous, so a read-check-write of lots could otherwise interleave with another.
+ */
+const tails = new Map<string, Promise<void>>();
+
+export function withCustomerLock<T>(customerId: string, work: () => Promise<T>): Promise<T> {
+  const run = (tails.get(customerId) ?? Promise.resolve()).then(work);
+  const tail = run.then(() => undefined, () => undefined);
+  tails.set(customerId, tail);
+  void tail.then(() => {
+    if (tails.get(customerId) === tail) tails.delete(customerId);
+  });
+  return run;
+}
