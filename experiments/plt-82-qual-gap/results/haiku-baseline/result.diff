diff --git a/tests/orders/redeem-points.acceptance.test.ts b/tests/orders/redeem-points.acceptance.test.ts
new file mode 100644
index 0000000..f52801e
--- /dev/null
+++ b/tests/orders/redeem-points.acceptance.test.ts
@@ -0,0 +1,127 @@
+/**
+ * Acceptance LOY-002
+ * POST /orders/:id/redeem pays part of a pending order with points.
+ * Points come from non-expired lots, earliest expiry first; 100 points = 1 EUR;
+ * they reduce the amount after discount and before tax, never below zero.
+ * Same idempotency key replays the same result; a different body with the same key is rejected.
+ * Cancelling returns points to their original lots; expired lots' points are forfeited.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { app, asAlice, asBob, pendingOrder } from "./helpers.ts";
+import { seedLots } from "../../src/seed.ts";
+import type { PointsLot } from "../../src/loyalty/domain/points.ts";
+
+const T0 = new Date("2026-11-19T12:00:00Z");
+
+const redeem = (router: ReturnType<typeof app>["router"], orderId: string, points: number, idempotencyKey: string, headers = asAlice) =>
+  router.handle({ method: "POST", path: `/orders/${orderId}/redeem`, headers, body: { points, idempotencyKey } });
+
+const lotPoints = async (loyalty: ReturnType<typeof app>["loyalty"], customer = "alice") =>
+  Object.fromEntries((await loyalty.lotsFor(customer)).map(l => [l.id, l.points]));
+
+test("LOY-002: points reduce the amount after discount and before tax", async () => {
+  // subtotal 10000, SAVE10 -> 9000 payable; alice has 800 usable points (lot-a3 expired)
+  const { router, loyalty } = app([pendingOrder({ discountCode: "SAVE10" })], seedLots, () => T0);
+  const res = await redeem(router, "o1", 2000, "k-1");
+  assert.equal(res.status, 200);
+  // 800 applied; tax = round((9000 - 800) * 0.19) = 1558; total = 9000 - 800 + 1558
+  assert.deepEqual(res.body, {
+    region: "DE", subtotalCents: 10000, discountCents: 1000, pointsAppliedCents: 800, taxCents: 1558, totalCents: 9758,
+  });
+  assert.deepEqual(await lotPoints(loyalty), { "lot-a1": 0, "lot-a2": 0, "lot-a3": 1000 });
+});
+
+test("LOY-002: points are consumed earliest expiry first, spanning lots", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots, () => T0);
+  // lot-a2 (expires 2026-12-01) before lot-a1 (expires 2026-12-31)
+  assert.equal((await redeem(router, "o1", 400, "k-1")).status, 200);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-a1": 300, "lot-a2": 100, "lot-a3": 1000 });
+
+  const second = app([pendingOrder()], seedLots, () => T0);
+  assert.equal((await redeem(second.router, "o1", 700, "k-2")).status, 200);
+  assert.deepEqual(await lotPoints(second.loyalty), { "lot-a1": 100, "lot-a2": 0, "lot-a3": 1000 });
+});
+
+test("LOY-002: excess points beyond the payable amount are not consumed", async () => {
+  // 4 x 250 = 1000 subtotal, no discount: only 1000 points could ever be used
+  const { router } = app([pendingOrder({ lines: [{ sku: "x", unitPriceCents: 250, quantity: 4 }] })], seedLots, () => T0);
+  const res = await redeem(router, "o1", 800, "k-1");
+  assert.deepEqual(res.body, { region: "DE", subtotalCents: 1000, discountCents: 0, pointsAppliedCents: 800, taxCents: 38, totalCents: 238 });
+
+  const small = app([pendingOrder({ lines: [{ sku: "x", unitPriceCents: 500, quantity: 1 }] })], seedLots, () => T0);
+  const res2 = await redeem(small.router, "o1", 800, "k-1");
+  assert.deepEqual(res2.body, { region: "DE", subtotalCents: 500, discountCents: 0, pointsAppliedCents: 500, taxCents: 0, totalCents: 0 });
+  assert.deepEqual(await lotPoints(small.loyalty), { "lot-a1": 300, "lot-a2": 0, "lot-a3": 1000 });
+});
+
+test("LOY-002: never below zero when the discount covers the whole amount", async () => {
+  const { router, loyalty } = app([pendingOrder({ lines: [{ sku: "x", unitPriceCents: 300, quantity: 1 }], discountCode: "FLAT5" })], seedLots, () => T0);
+  const res = await redeem(router, "o1", 500, "k-1");
+  assert.deepEqual(res.body, { region: "DE", subtotalCents: 300, discountCents: 300, pointsAppliedCents: 0, taxCents: 0, totalCents: 0 });
+  assert.deepEqual(await lotPoints(loyalty), { "lot-a1": 300, "lot-a2": 500, "lot-a3": 1000 });
+});
+
+test("LOY-002: same idempotency key returns the same result and consumes nothing more", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots, () => T0);
+  const first = await redeem(router, "o1", 400, "k-1");
+  const again = await redeem(router, "o1", 400, "k-1");
+  assert.equal(again.status, 200);
+  assert.deepEqual(again.body, first.body);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-a1": 300, "lot-a2": 100, "lot-a3": 1000 });
+});
+
+test("LOY-002: same idempotency key with a different body is rejected", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots, () => T0);
+  assert.equal((await redeem(router, "o1", 400, "k-1")).status, 200);
+  const res = await redeem(router, "o1", 100, "k-1");
+  assert.equal(res.status, 422);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-a1": 300, "lot-a2": 100, "lot-a3": 1000 });
+});
+
+test("LOY-002: concurrent redemptions never spend the same points", async () => {
+  // alice has 800 usable points; two pending orders each ask for 600
+  const { router, loyalty } = app([pendingOrder(), pendingOrder({ id: "o4" })], seedLots, () => T0);
+  const results = await Promise.all([redeem(router, "o1", 600, "k-1"), redeem(router, "o4", 600, "k-2")]);
+  assert.deepEqual(results.map(r => r.status), [200, 200]);
+  const applied = results.map(r => (r.body as { pointsAppliedCents: number }).pointsAppliedCents).sort((a, b) => a - b);
+  assert.deepEqual(applied, [200, 600]);
+  const left = await lotPoints(loyalty);
+  assert.deepEqual(left, { "lot-a1": 0, "lot-a2": 0, "lot-a3": 1000 });
+});
+
+test("LOY-002: a second redemption on the same order under another key is rejected", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots, () => T0);
+  assert.equal((await redeem(router, "o1", 100, "k-1")).status, 200);
+  assert.equal((await redeem(router, "o1", 100, "k-2")).status, 409);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-a1": 300, "lot-a2": 400, "lot-a3": 1000 });
+});
+
+test("LOY-002: only pending orders, only the owner, and a valid body", async () => {
+  const { router } = app([pendingOrder({ status: "shipped" }), pendingOrder({ id: "o2" })], seedLots, () => T0);
+  assert.equal((await redeem(router, "o1", 100, "k-1")).status, 409);
+  assert.equal((await redeem(router, "o2", 100, "k-2", asBob)).status, 404);
+  assert.equal((await redeem(router, "o2", -1, "k-3")).status, 400);
+  assert.equal((await redeem(router, "o2", 1.5, "k-4")).status, 400);
+  assert.equal((await redeem(router, "o2", 10, "")).status, 400);
+  assert.equal((await router.handle({ method: "POST", path: "/orders/o2/redeem", headers: {}, body: { points: 1, idempotencyKey: "k" } })).status, 401);
+});
+
+test("LOY-002: cancelling a redeemed order returns points to their original lots and expiry", async () => {
+  const { router, loyalty } = app([pendingOrder()], seedLots, () => T0);
+  assert.equal((await redeem(router, "o1", 400, "k-1")).status, 200);
+  const res = await router.handle({ method: "POST", path: "/orders/o1/cancel", headers: asAlice });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-a1": 300, "lot-a2": 500, "lot-a3": 1000 });
+  const a2 = (await loyalty.getLot("lot-a2")) as PointsLot;
+  assert.equal(a2.expiresAt.toISOString(), "2026-12-01T00:00:00.000Z");
+});
+
+test("LOY-002: points whose lot expired before cancelling are forfeited", async () => {
+  let clock = T0;
+  const { router, loyalty } = app([pendingOrder()], seedLots, () => clock);
+  assert.equal((await redeem(router, "o1", 700, "k-1")).status, 200); // lot-a2 emptied, lot-a1 at 100
+  clock = new Date("2026-12-15T00:00:00Z"); // lot-a2 has expired (2026-12-01), lot-a1 has not (2026-12-31)
+  assert.equal((await router.handle({ method: "POST", path: "/orders/o1/cancel", headers: asAlice })).status, 200);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-a1": 300, "lot-a2": 0, "lot-a3": 1000 });
