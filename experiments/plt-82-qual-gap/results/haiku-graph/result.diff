+++ b/src/loyalty/application/customer-lock.ts
@@ -0,0 +1,22 @@
+/**
+ * Runs work one at a time per customer within this process. The loyalty store is
+ * asynchronous, so "read lots, decide, write lots back" can interleave with another
+ * request for the same customer and both could spend the same points. Holding this
+ * lock across the whole read-decide-write keeps one customer's ledger updates in order.
+ *
+ * This is an in-process guard only. Several service instances would need a store that
+ * supports transactions or conditional writes on the lots.
+ */
+const tails = new Map<string, Promise<void>>();
+
+export function withCustomerLock<T>(customerId: string, work: () => Promise<T>): Promise<T> {
+  const previous = tails.get(customerId) ?? Promise.resolve();
+  const run = previous.then(() => work());
+  // The tail never rejects, so a failing unit of work does not block the ones queued after it.
+  const tail = run.then(() => undefined, () => undefined);
+  tails.set(customerId, tail);
+  void tail.then(() => {
+    if (tails.get(customerId) === tail) tails.delete(customerId);
+  });
+  return run;
+}
