+/**
+ * Acceptance LOY-002
+ * POST /orders/:id/redeem pays part of a pending order with points. Lots are consumed
+ * earliest expiry first; points reduce the amount after discounts and before tax; excess
+ * points are not consumed; a repeated key is a replay; concurrent redemptions never double
+ * spend; cancelling returns points to their original lots unless those lots have expired.
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { app, asAlice, pendingOrder } from "../orders/helpers.ts";
+import { seedLots } from "../../src/seed.ts";
+import type { PointsLot } from "../../src/loyalty/domain/points.ts";
+
+const NOW = new Date("2026-11-19T12:00:00Z");
+const redeem = (router: ReturnType<typeof app>["router"], orderId: string, body: unknown) =>
+  router.handle({ method: "POST", path: "/orders/" + orderId + "/redeem", headers: asAlice, body });
+const balances = async (loyalty: ReturnType<typeof app>["loyalty"], ids: string[]) =>
+  Object.fromEntries(await Promise.all(ids.map(async id => [id, (await loyalty.getLot(id))!.points])));
+
+test("LOY-002: redeem consumes earliest-expiring non-expired lots and reduces the amount before tax", async () => {
+  const { router, loyalty } = app([pendingOrder({ discountCode: "SAVE10" })], seedLots, () => NOW);
+  // subtotal 10000, SAVE10 -> discount 1000, due 9000; 600 points -> due 8400; DE tax 19% -> 1596
