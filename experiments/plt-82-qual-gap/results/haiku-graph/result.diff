+export function spendPoints(lots: PointsLot[], points: number, at: Date): Spend {
+  const allocations: Allocation[] = [];
+  const updatedLots: PointsLot[] = [];
+  let remaining = points;
+  for (const lot of spendableLots(lots, at)) {
+    if (remaining === 0) break;
+    const take = Math.min(lot.points, remaining);
+    allocations.push({ lotId: lot.id, points: take, expiresAt: lot.expiresAt });
+    updatedLots.push({ ...lot, points: lot.points - take });
+    remaining -= take;
+  }
