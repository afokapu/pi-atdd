+/**
+ * Use cases that settle an order's loyalty points: redeeming them against a pending order,
+ * and returning them when that order is cancelled. Both run under the customer's lock, and
+ * both read the order inside the lock, so a concurrent cancel and redeem cannot interleave.
+ */
+import { cancel, OrderNotFoundError, OrderStateError, type Order } from "../domain/order.ts";
+import type { InMemoryOrderStore } from "../integration/order-store.ts";
+import type { InMemoryLoyaltyStore } from "../../loyalty/integration/loyalty-store.ts";
+import {
+  centsToPoints, InsufficientPointsError, pointsToCents, returnPoints, spendableBalance, spendPoints,
+  type Redemption,
+} from "../../loyalty/domain/points.ts";
+import { withCustomerLock } from "../../loyalty/application/customer-lock.ts";
+import { quoteForOrderWithPoints } from "../../pricing/application/quote-service.ts";
+import type { PointsQuote } from "../../pricing/domain/quote.ts";
+
+export type PaymentDeps = { orders: InMemoryOrderStore; loyalty: InMemoryLoyaltyStore; now: () => Date };
+export type RedeemRequest = { orderId: string; customerId: string; points: number; idempotencyKey: string };
+
+/** The order already carries a redemption made under a different idempotency key. */
+export class OrderAlreadyRedeemedError extends Error {}
+/** This idempotency key was already used for this order with a different number of points. */
+export class IdempotencyKeyReusedError extends Error {}
+
+export function redeemPoints(deps: PaymentDeps, req: RedeemRequest): Promise<PointsQuote> {
+  return withCustomerLock(req.customerId, () => redeemPointsLocked(deps, req));
+}
+
+/**
+ * Rules: a retry with the same key returns the stored result and spends nothing more.
+ * Otherwise the order must be pending and the customer must hold at least the requested
+ * points. Points beyond the amount still due are not consumed.
+ */
+async function redeemPointsLocked(deps: PaymentDeps, req: RedeemRequest): Promise<PointsQuote> {
+  const order = ownedOrder(deps.orders, req.orderId, req.customerId);
+  const existing = await deps.loyalty.redemptionFor(order.id);
+  if (existing) return replayRedemption(order, existing, req);
+  if (order.status !== "pending") throw new OrderStateError("order " + order.id + " is " + order.status);
+
+  const lots = await deps.loyalty.lotsFor(req.customerId);
+  const now = deps.now();
+  if (req.points > spendableBalance(lots, now))
+    throw new InsufficientPointsError("requested " + req.points + " points, balance is " + spendableBalance(lots, now));
+
+  const quote = quoteForOrderWithPoints(order, pointsToCents(req.points));
+  const spend = spendPoints(lots, centsToPoints(quote.pointsAppliedCents), now);
+  for (const lot of spend.updatedLots) await deps.loyalty.saveLot(lot);
+  await deps.loyalty.saveRedemption({
+    orderId: order.id, customerId: req.customerId, idempotencyKey: req.idempotencyKey,
+    points: req.points, allocations: spend.allocations,
+  });
+  return quote;
+}
+
+/** Answer a request for an order that already has a redemption, without touching the ledger. */
+function replayRedemption(order: Order, existing: Redemption, req: RedeemRequest): PointsQuote {
+  if (existing.idempotencyKey !== req.idempotencyKey)
+    throw new OrderAlreadyRedeemedError("order " + order.id + " already has a points redemption");
+  if (existing.points !== req.points)
+    throw new IdempotencyKeyReusedError("idempotency key " + req.idempotencyKey + " was used with a different body");
+  return quoteForOrderWithPoints(order, pointsToCents(spentPoints(existing)));
+}
+
+/** Cancel a pending order and return the points it spent to their original lots. */
+export function cancelOrder(deps: PaymentDeps, customerId: string, orderId: string): Promise<Order> {
+  return withCustomerLock(customerId, () => cancelOrderLocked(deps, customerId, orderId));
+}
+
+async function cancelOrderLocked(deps: PaymentDeps, customerId: string, orderId: string): Promise<Order> {
+  const order = ownedOrder(deps.orders, orderId, customerId);
+  const cancelled = cancel(order);
+  const redemption = await deps.loyalty.redemptionFor(order.id);
+  if (redemption) await returnRedemption(deps, redemption);
+  deps.orders.save(cancelled);
+  return cancelled;
+}
+
+/** Points go back to the lot they came from; a lot that has expired by now keeps them forfeited. */
+async function returnRedemption(deps: PaymentDeps, redemption: Redemption): Promise<void> {
+  const now = deps.now();
+  for (const a of redemption.allocations) {
+    const restored = returnPoints(await deps.loyalty.getLot(a.lotId), a.points, now);
+    if (restored) await deps.loyalty.saveLot(restored);
+  }
+}
+
+function ownedOrder(orders: InMemoryOrderStore, orderId: string, customerId: string): Order {
+  const order = orders.get(orderId);
+  if (!order || order.customerId !== customerId) throw new OrderNotFoundError(orderId);
+  return order;
+}
+
+const spentPoints = (r: Redemption): number => r.allocations.reduce((sum, a) => sum + a.points, 0);
