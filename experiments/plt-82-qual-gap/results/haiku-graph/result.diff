@@ -0,0 +1,33 @@
+import type { Handler } from "../../http/router.ts";
+import { withCustomer, type SessionStore } from "../../http/auth.ts";
+import { redeemPoints, type PaymentDeps } from "../application/order-payments.ts";
+import { failureResponse } from "./order-errors.ts";
+
+/** Body of POST /orders/:id/redeem. `idempotencyKey` makes a retry safe. */
+type RedeemBody = { points: number; idempotencyKey: string };
+
+const isPositiveInteger = (x: unknown): x is number => Number.isInteger(x) && (x as number) > 0;
+
+function parseRedeemBody(body: unknown): RedeemBody | undefined {
+  const b = (body ?? {}) as { points?: unknown; idempotencyKey?: unknown };
+  if (!isPositiveInteger(b.points)) return undefined;
+  if (typeof b.idempotencyKey !== "string" || b.idempotencyKey === "") return undefined;
+  return { points: b.points, idempotencyKey: b.idempotencyKey };
+}
+
+/** POST /orders/:id/redeem: pay part of a pending order with loyalty points. */
+export function redeemRoute(sessions: SessionStore, payments: PaymentDeps): Handler {
+  return withCustomer(sessions, async (req, params, customer) => {
+    const body = parseRedeemBody(req.body);
+    if (!body)
+      return { status: 400, body: { error: "points (positive integer) and idempotencyKey (string) required", error_code: "INVALID_REDEMPTION" } };
+    try {
+      const quote = await redeemPoints(payments, { orderId: params.id!, customerId: customer.id, ...body });
+      return { status: 200, body: quote };
+    } catch (e) {
+      const failure = failureResponse(e);
+      if (failure) return failure;
+      throw e;
+    }
+  });
+}
