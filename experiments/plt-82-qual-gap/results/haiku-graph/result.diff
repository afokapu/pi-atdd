+/**
+ * Maps order and points failures to HTTP responses. Every body carries a stable
+ * error_code so clients branch on the code, not on the message text.
+ */
+import type { Response } from "../../http/router.ts";
+import { OrderNotFoundError, OrderStateError } from "../domain/order.ts";
+import { IdempotencyKeyReusedError, OrderAlreadyRedeemedError } from "../application/order-payments.ts";
+import { InsufficientPointsError } from "../../loyalty/domain/points.ts";
+
+/** The response for a known failure, or undefined so the caller rethrows anything unexpected. */
+export function failureResponse(e: unknown): Response | undefined {
+  if (e instanceof OrderNotFoundError) return { status: 404, body: { error: "order not found", error_code: "ORDER_NOT_FOUND" } };
+  if (e instanceof OrderStateError) return { status: 409, body: { error: e.message, error_code: "ORDER_NOT_PENDING" } };
+  if (e instanceof OrderAlreadyRedeemedError) return { status: 409, body: { error: e.message, error_code: "ORDER_ALREADY_REDEEMED" } };
+  if (e instanceof InsufficientPointsError) return { status: 409, body: { error: e.message, error_code: "INSUFFICIENT_POINTS" } };
+  if (e instanceof IdempotencyKeyReusedError) return { status: 422, body: { error: e.message, error_code: "IDEMPOTENCY_KEY_REUSED" } };
+  return undefined;
+}
