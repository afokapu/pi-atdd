+
+/**
+ * Price a cart paying part of it with points: subtotal, discount, then points, then tax.
+ * Points reduce what is still due after discounts and before tax, and are capped at that
+ * amount so the result is never negative. `pointsCents` is what the customer offers;
+ * `pointsAppliedCents` is what is actually used.
+ */
+export function quoteWithPoints(
+  lines: Line[], region: string, taxRate: number, discountCode: string | undefined, pointsCents: number,
+): PointsQuote {
+  const subtotalCents = subtotal(lines);
+  const discount = discountCents(subtotalCents, discountCode);
+  const due = subtotalCents - discount;
+  const pointsApplied = Math.min(pointsCents, due);
+  const taxCents = taxOn(due - pointsApplied, taxRate);
+  return {
+    region, subtotalCents, discountCents: discount, pointsAppliedCents: pointsApplied,
+    taxCents, totalCents: due - pointsApplied + taxCents,
+  };
+}
