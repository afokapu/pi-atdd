+import { applyPoints, cancel, OrderStateError, type Order } from "../domain/order.ts";
+import type { InMemoryOrderStore } from "../integration/order-store.ts";
+import { quoteForOrder, quoteForOrderWithPoints } from "../../pricing/application/quote-service.ts";
+import type { PointsQuote, Quote } from "../../pricing/domain/quote.ts";
+import { CENTS_PER_POINT } from "../../loyalty/domain/points.ts";
+import type { InMemoryLoyaltyStore } from "../../loyalty/integration/loyalty-store.ts";
+import type { InMemoryRedemptionStore } from "../../loyalty/integration/redemption-store.ts";
+import type { KeyedLock } from "../../loyalty/application/keyed-lock.ts";
+import { consumePoints, returnPoints } from "../../loyalty/application/ledger.ts";
+
+export type RedeemDeps = {
+  orders: InMemoryOrderStore;
+  loyalty: InMemoryLoyaltyStore;
+  redemptions: InMemoryRedemptionStore;
+  /** Per-customer lock serialising all ledger writes for that customer. */
+  locks: KeyedLock;
+  now: () => Date;
+};
+
+export class OrderNotFoundError extends Error {}
+export class IdempotencyConflictError extends Error {}
+
+/** Quote of an order as stored, including points if some were redeemed on it. */
+export function currentQuote(order: Order): Quote | PointsQuote {
+  return order.pointsApplied === undefined ? quoteForOrder(order) : quoteForOrderWithPoints(order, order.pointsApplied, CENTS_PER_POINT);
+}
+
+/**
+ * Use case: the owner of a pending order pays part of it with loyalty points.
+ * Idempotent per (customer, idempotencyKey). Points beyond the discounted amount are not consumed.
+ */
+export async function redeemPoints(deps: RedeemDeps, input: { customerId: string; orderId: string; points: number; idempotencyKey: string }): Promise<PointsQuote> {
+  const { customerId, orderId, points, idempotencyKey } = input;
+  const fingerprint = JSON.stringify({ orderId, points });
+  return deps.locks.run(customerId, async () => {
+    const prior = deps.redemptions.getKey(customerId, idempotencyKey);
+    if (prior) {
+      if (prior.fingerprint !== fingerprint) throw new IdempotencyConflictError("idempotency key already used with a different request");
+      return prior.body as PointsQuote;
+    }
+    const order = deps.orders.get(orderId);
+    if (!order || order.customerId !== customerId) throw new OrderNotFoundError("order not found");
+    const q = quoteForOrderWithPoints(order, points, CENTS_PER_POINT);
+    const updated = applyPoints(order, q.pointsApplied); // throws OrderStateError
+    const consumed = await consumePoints(deps.loyalty, customerId, q.pointsApplied, deps.now());
+    deps.redemptions.save({ orderId, customerId, points: q.pointsApplied, consumed, reversed: [] });
+    deps.orders.save(updated);
+    deps.redemptions.saveKey({ customerId, key: idempotencyKey, fingerprint, status: 200, body: q });
+    return q;
+  });
+}
+
+/** Use case: cancel a pending order, returning any redeemed points to their original lots. */
+export async function cancelOrder(deps: RedeemDeps, input: { customerId: string; orderId: string }): Promise<Order> {
+  const { customerId, orderId } = input;
+  return deps.locks.run(customerId, async () => {
+    const order = deps.orders.get(orderId);
+    if (!order || order.customerId !== customerId) throw new OrderNotFoundError("order not found");
+    const cancelled = cancel(order); // throws OrderStateError
+    const redemption = deps.redemptions.getForOrder(orderId);
+    if (redemption) await returnPoints(deps.loyalty, redemption, deps.now(), r => deps.redemptions.save(r));
+    deps.orders.save(cancelled);
+    return cancelled;
+  });
+}
+
+export { OrderStateError };
