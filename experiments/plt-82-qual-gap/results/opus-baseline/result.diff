--- /dev/null
+++ b/src/loyalty/integration/redemption-store.ts
@@ -0,0 +1,21 @@
+import type { Redemption } from "../domain/redemption.ts";
+
+const copy = (r: Redemption): Redemption => ({ ...r, consumed: r.consumed.map(c => ({ ...c })), reversed: [...r.reversed] });
+
+/** Stored outcome of an idempotent redemption request. */
+export type IdempotencyRecord = { customerId: string; key: string; fingerprint: string; status: number; body: unknown };
+
+/** Adapter over redemption records and idempotency keys (in memory for this service). */
+export class InMemoryRedemptionStore {
+  private byOrder = new Map<string, Redemption>();
+  private byKey = new Map<string, IdempotencyRecord>();
+
+  getForOrder(orderId: string): Redemption | undefined { const r = this.byOrder.get(orderId); return r && copy(r); }
+  save(r: Redemption): void { this.byOrder.set(r.orderId, copy(r)); }
+
+  getKey(customerId: string, key: string): IdempotencyRecord | undefined {
+    const r = this.byKey.get(customerId + "\u0000" + key);
+    return r && structuredClone(r);
+  }
+  saveKey(r: IdempotencyRecord): void { this.byKey.set(r.customerId + "\u0000" + r.key, structuredClone(r)); }
+}
