+/**
+ * Acceptance LOY-002 — Pay with loyalty points
+ * POST /orders/:id/redeem { points, idempotencyKey } by the owner of a pending order.
+ * Non-expired lots consumed earliest expiry first; 100 points = 1 EUR; points apply after
+ * discount and before tax, never below zero, excess not consumed; idempotent per key;
+ * concurrent redemptions never double-spend; cancel returns points to original lots
+ * (forfeited if the lot has expired by then).
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { app, asAlice, asBob, pendingOrder } from "./helpers.ts";
+import { seedLots } from "../../src/seed.ts";
+import type { InMemoryLoyaltyStore } from "../../src/loyalty/integration/loyalty-store.ts";
+
+const aliceLots = seedLots.filter(l => l.customerId === "alice"); // a1 300 (Dec 31), a2 500 (Dec 1), a3 1000 (expired)
+const redeem = (id: string, body: unknown, headers = asAlice) => ({ method: "POST" as const, path: `/orders/${id}/redeem`, headers, body });
+const pointsOf = async (store: InMemoryLoyaltyStore) =>
+  Object.fromEntries((await store.lotsFor("alice")).map(l => [l.id, l.points]));
+
+test("LOY-002: redeems earliest-expiring non-expired lots and returns the new quote", async () => {
+  const { router, loyalty } = app([pendingOrder()], aliceLots);
+  const res = await router.handle(redeem("o1", { points: 600, idempotencyKey: "k1" }));
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, { region: "DE", subtotalCents: 10000, discountCents: 0, pointsApplied: 600, pointsCents: 600, taxCents: 1786, totalCents: 11186 });
+  assert.deepEqual(await pointsOf(loyalty), { "lot-a1": 200, "lot-a2": 0, "lot-a3": 1000 });
+  const q = await router.handle({ method: "GET", path: "/orders/o1/quote", headers: asAlice });
+  assert.deepEqual(q.body, res.body);
+});
+
+test("LOY-002: points apply after discount, before tax", async () => {
+  const { router } = app([pendingOrder({ discountCode: "SAVE10" })], aliceLots);
+  const res = await router.handle(redeem("o1", { points: 333, idempotencyKey: "k1" }));
+  // 10000 - 1000 discount - 333 points = 8667; tax round(8667 * 0.19) = 1647
+  assert.deepEqual(res.body, { region: "DE", subtotalCents: 10000, discountCents: 1000, pointsApplied: 333, pointsCents: 333, taxCents: 1647, totalCents: 10314 });
+});
+
+test("LOY-002: never below zero and excess points are not consumed", async () => {
+  const { router, loyalty } = app([pendingOrder({ discountCode: "FLAT5", lines: [{ sku: "x", unitPriceCents: 700, quantity: 1 }] })], aliceLots);
+  const res = await router.handle(redeem("o1", { points: 800, idempotencyKey: "k1" }));
+  assert.equal(res.status, 200);
