diff --git a/src/pricing/domain/quote.ts b/src/pricing/domain/quote.ts
index 26cc297..27db54a 100644
--- a/src/pricing/domain/quote.ts
+++ b/src/pricing/domain/quote.ts
@@ -19,3 +19,22 @@ export function quote(lines: Line[], region: string, taxRate: number, discountCo
   const taxCents = taxOn(subtotalCents - discount, taxRate);
   return { region, subtotalCents, discountCents: discount, taxCents, totalCents: subtotalCents - discount + taxCents };
 }
+
+export type PointsQuote = Quote & { pointsApplied: number; pointsCents: number };
+
+/**
+ * Price a cart paid partly with loyalty points: subtotal, then discount, then the
+ * points value (never taking the amount below zero), then tax on what remains.
+ * `pointsCents` is the requested value; the applied value is capped at the discounted amount.
+ */
+export function quoteWithPoints(lines: Line[], region: string, taxRate: number, discountCode: string | undefined,
+  points: number, centsPerPoint: number): PointsQuote {
+  const subtotalCents = subtotal(lines);
+  const discount = discountCents(subtotalCents, discountCode);
+  const afterDiscount = subtotalCents - discount;
+  const pointsApplied = Math.min(points, Math.floor(afterDiscount / centsPerPoint));
+  const pointsCents = pointsApplied * centsPerPoint;
+  const taxable = afterDiscount - pointsCents;
+  const taxCents = taxOn(taxable, taxRate);
+  return { region, subtotalCents, discountCents: discount, pointsApplied, pointsCents, taxCents, totalCents: taxable + taxCents };
+}
