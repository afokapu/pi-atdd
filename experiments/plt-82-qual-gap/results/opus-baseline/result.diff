@@ -0,0 +1,54 @@
+import { isExpired, planConsumption, type LotConsumption } from "../domain/points.ts";
+import type { Redemption } from "../domain/redemption.ts";
+import type { InMemoryLoyaltyStore } from "../integration/loyalty-store.ts";
+
+/**
+ * Take `points` from a customer's lots (earliest expiry first, non-expired only).
+ * Caller must hold the customer's lock. On a storage failure part-way, lots already
+ * written are put back (best effort) and the error is rethrown.
+ */
+export async function consumePoints(store: InMemoryLoyaltyStore, customerId: string, points: number, at: Date): Promise<LotConsumption[]> {
+  if (points === 0) return [];
+  const lots = await store.lotsFor(customerId);
+  const plan = planConsumption(lots, points, at);
+  const byId = new Map(lots.map(l => [l.id, l]));
+  const done: LotConsumption[] = [];
+  try {
+    for (const c of plan) {
+      const lot = byId.get(c.lotId)!;
+      await store.saveLot({ ...lot, points: lot.points - c.points });
+      done.push(c);
+    }
+  } catch (e) {
+    for (const c of done) {
+      const lot = byId.get(c.lotId)!;
+      await store.saveLot(lot).catch(() => {});
+    }
+    throw e;
+  }
+  return plan;
+}
+
+/**
+ * Return a redemption's points to their original lots (original expiry kept).
+ * Points whose lot has expired by `at` are forfeited. Caller must hold the customer's lock.
+ * `onProgress` is called after each lot so a partial failure can be resumed without double refunds.
+ */
+export async function returnPoints(store: InMemoryLoyaltyStore, redemption: Redemption, at: Date,
+  onProgress: (r: Redemption) => void): Promise<{ returned: number; forfeited: number }> {
+  let returned = 0, forfeited = 0;
+  const current: Redemption = { ...redemption, reversed: [...redemption.reversed] };
+  for (const c of redemption.consumed) {
+    if (current.reversed.includes(c.lotId)) continue;
+    const lot = await store.getLot(c.lotId);
+    if (lot && !isExpired(lot, at)) {
+      await store.saveLot({ ...lot, points: lot.points + c.points });
+      returned += c.points;
+    } else {
+      forfeited += c.points;
+    }
+    current.reversed.push(c.lotId);
+    onProgress({ ...current, reversed: [...current.reversed] });
+  }
+  return { returned, forfeited };
+}
diff --git a/src/loyalty/domain/points.ts b/src/loyalty/domain/points.ts
index ed40d38..576c8c5 100644
--- a/src/loyalty/domain/points.ts
+++ b/src/loyalty/domain/points.ts
@@ -18,3 +18,47 @@ export function basePoints(subtotalCents: number): number {
 export function isExpired(lot: PointsLot, at: Date): boolean {
   return lot.expiresAt.getTime() <= at.getTime();
 }
+
+/** 100 points = 1 EUR, i.e. one point is worth one cent. */
+export const CENTS_PER_POINT = 1;
+
+export function pointsToCents(points: number): number {
+  return points * CENTS_PER_POINT;
+}
+
+/** Most points that can be applied against an amount (whole points only). */
+export function maxPointsFor(amountCents: number): number {
+  return Math.max(0, Math.floor(amountCents / CENTS_PER_POINT));
+}
+
+/** Points taken from one lot by a redemption. */
+export type LotConsumption = { lotId: string; points: number };
+
+export class InsufficientPointsError extends Error {}
+
+/** Points usable at `at`: non-expired lots only. */
+export function availablePoints(lots: PointsLot[], at: Date): number {
+  return lots.filter(l => !isExpired(l, at)).reduce((sum, l) => sum + l.points, 0);
+}
+
+/**
+ * Plan which lots to consume for `points`: non-expired, non-empty lots,
+ * earliest expiry first (ties keep the given order). Pure: lots are not mutated.
+ */
+export function planConsumption(lots: PointsLot[], points: number, at: Date): LotConsumption[] {
+  if (!Number.isInteger(points) || points < 0) throw new RangeError("points must be a non-negative integer");
+  const usable = lots
+    .map((lot, index) => ({ lot, index }))
+    .filter(({ lot }) => lot.points > 0 && !isExpired(lot, at))
+    .sort((a, b) => a.lot.expiresAt.getTime() - b.lot.expiresAt.getTime() || a.index - b.index);
+  const plan: LotConsumption[] = [];
+  let remaining = points;
+  for (const { lot } of usable) {
+    if (remaining === 0) break;
+    const take = Math.min(lot.points, remaining);
+    plan.push({ lotId: lot.id, points: take });
+    remaining -= take;
+  }
+  if (remaining > 0) throw new InsufficientPointsError("not enough points: " + points + " requested, " + (points - remaining) + " available");
+  return plan;
+}
