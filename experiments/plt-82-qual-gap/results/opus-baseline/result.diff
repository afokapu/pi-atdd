@@ -0,0 +1,23 @@
+/**
+ * Serialises async critical sections per key (e.g. per customer) within this process.
+ * The loyalty store has no transactions or compare-and-set, so every
+ * read-modify-write of a customer's lots must run under that customer's lock.
+ */
+export class KeyedLock {
+  private tails = new Map<string, Promise<void>>();
+
+  async run<T>(key: string, fn: () => Promise<T>): Promise<T> {
+    const prev = this.tails.get(key) ?? Promise.resolve();
+    let release!: () => void;
+    const mine = new Promise<void>(r => (release = r));
+    const tail = prev.then(() => mine);
+    this.tails.set(key, tail);
+    await prev;
+    try {
+      return await fn();
+    } finally {
+      release();
+      if (this.tails.get(key) === tail) this.tails.delete(key);
+    }
+  }
+}
