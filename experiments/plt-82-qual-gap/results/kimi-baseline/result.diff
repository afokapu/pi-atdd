diff --git a/tests/loyalty/redeem.acceptance.test.ts b/tests/loyalty/redeem.acceptance.test.ts
new file mode 100644
index 0000000..8bc18bd
--- /dev/null
+++ b/tests/loyalty/redeem.acceptance.test.ts
@@ -0,0 +1,164 @@
+/**
+ * Acceptance LOY-002
+ * Given a pending order owned by the signed-in customer
+ * When the customer sends POST /orders/:id/redeem with { points, idempotencyKey }
+ * Then points are consumed from non-expired lots (earliest expiry first, 100 points = 1 EUR),
+ *      reduce the amount after discounts and before tax (never below zero),
+ *      the response is the new quote including the applied points,
+ *      retries with the same key replay without consuming more,
+ *      and cancelling the order returns the points to their original lots
+ *      (forfeited when the lot expired in the meantime).
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { app, asAlice, asBob, pendingOrder } from "../orders/helpers.ts";
+import type { PointsLot } from "../../src/loyalty/domain/points.ts";
+
+/** Alice's lots as seeded in src/seed.ts: a2 (2026-12-01) expires before a1 (2026-12-31); a3 is expired. */
+const aliceLots: PointsLot[] = [
+  { id: "lot-a1", customerId: "alice", points: 300, expiresAt: new Date("2026-12-31T00:00:00Z") },
+  { id: "lot-a2", customerId: "alice", points: 500, expiresAt: new Date("2026-12-01T00:00:00Z") },
+  { id: "lot-a3", customerId: "alice", points: 1000, expiresAt: new Date("2025-06-30T00:00:00Z") },
+];
+
+const redeem = (points: number, idempotencyKey: string) => ({
+  method: "POST" as const,
+  path: "/orders/o1/redeem",
+  headers: asAlice,
+  body: { points, idempotencyKey },
+});
+
+const lotPoints = async (loyalty: { lotsFor(id: string): Promise<PointsLot[]> }, id: string) =>
+  (await loyalty.lotsFor("alice")).find(l => l.id === id)!.points;
+
+test("LOY-002: points reduce the amount after discounts and before tax; lots consumed earliest expiry first", async () => {
+  const { router, loyalty } = app([pendingOrder()], aliceLots);
+  const res = await router.handle(redeem(400, "k1"));
+  assert.equal(res.status, 200);
+  // 400 points = 400 cents off a 10000 subtotal; tax 19% on 9600.
+  assert.deepEqual(res.body, {
+    region: "DE", subtotalCents: 10000, discountCents: 0, pointsAppliedCents: 400,
+    taxCents: 1824, totalCents: 11424,
+  });
+  // Expired lot-a3 untouched; earliest-expiring non-expired lot (a2) consumed first.
+  assert.equal(await lotPoints(loyalty, "lot-a2"), 100);
+  assert.equal(await lotPoints(loyalty, "lot-a1"), 300);
+  assert.equal(await lotPoints(loyalty, "lot-a3"), 1000);
+});
+
+test("LOY-002: same idempotency key replays the result without consuming more", async () => {
+  const { router, loyalty } = app([pendingOrder()], aliceLots);
+  const first = await router.handle(redeem(400, "k1"));
+  const second = await router.handle(redeem(400, "k1"));
+  assert.equal(second.status, 200);
+  assert.deepEqual(second.body, first.body);
+  assert.equal(await lotPoints(loyalty, "lot-a2"), 100);
+});
+
+test("LOY-002: same idempotency key with a different body is rejected", async () => {
+  const { router, loyalty } = app([pendingOrder()], aliceLots);
+  await router.handle(redeem(400, "k1"));
+  const res = await router.handle(redeem(500, "k1"));
+  assert.equal(res.status, 409);
+  // Nothing more was consumed.
+  assert.equal(await lotPoints(loyalty, "lot-a2"), 100);
+});
+
+test("LOY-002: excess points are not consumed and the total never goes below zero", async () => {
+  const { router, loyalty } = app([pendingOrder({ lines: [{ sku: "s", unitPriceCents: 150, quantity: 1 }] })], aliceLots);
+  const res = await router.handle(redeem(500, "k1"));
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, {
+    region: "DE", subtotalCents: 150, discountCents: 0, pointsAppliedCents: 150,
+    taxCents: 0, totalCents: 0,
+  });
+  assert.equal(await lotPoints(loyalty, "lot-a2"), 350); // only 150 of the 500 requested
+});
+
+test("LOY-002: points apply after the discount", async () => {
+  const lots = [...aliceLots, { id: "lot-a4", customerId: "alice", points: 10000,
+    expiresAt: new Date("2027-01-01T00:00:00Z") }];
+  const { router } = app([pendingOrder({ discountCode: "SAVE10" })], lots);
+  const res = await router.handle(redeem(9500, "k1"));
+  // Discounted subtotal is 9000, so at most 9000 points apply.
+  assert.deepEqual(res.body, {
+    region: "DE", subtotalCents: 10000, discountCents: 1000, pointsAppliedCents: 9000,
+    taxCents: 0, totalCents: 0,
+  });
+});
+
+test("LOY-002: only pending orders can be redeemed", async () => {
+  const { router } = app([pendingOrder({ status: "shipped" })], aliceLots);
+  const res = await router.handle(redeem(400, "k1"));
+  assert.equal(res.status, 409);
+});
+
+test("LOY-002: another customer's order is not found", async () => {
+  const { router } = app([pendingOrder()], aliceLots);
+  const res = await router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asBob,
+    body: { points: 100, idempotencyKey: "k1" } });
+  assert.equal(res.status, 404);
+});
+
+test("LOY-002: invalid body is rejected", async () => {
+  const { router } = app([pendingOrder()], aliceLots);
+  const bad1 = await router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asAlice,
+    body: { points: 1.5, idempotencyKey: "k1" } });
+  assert.equal(bad1.status, 400);
+  const bad2 = await router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asAlice,
+    body: { points: 100 } });
+  assert.equal(bad2.status, 400);
+});
+
+test("LOY-002: concurrent redemptions never spend the same points", async () => {
+  const { router, loyalty } = app(
+    [pendingOrder(), pendingOrder({ id: "o2" })],
+    [{ id: "lot-x", customerId: "alice", points: 800, expiresAt: new Date("2027-01-01T00:00:00Z") }],
+  );
+  const [r1, r2] = await Promise.all([
+    router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asAlice, body: { points: 600, idempotencyKey: "k1" } }),
+    router.handle({ method: "POST", path: "/orders/o2/redeem", headers: asAlice, body: { points: 600, idempotencyKey: "k2" } }),
+  ]);
+  assert.equal(r1.status, 200);
+  assert.equal(r2.status, 200);
+  const applied = [(r1.body as { pointsAppliedCents?: number }).pointsAppliedCents ?? 0,
+    (r2.body as { pointsAppliedCents?: number }).pointsAppliedCents ?? 0];
+  // 600 + 600 requested, but only 800 points exist: the second redemption gets the remainder.
+  assert.deepEqual(applied.sort((a, b) => a - b), [200, 600]);
+  assert.equal(await lotPoints(loyalty, "lot-x"), 0);
+});
+
+test("LOY-002: cancelling a redeemed order returns points to their original lots", async () => {
+  const { router, loyalty } = app([pendingOrder()], aliceLots);
+  await router.handle(redeem(400, "k1"));
+  const res = await router.handle({ method: "POST", path: "/orders/o1/cancel", headers: asAlice });
+  assert.equal(res.status, 200);
+  assert.equal(await lotPoints(loyalty, "lot-a2"), 500);
+  assert.equal(await lotPoints(loyalty, "lot-a1"), 300);
+});
+
+test("LOY-002: points are forfeited when their lot expired before cancellation", async () => {
+  let clock = new Date("2026-11-19T12:00:00Z").getTime();
+  const lots: PointsLot[] = [
+    { id: "lot-x", customerId: "alice", points: 100, expiresAt: new Date("2026-11-20T12:00:00Z") },
+    { id: "lot-y", customerId: "alice", points: 50, expiresAt: new Date("2027-01-01T00:00:00Z") },
