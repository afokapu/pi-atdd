index 0000000..eabf1a8
--- /dev/null
+++ b/src/loyalty/application/redeem-service.ts
@@ -0,0 +1,112 @@
+import type { InMemoryLoyaltyStore } from "../integration/loyalty-store.ts";
+import { allocateLots, isExpired } from "../domain/points.ts";
+import type { InMemoryOrderStore } from "../../orders/integration/order-store.ts";
+import type { Order, Redemption } from "../../orders/domain/order.ts";
+import { appliedPoints } from "../../orders/domain/order.ts";
+import { quoteForOrder, type Quote } from "../../pricing/application/quote-service.ts";
+
+/** Use-case failure that maps onto an HTTP error status. */
+export class RedeemError extends Error {
+  readonly status: number;
+  constructor(message: string, status: number) { super(message); this.status = status; }
+}
+
+export type RedeemServiceDeps = {
+  orders: InMemoryOrderStore;
+  loyalty: InMemoryLoyaltyStore;
+  /** Current time; defaults to the system clock. */
+  now?: () => Date;
+};
+
+type IdempotencyRecord = { points: number; orderId: string; response: Quote };
+
+/**
+ * Use case: pay (part of) a pending order with loyalty points.
+ *
+ * Points are consumed from non-expired lots, earliest expiry first, at
+ * 100 points = 1 EUR. They reduce the amount after discounts and before tax,
+ * never below zero; excess points are not consumed. Requests are serialised
+ * per customer so concurrent redemptions can never spend the same points, and
+ * idempotency keys make retries safe: the same key replays the stored result
+ * without consuming again, while the same key with a different body is
+ * rejected.
+ */
+export class RedeemService {
+  private orders: InMemoryOrderStore;
+  private loyalty: InMemoryLoyaltyStore;
+  private now: () => Date;
+  private idempotency = new Map<string, IdempotencyRecord>();
+  private chains = new Map<string, Promise<void>>();
+
+  constructor(deps: RedeemServiceDeps) {
+    this.orders = deps.orders;
+    this.loyalty = deps.loyalty;
+    this.now = deps.now ?? (() => new Date());
+  }
+
+  /** Apply points to an order; returns the new quote including the points applied. */
+  redeem(customerId: string, order: Order, points: number, idempotencyKey: string): Promise<Quote> {
+    return this.serialised(customerId, () => this.redeemLocked(customerId, order, points, idempotencyKey));
+  }
+
+  /**
+   * Return the points of a cancelled order to their original lots (with the
+   * lots' original expiry). Points whose lot expired by `now` are forfeited.
+   */
+  restoreForOrder(order: Order): Promise<void> {
+    if (!order.redemptions?.length) return Promise.resolve();
+    return this.serialised(order.customerId, async () => {
+      for (const redemption of order.redemptions!) {
+        for (const c of redemption.consumed) {
+          const lot = await this.loyalty.getLot(c.lotId);
+          if (!lot || isExpired(lot, this.now())) continue; // lot gone or expired: points forfeited
+          await this.loyalty.saveLot({ ...lot, points: lot.points + c.points });
+        }
+      }
+    });
+  }
+
+  /** Run `fn` strictly after every other flow for this customer has finished. */
+  private serialised<T>(customerId: string, fn: () => Promise<T>): Promise<T> {
+    const prev = this.chains.get(customerId) ?? Promise.resolve();
+    const run = prev.then(fn);
+    this.chains.set(customerId, run.then(() => undefined, () => undefined));
+    return run;
+  }
+
+  private async redeemLocked(customerId: string, order: Order, points: number, idempotencyKey: string): Promise<Quote> {
+    const idemId = customerId + "" + idempotencyKey;
+    const seen = this.idempotency.get(idemId);
+    if (seen) {
+      if (seen.points !== points || seen.orderId !== order.id)
+        throw new RedeemError("idempotency key reused with a different request", 409);
+      return seen.response;
+    }
+    if (order.status !== "pending") throw new RedeemError(`order ${order.id} is ${order.status}`, 409);
+
+    // Capacity: amount after discounts and already-applied points, never below zero.
+    const base = quoteForOrder(order);
+    const capacity = Math.max(0, base.subtotalCents - base.discountCents - appliedPoints(order));
+    const wanted = Math.min(points, capacity);
+
+    const lots = await this.loyalty.lotsFor(customerId);
+    const consumed = allocateLots(lots, wanted, this.now());
+    for (const c of consumed) {
+      const lot = await this.loyalty.getLot(c.lotId);
+      if (!lot || lot.points < c.points) throw new RedeemError("points no longer available", 409);
+      await this.loyalty.saveLot({ ...lot, points: lot.points - c.points });
+    }
+
+    const redemption: Redemption = {
+      idempotencyKey,
+      points: consumed.reduce((sum, c) => sum + c.points, 0),
+      consumed,
+    };
+    const updated: Order = { ...order, redemptions: [...(order.redemptions ?? []), redemption] };
+    this.orders.save(updated);
+
+    const response = quoteForOrder(updated);
+    this.idempotency.set(idemId, { points, orderId: order.id, response });
+    return response;
+  }
+}
diff --git a/src/loyalty/domain/points.ts b/src/loyalty/domain/points.ts
index ed40d38..3a56f41 100644
--- a/src/loyalty/domain/points.ts
+++ b/src/loyalty/domain/points.ts
@@ -18,3 +18,26 @@ export function basePoints(subtotalCents: number): number {
 export function isExpired(lot: PointsLot, at: Date): boolean {
   return lot.expiresAt.getTime() <= at.getTime();
 }
+
+/** Points taken from one lot to cover a redemption. */
+export type LotConsumption = { lotId: string; points: number; expiresAt: Date };
+
+/**
+ * Cover `needed` points from `lots`: only non-expired lots with a remaining
+ * balance are used, earliest expiry first (FEFO). Never allocates more than
+ * `needed` or than the lots hold; the result may total less than `needed`.
+ */
+export function allocateLots(lots: PointsLot[], needed: number, at: Date): LotConsumption[] {
+  const usable = lots
+    .filter(l => l.points > 0 && !isExpired(l, at))
+    .sort((a, b) => a.expiresAt.getTime() - b.expiresAt.getTime());
+  const out: LotConsumption[] = [];
+  let remaining = needed;
+  for (const lot of usable) {
+    if (remaining <= 0) break;
+    const take = Math.min(lot.points, remaining);
+    out.push({ lotId: lot.id, points: take, expiresAt: new Date(lot.expiresAt.getTime()) });
+    remaining -= take;
+  }
+  return out;
+}
