@@ -18,3 +18,11 @@ export function basePoints(subtotalCents: number): number {
 export function isExpired(lot: PointsLot, at: Date): boolean {
   return lot.expiresAt.getTime() <= at.getTime();
 }
+
+/** Conversion: 100 points = 1 EUR = 100 cents, so one point is worth one cent. */
+export const POINTS_PER_EURO = 100;
+
+/** Monetary value of points in integer cents. */
+export function pointsValueCents(points: number): number {
+  return Math.floor((points * 100) / POINTS_PER_EURO);
+}
