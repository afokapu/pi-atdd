@@ -0,0 +1,51 @@
+/**
+ * Loyalty domain: redeeming points against an order.
+ * A redemption is planned against the customer's lots (earliest expiry first)
+ * and recorded on the order so cancellation can return points to their
+ * original lots with their original expiry.
+ */
+import { isExpired, type PointsLot } from "./points.ts";
+
+/** Points taken from one lot to fund a redemption. */
+export type RedemptionAllocation = {
+  lotId: string;
+  points: number;
+  /** The lot's expiry, remembered so cancellation restores into the same lot. */
+  expiresAt: Date;
+};
+
+/** Record of points applied to an order, kept for cancellation restores. */
+export type PointsRedemption = {
+  idempotencyKey: string;
+  /** Points actually applied (never more than requested, available, or applicable). */
+  points: number;
+  /** Monetary value of the applied points in cents (100 points = 1 EUR). */
+  appliedCents: number;
+  allocations: RedemptionAllocation[];
+};
+
+/**
+ * Choose which lots fund a redemption: non-expired lots only, earliest expiry
+ * first. Never takes more than requested or more than the applicable amount,
+ * so excess points stay unconsumed.
+ */
+export function planRedemption(
+  lots: PointsLot[],
+  requestedPoints: number,
+  maxApplicablePoints: number,
+  at: Date,
+): { points: number; allocations: RedemptionAllocation[] } {
+  const goal = Math.max(0, Math.min(requestedPoints, maxApplicablePoints));
+  const usable = lots
+    .filter(l => l.points > 0 && !isExpired(l, at))
+    .sort((a, b) => a.expiresAt.getTime() - b.expiresAt.getTime());
+  const allocations: RedemptionAllocation[] = [];
+  let remaining = goal;
+  for (const lot of usable) {
+    if (remaining <= 0) break;
+    const take = Math.min(lot.points, remaining);
+    allocations.push({ lotId: lot.id, points: take, expiresAt: lot.expiresAt });
+    remaining -= take;
+  }
+  return { points: goal - remaining, allocations };
+}
