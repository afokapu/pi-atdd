diff --git a/tests/loyalty/redeem-loyalty.acceptance.test.ts b/tests/loyalty/redeem-loyalty.acceptance.test.ts
new file mode 100644
index 0000000..d9dadeb
--- /dev/null
+++ b/tests/loyalty/redeem-loyalty.acceptance.test.ts
@@ -0,0 +1,136 @@
+/**
+ * Acceptance LOY-002
+ * Given a pending order owned by the signed-in customer
+ * When the customer sends POST /orders/:id/redeem with { points, idempotencyKey }
+ * Then points are consumed from non-expired lots (earliest expiry first),
+ *   the quote reflects points after discount and before tax, the same key
+ *   replays without consuming more, and cancelling the order restores the
+ *   points to their original lots (forfeiting lots expired by then).
+ */
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { app, asAlice, asBob, pendingOrder } from "../orders/helpers.ts";
+import type { PointsLot } from "../../src/loyalty/domain/points.ts";
+
+/** Alice holds 300 pts expiring 2026-12-01, 500 pts expiring 2026-12-31, and an expired lot. */
+const aliceLots = (): PointsLot[] => [
+  { id: "lot-1", customerId: "alice", points: 300, expiresAt: new Date("2026-12-01T00:00:00Z") },
+  { id: "lot-2", customerId: "alice", points: 500, expiresAt: new Date("2026-12-31T00:00:00Z") },
+  { id: "lot-x", customerId: "alice", points: 1000, expiresAt: new Date("2025-06-30T00:00:00Z") },
+];
+
+const redeem = (points: number, idempotencyKey: string) => ({
+  method: "POST" as const,
+  path: "/orders/o1/redeem",
+  headers: asAlice,
+  body: { points, idempotencyKey },
+});
+
+const lotPoints = async (loyalty: Awaited<ReturnType<typeof app>>["loyalty"]) =>
+  Object.fromEntries((await loyalty.lotsFor("alice")).map(l => [l.id, l.points]));
+
+test("LOY-002: points apply after discount and before tax, consumed earliest expiry first", async () => {
+  const { router, loyalty, orders } = app([pendingOrder({ discountCode: "SAVE10" })], aliceLots());
+  const res = await router.handle(redeem(400, "k1"));
+  assert.equal(res.status, 200);
+  // subtotal 10000, SAVE10 -> 1000 off, 400 pts = 400 cents, tax 19% of 8600.
+  assert.deepEqual(res.body, {
+    region: "DE", subtotalCents: 10000, discountCents: 1000,
+    pointsAppliedCents: 400, taxCents: 1634, totalCents: 10234,
+  });
+  // lot-x is expired and untouched; earliest-expiring lot-1 is drained first.
+  assert.deepEqual(await lotPoints(loyalty), { "lot-1": 0, "lot-2": 400, "lot-x": 1000 });
+  assert.equal(orders.get("o1")!.redemptions!.length, 1);
+});
+
+test("LOY-002: excess points are not consumed beyond the customer's balance", async () => {
+  const { router, loyalty } = app([pendingOrder({ discountCode: "SAVE10" })], aliceLots());
+  const res = await router.handle(redeem(2000, "k1"));
+  assert.equal(res.status, 200);
+  assert.equal((res.body as { pointsAppliedCents: number }).pointsAppliedCents, 800);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-1": 0, "lot-2": 0, "lot-x": 1000 });
+});
+
+test("LOY-002: points never reduce the amount below zero", async () => {
+  const bigLot: PointsLot[] = [{ id: "lot-big", customerId: "alice", points: 20000, expiresAt: new Date("2027-01-01T00:00:00Z") }];
+  const { router, loyalty } = app([pendingOrder()], bigLot);
+  const res = await router.handle(redeem(20000, "k1"));
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, {
+    region: "DE", subtotalCents: 10000, discountCents: 0,
+    pointsAppliedCents: 10000, taxCents: 0, totalCents: 0,
+  });
+  assert.deepEqual(await lotPoints(loyalty), { "lot-big": 10000 });
+});
+
+test("LOY-002: same idempotency key replays the same result without consuming more", async () => {
+  const { router, loyalty, orders } = app([pendingOrder({ discountCode: "SAVE10" })], aliceLots());
+  const first = await router.handle(redeem(400, "k1"));
+  const second = await router.handle(redeem(400, "k1"));
+  assert.deepEqual(second, first);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-1": 0, "lot-2": 400, "lot-x": 1000 });
+  assert.equal(orders.get("o1")!.redemptions!.length, 1);
+});
+
+test("LOY-002: same key with a different body is rejected", async () => {
+  const { router, loyalty } = app([pendingOrder()], aliceLots());
+  await router.handle(redeem(400, "k1"));
+  const res = await router.handle(redeem(500, "k1"));
+  assert.equal(res.status, 409);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-1": 0, "lot-2": 400, "lot-x": 1000 });
+});
+
+test("LOY-002: concurrent redemptions never spend the same points", async () => {
+  const { router, loyalty } = app([pendingOrder()], aliceLots());
+  const [r1, r2] = await Promise.all([router.handle(redeem(500, "k1")), router.handle(redeem(500, "k2"))]);
+  assert.equal(r1.status, 200);
+  assert.equal(r2.status, 200);
+  const applied = [r1, r2].map(r => (r.body as { pointsAppliedCents: number }).pointsAppliedCents);
+  assert.equal(applied[0]! + applied[1]!, 800); // together bounded by the 800 usable points
+  assert.deepEqual(await lotPoints(loyalty), { "lot-1": 0, "lot-2": 0, "lot-x": 1000 });
+});
+
+test("LOY-002: cancelling a redeemed order returns points to their original lots", async () => {
+  const { router, loyalty, orders } = app([pendingOrder({ discountCode: "SAVE10" })], aliceLots());
+  await router.handle(redeem(400, "k1"));
+  const res = await router.handle({ method: "POST", path: "/orders/o1/cancel", headers: asAlice });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-1": 300, "lot-2": 500, "lot-x": 1000 });
+  assert.equal(orders.get("o1")!.status, "cancelled");
+});
+
+test("LOY-002: points whose lot expired by cancellation are forfeited", async () => {
+  let now = new Date("2026-11-19T12:00:00Z");
+  const { router, loyalty } = app([pendingOrder()], aliceLots(), () => now);
+  await router.handle(redeem(400, "k1")); // 300 from lot-1 (exp 2026-12-01), 100 from lot-2
+  now = new Date("2026-12-15T00:00:00Z"); // lot-1 has expired by cancellation time
+  const res = await router.handle({ method: "POST", path: "/orders/o1/cancel", headers: asAlice });
+  assert.equal(res.status, 200);
+  assert.deepEqual(await lotPoints(loyalty), { "lot-1": 0, "lot-2": 500, "lot-x": 1000 });
+});
+
+test("LOY-002: a replayed key still returns the stored result after cancellation", async () => {
+  const { router } = app([pendingOrder()], aliceLots());
+  await router.handle(redeem(400, "k1"));
+  await router.handle({ method: "POST", path: "/orders/o1/cancel", headers: asAlice });
+  const replay = await router.handle(redeem(400, "k1"));
+  assert.equal(replay.status, 200);
+  assert.equal((replay.body as { pointsAppliedCents: number }).pointsAppliedCents, 400);
+});
+
+test("LOY-002: rejects requests that are unauthenticated, foreign, not pending, or malformed", async () => {
+  const { router } = app([pendingOrder()], aliceLots());
+  const unauth = await router.handle({ method: "POST", path: "/orders/o1/redeem", headers: {}, body: { points: 100, idempotencyKey: "k" } });
+  assert.equal(unauth.status, 401);
+  const foreign = await router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asBob, body: { points: 100, idempotencyKey: "k" } });
+  assert.equal(foreign.status, 404);
+  const { router: shippedRouter } = app([pendingOrder({ status: "shipped" })], aliceLots());
+  const shipped = await shippedRouter.handle(redeem(100, "k"));
+  assert.equal(shipped.status, 409);
+  const noKey = await router.handle({ method: "POST", path: "/orders/o1/redeem", headers: asAlice, body: { points: 100 } });
+  assert.equal(noKey.status, 400);
+  const zero = await router.handle(redeem(0, "k"));
+  assert.equal(zero.status, 400);
+  const fractional = await router.handle(redeem(10.5, "k"));
+  assert.equal(fractional.status, 400);
+});
