diff --git a/src/loyalty/application/redemption-service.ts b/src/loyalty/application/redemption-service.ts
new file mode 100644
index 0000000..3f90d43
--- /dev/null
+++ b/src/loyalty/application/redemption-service.ts
@@ -0,0 +1,108 @@
+/**
+ * Use case: pay (part of) an order with loyalty points.
+ * Composes the loyalty ledger (asynchronous) with pricing: points reduce the
+ * amount after discounts and before tax. Same idempotency key replays the
+ * stored result without consuming more; the same key with a different request
+ * is rejected. Per-customer serialization makes concurrent redemptions safe
+ * even though the ledger store round-trips through the event loop.
+ */
+import type { InMemoryLoyaltyStore } from "../integration/loyalty-store.ts";
+import { pointsValueCents, isExpired } from "../domain/points.ts";
+import { planRedemption, type PointsRedemption } from "../domain/redemption.ts";
+import { subtotal, taxOn } from "../../pricing/domain/quote.ts";
+import { discountCents } from "../../pricing/domain/discount.ts";
+import { getTaxRate } from "../../pricing/integration/tax-rates.ts";
+import type { Order } from "../../orders/domain/order.ts";
+
+/** The new quote after applying points: subtotal, discount, points, tax, total (cents). */
+export type PointsQuote = {
+  region: string;
+  subtotalCents: number;
+  discountCents: number;
+  pointsAppliedCents: number;
+  taxCents: number;
+  totalCents: number;
+};
+
+export type RedeemOutcome = { quote: PointsQuote; redemption: PointsRedemption };
+
+export class IdempotencyConflictError extends Error {}
+
+export class RedemptionService {
+  private idempotency = new Map<string, { fingerprint: string; outcome: RedeemOutcome }>();
+  private tails = new Map<string, Promise<void>>();
+  private readonly loyalty: InMemoryLoyaltyStore;
+  private readonly now: () => Date;
+
+  constructor(loyalty: InMemoryLoyaltyStore, now: () => Date) {
+    this.loyalty = loyalty;
+    this.now = now;
+  }
+
+  /** Apply points to an order. Safe to call concurrently for one customer. */
+  redeem(customerId: string, order: Order, points: number, idempotencyKey: string): Promise<RedeemOutcome> {
+    return this.withCustomerLock(customerId, () => this.redeemSerial(customerId, order, points, idempotencyKey));
+  }
+
+  private async redeemSerial(customerId: string, order: Order, points: number, idempotencyKey: string): Promise<RedeemOutcome> {
+    const fingerprint = order.id + "|" + points;
+    const idemKey = customerId + "|" + idempotencyKey;
+    const seen = this.idempotency.get(idemKey);
+    if (seen) {
+      if (seen.fingerprint !== fingerprint) throw new IdempotencyConflictError("idempotency key reused with a different request");
+      return seen.outcome; // replay: same result, nothing more consumed
+    }
+    const lots = await this.loyalty.lotsFor(customerId);
+    const subtotalCents = subtotal(order.lines);
+    const discount = discountCents(subtotalCents, order.discountCode);
+    const maxApplicable = subtotalCents - discount; // 1 point = 1 cent
+    const plan = planRedemption(lots, points, maxApplicable, this.now());
+    for (const alloc of plan.allocations) {
+      const lot = lots.find(l => l.id === alloc.lotId)!;
+      await this.loyalty.saveLot({ ...lot, points: lot.points - alloc.points });
+    }
+    const appliedCents = pointsValueCents(plan.points);
+    const outcome: RedeemOutcome = {
+      quote: quoteAfterPoints(order, subtotalCents, discount, appliedCents),
+      redemption: { idempotencyKey, points: plan.points, appliedCents, allocations: plan.allocations },
+    };
+    this.idempotency.set(idemKey, { fingerprint, outcome });
+    return outcome;
+  }
+
+  /** Cancellation: return each allocation's points to its original lot. */
+  async restoreForOrder(order: Order, at: Date): Promise<void> {
+    await this.withCustomerLock(order.customerId, async () => {
+      for (const redemption of order.redemptions ?? []) {
+        for (const alloc of redemption.allocations) {
+          const lot = await this.loyalty.getLot(alloc.lotId);
+          if (!lot || isExpired(lot, at)) continue; // lot expired by cancellation: points are forfeited
+          await this.loyalty.saveLot({ ...lot, points: lot.points + alloc.points });
+        }
+      }
+    });
+  }
+
+  /** Serialize all ledger operations of one customer onto a promise chain. */
+  private async withCustomerLock<T>(customerId: string, run: () => Promise<T>): Promise<T> {
+    const prev = this.tails.get(customerId) ?? Promise.resolve();
+    let release!: () => void;
+    const gate = new Promise<void>(resolve => { release = resolve; });
+    this.tails.set(customerId, prev.then(() => gate));
+    await prev;
+    try {
+      return await run();
+    } finally {
+      release();
+    }
+  }
+}
+
+/** Recompute the quote with points applied after discount, before tax; never below zero. */
+function quoteAfterPoints(order: Order, subtotalCents: number, discount: number, appliedCents: number): PointsQuote {
+  const afterDiscount = subtotalCents - discount;
+  const pointsAppliedCents = Math.min(appliedCents, afterDiscount);
+  const taxable = afterDiscount - pointsAppliedCents;
+  const taxCents = taxOn(taxable, getTaxRate(order.region));
+  return { region: order.region, subtotalCents, discountCents: discount, pointsAppliedCents, taxCents, totalCents: taxable + taxCents };
+}
